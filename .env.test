# Test environment: the database the app's specs (accounts, scores) run on.
SOLIDB_HOST=http://localhost:6745
SOLIDB_DATABASE=score_test
SOLIDB_USERNAME=admin
SOLIDB_PASSWORD=admin
APP_ENV=test
# Specs post forms without a browser's Origin header; CSRF is the framework's
# own, tested there.
SOLI_DISABLE_CSRF=true
# Every spec signs in from 127.0.0.1: the per-address throttle would trip.
AUTH_ATTEMPTS_PER_IP=1000
# Likewise for the account e-mails asked from one address (User).
AUTH_EMAILS_PER_IP=1000
SOLI_MAIL_DELIVERY_METHOD=test

# Two-step sign-in secrets are encrypted with it (a test value).
SOLI_ENCRYPTION_KEY=d5ffa053132b549d5acd05b9befc1320971536cf2b58c01a7a7481cad832bca2

# Reading photos of scores calls Claude with it (a test value: specs never
# reach Claude).
ANTHROPIC_API_KEY=test-key-never-sent

# The live room's tickets are signed with it (a test value; ScoreRoom).
SOLI_SESSION_SECRET=4c1e0d9a7b3f52e86a1c0f9d2b7e4a63c8f05d1e9b2a7c46f3e8d0b1a5c9e27f

# Where new errors and slow queries are told (#430): delivered by the test mailer, never sent.
SOLI_NOTIFY_EMAILS=olivier@solisoft.net

# Sign-up spam (#448): an easy proof of work the specs solve, and no hourly cap.
SIGNUP_POW_BITS=8
SIGNUPS_PER_IP_HOUR=1000
