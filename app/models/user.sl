# User model — generated by `soli generate auth`.
# Collection: users
#
# Passwords are never stored in plaintext: assign through `set_password`,
# which hashes with Argon2id (the built-in Crypto module), and verify with
# `authenticate`. Reset/confirmation/remember tokens are random UUIDs whose
# SHA-256 digest is stored — a database leak can't be replayed as a live link.

# --- Auth flow tuning --------------------------------------------------------
const AUTH_RESET_TOKEN_TTL = 7200  # password-reset links live 2 hours
const AUTH_MAX_FAILED_ATTEMPTS = 10  # failed logins before lockout
const AUTH_LOCKOUT_SECONDS = 1800  # auto-unlock after 30 minutes
# Wrong two-step codes that pause the code step, and for how long (#538,
# TwoStepGuard): as many as wrong passwords, apart from them.
const TWO_STEP_MAX_WRONG = AUTH_MAX_FAILED_ATTEMPTS
const TWO_STEP_LOCK_SECONDS = AUTH_LOCKOUT_SECONDS
# How long a two-step setup waits for its first code (#687): left longer,
# it is started again, with the password.
const TWO_STEP_PENDING_SECONDS = 900
const AUTH_CONFIRMATION_TOKEN_TTL = 172800  # confirmation links last 48 hours
const AUTH_REMEMBER_DAYS = 30  # remember-me cookie lifetime
const AUTH_MIN_PASSWORD_LENGTH = 12  # shortest password accepted at sign-up
const TOTP_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"  # Base32, for the authenticator's secret
const TOTP_BACKUP_ALPHABET = "abcdefghjkmnpqrstuvwxyz23456789"  # backup codes: no 0/o, 1/l/i
const TOTP_BACKUP_COUNT = 10
# A link to confirm a new e-mail address lives 24 hours.
const EMAIL_CHANGE_TTL = 86400
# Changes of address one person may ask for in an hour, right or wrong
# password: the form must not become a way to guess it.
const EMAIL_CHANGES_PER_HOUR = 5
# Wrong passwords the signed-in pages that ask for it (a new password,
# two-step sign-in turned off, the account deleted, an access token made)
# take from one account in ACCOUNT_PASSWORD_WINDOW seconds, before even the
# right one is refused (#539): a stolen session must not become a way to
# guess the password at leisure. Only wrong ones count.
const ACCOUNT_PASSWORD_TRIES = 5
const ACCOUNT_PASSWORD_WINDOW = 900
# The source networks an account keeps a count of failed sign-ins for (#539),
# locked ones aside: those are kept until their lock runs out.
const AUTH_LOCK_SOURCES = 50
# Wrong passwords at one account, from however many networks, within
# AUTH_ACCOUNT_WINDOW seconds before it refuses every browser it does not
# know for AUTH_ACCOUNT_WINDOW (#539): what bounds a botnet's guesses.
const AUTH_ACCOUNT_MAX_FAILURES = 100
const AUTH_ACCOUNT_WINDOW = 3600
# How long a browser that signed in stays one the account knows.
const AUTH_DEVICE_DAYS = 365

# Per-IP throttle on the credential endpoints (login, sign-up, reset). The
# per-account lockout above cannot see these two attacks: credential stuffing
# spread thinly across thousands of accounts never trips it, and an attacker
# who knows an email address can lock its owner out on demand. Keying on the
# source address covers both.
const AUTH_ATTEMPTS_PER_IP = (getenv("AUTH_ATTEMPTS_PER_IP") ?? "15").to_i
const AUTH_IP_WINDOW_SECONDS = 300
# Account e-mails asked for from a form (a confirmation link sent again, a
# password reset): at most AUTH_EMAILS_PER_ADDRESS to one address, and
# AUTH_EMAILS_PER_IP asked from one source address, in AUTH_EMAILS_WINDOW_SECONDS.
# Counted whether or not the address has an account, so a refusal says
# nothing of it.
const AUTH_EMAILS_PER_ADDRESS = 5
const AUTH_EMAILS_PER_IP = (getenv("AUTH_EMAILS_PER_IP") ?? "20").to_i
const AUTH_EMAILS_WINDOW_SECONDS = 3600
# What a refused request reads, the same for any address.
const AUTH_EMAILS_REFUSED = "Too many emails asked for: try again in an hour."

# Sign-up against spam (#448), past the honeypot and the render time every
# form carries: each sign-up page asks the browser for a proof of work of
# SIGNUP_POW_BITS bits (well under a second for a person, real CPU for a bot
# making accounts by the thousand), one source address makes
# SIGNUPS_PER_IP_HOUR accounts an hour at most, and a throwaway address —
# the kind made to receive one mail and vanish — is refused.
const SIGNUP_POW_BITS = (getenv("SIGNUP_POW_BITS") ?? "17").to_i
const SIGNUPS_PER_IP_HOUR = (getenv("SIGNUPS_PER_IP_HOUR") ?? "10").to_i
const THROWAWAY_EMAIL_DOMAINS = [
  "mailinator.com",
  "guerrillamail.com",
  "guerrillamail.net",
  "guerrillamail.org",
  "guerrillamailblock.com",
  "sharklasers.com",
  "grr.la",
  "10minutemail.com",
  "10minutemail.net",
  "yopmail.com",
  "yopmail.fr",
  "yopmail.net",
  "temp-mail.org",
  "tempmail.com",
  "tempmail.net",
  "tempmailo.com",
  "temp-mail.io",
  "tempail.com",
  "throwawaymail.com",
  "trashmail.com",
  "trashmail.de",
  "getnada.com",
  "nada.email",
  "dispostable.com",
  "maildrop.cc",
  "mailnesia.com",
  "mintemail.com",
  "mohmal.com",
  "emailondeck.com",
  "fakeinbox.com",
  "spamgourmet.com",
  "getairmail.com",
  "mailcatch.com",
  "moakt.com",
  "burnermail.io",
  "33mail.com",
  "spam4.me",
  "inboxkitten.com",
  "1secmail.com",
  "1secmail.net",
  "1secmail.org",
  "mail.tm",
  "mail.gw",
  "emailfake.com",
  "fakemail.net",
  "discard.email",
  "mailpoof.com",
  "tmail.ws",
  "tmpmail.org",
  "tmpmail.net"
]

# Base URL used in password-reset / confirmation emails.
#
# Read from the environment so a deployment sets it once, next to its other
# config, rather than by editing this file. The literal fallback is a dev
# convenience: left in place in production it mails `http://localhost` reset
# links, which are both useless and, if the host does resolve, sent in the
# clear. Set APP_BASE_URL to your `https://` origin.
def auth_base_url
  return getenv("APP_BASE_URL").to_s if getenv("APP_BASE_URL").present?
  # The site's own setting (deploy/README.md), which the share tags read too.
  return getenv("APP_URL").to_s if getenv("APP_URL").present?

  "http://localhost:5011"
end

# Require a confirmed email before sign-in: the site sends mail (SOLI_SMTP_*,
# deploy/README.md), and an account whose link went astray asks for another
# from the sign-in page or the confirmation page.
def auth_require_confirmed_email
  true
end

class User < Model
  # Fields: email, password_digest, role, plus the auth-flow fields:
  # reset_token_digest, reset_sent_at, reset_letter,
  # confirmation_token_digest, confirmation_sent_at, confirmation_letter,
  # confirmed_at, remember_token_digest,
  # failed_attempts, locked_at.
  # (Model stores fields dynamically — no need to declare them.)
  validates(
    "email",
    {
      "presence": true,
      "uniqueness": true,
      "format": "email"
    }
  )
  before_save("normalize")

  def normalize
    this.email = this.email.trim().downcase() unless this.email.blank?
    this.role = "member" if this.role.blank?
  end

  # Hash `plaintext` and store it in `password_digest`. No-op when blank so a
  # profile update that doesn't change the password leaves the digest intact.
  # Callers that accept a *new* password must run `password_error` first —
  # this method deliberately has no opinion, so that a profile save with no
  # password field doesn't wipe the digest.
  def set_password(plaintext)
    return if plaintext.blank?

    this.password_digest = Crypto.password_hash(plaintext)
  end

  # Why `plaintext` is unacceptable as a new password, or null when it is fine.
  #
  # Length is the only rule here on purpose. Composition rules ("one digit,
  # one symbol") push people toward `Password1!` — they add a decimal digit of
  # real entropy and a lot of friction. Length is what actually raises the
  # cost of an offline attack against the Argon2id digest.
  def password_error(plaintext)
    value = plaintext.to_s
    return SiteText.t("auth.password_required") if value.blank?

    if value.length() < AUTH_MIN_PASSWORD_LENGTH
      return SiteText.t("auth.password_short", {"n": AUTH_MIN_PASSWORD_LENGTH})
    end

    null
  end

  # True when `plaintext` matches the stored Argon2id digest.
  def authenticate(plaintext)
    return false if this.password_digest.blank?

    Crypto.password_verify(plaintext, this.password_digest)
  end

  # The count of passwords typed on the signed-in pages (#539), the
  # current round's: a right one starts a new round (`limiter.reset()` does
  # not empty a count, so a fresh key does it).
  def _password_tries
    RateLimiter(
      "password-check:#{this._key}:#{this._password_round}",
      ACCOUNT_PASSWORD_TRIES,
      ACCOUNT_PASSWORD_WINDOW
    )
  end

  def _password_round
    @password_round.to_s.to_i
  end

  # A new round, written alone (`_patch_stored`): nothing else of the
  # account is saved from this copy.
  def _next_password_round
    round = @_password_round + 1
    @_patch_stored({"password_round": round})
    @password_round = round
  end

  # Whether the signed-in pages have had ACCOUNT_PASSWORD_TRIES wrong
  # passwords lately: they then check none, the right one included.
  def password_tries_spent?
    @_password_tries.throttle() > 0
  end

  # Whether `plaintext` is the password, asked by a signed-in page: false,
  # without checking, once the tries are spent. The try is counted before
  # the ~100ms check, not after it: parallel requests would otherwise all
  # pass the count before any of them added to it. A right one starts the
  # count again — unless `new_round` is false: a page that asks for a
  # two-step code too starts it only once the code is right as well
  # (`passed_confirmation`, #538). Started on the password alone, a wrong
  # code after the right password cost no try, and the codes could be
  # guessed there without end.
  def confirms_password?(plaintext, new_round = true)
    tries = @_password_tries
    return false unless tries.allowed()
    return false unless @authenticate(plaintext.to_s)

    @_next_password_round if new_round
    true
  end

  # The password and the code of a signed-in page both right (#538): the
  # tries start again.
  def passed_confirmation
    @_next_password_round
    true
  end

  # Whether the password and, with two-step sign-in on, a code confirm a
  # change from a signed-in page: the password's try counted (above), each
  # wrong code counted at the second step (`second_step_counted?`), the
  # tries started again only once both are right. The code is not looked at
  # when the password is wrong.
  def confirms_with_code?(password, code)
    return @confirms_password?(password) unless @two_step?

    return false unless @confirms_password?(password, false)
    return false unless @second_step_counted?(code)

    @passed_confirmation
  end

  # Spend the same Argon2id work as a real `authenticate` without having an
  # account to check against. Sign-in calls this when no user matches the
  # submitted email: verifying costs ~100ms and returning early costs none, so
  # without it the response time alone tells an attacker which addresses are
  # registered — a user-enumeration oracle that no error-message wording can
  # close. The result is deliberately discarded.
  static def burn_password_work(plaintext)
    Crypto.password_hash(plaintext.to_s)
    return false
  end

  # Whether an account e-mail may go to `email`, asked from `ip`: each one
  # allowed counts against both, whether or not `email` has an account.
  # Whether `email` is at a throwaway address's domain, or one of its
  # subdomains (#448).
  static def throwaway_email?(email)
    domain = email.to_s.trim.downcase.split("@").last.to_s
    return false if domain.blank?

    THROWAWAY_EMAIL_DOMAINS.any? do |known|
      domain == known || domain.ends_with?(".#{known}")
    end
  end

  static def account_email_allowed?(email, ip)
    by_ip = RateLimiter("account-email-ip:#{ip}", AUTH_EMAILS_PER_IP, AUTH_EMAILS_WINDOW_SECONDS)
    by_address = RateLimiter(
      "account-email-to:#{email.to_s.trim.downcase}",
      AUTH_EMAILS_PER_ADDRESS,
      AUTH_EMAILS_WINDOW_SECONDS
    )
    return false if by_ip.throttle() > 0 || by_address.throttle() > 0

    by_ip.allowed() && by_address.allowed()
  end

  def admin?
    this.role == "admin"
  end

  # `text` as the name others see this person by — in the shared library
  # (#444), in comments — when they give one: nil once done, else why not.
  # A blank name leaves the one they have.
  def name_as(text)
    name = text.to_s.trim
    return nil if name.blank? || name == @name.to_s
    return "A name holds 60 characters at most." if name.chars().length > 60

    @name = name
    @update()
    nil
  end

  # How the app names someone to others: their name when they have one, else
  # their email address.
  def display_name
    @name.blank? ? @email : @name
  end

  # The users whose keys are `keys` (blanks and repeats ignored), each key to
  # its `display_name`: one query however many there are, reading nothing
  # else of them. A key with no user left is missing from the answer.
  static def names_of(keys)
    wanted = keys.filter do |key|
      !key.blank?
    end
    return {} if wanted.length == 0

    User.names_in(User.named(wanted).all)
  end

  # The query for the users whose keys are `keys`, reading only what names
  # them: to run alone (`names_of`) or among others in `grouped`.
  static def named(keys)
    wanted = keys.filter do |key|
      !key.blank?
    end.uniq
    User.where("doc._key IN @keys", {"keys": wanted}).select("email", "name")
  end

  # `users` (read by `named`), each key to its `display_name`.
  static def names_in(users)
    names = {}
    users.each do |user|
      names[user._key] = user.display_name
    end
    names
  end

  # --- Password reset ---------------------------------------------------------

  # Issue a reset token: returns the plaintext token (goes into the email);
  # only its digest is stored.
  #
  # Written alone (`_patch_stored`): the copy asking may be older than the
  # account's lockout counts (the mail job reads it), and saving it whole
  # would put them back as they were then.
  #
  # `token` and `letter` are the mail job's (AuthMailJob.link_token): the
  # token it derives for its letter, and the letter's id, kept so that a
  # retry of that job knows the link is made and sends the same one again.
  def start_password_reset(token = nil, letter = nil)
    token ||= uuid_v4()
    sent_at = DateTime.utc().to_unix()
    @_patch_stored({
      "reset_token_digest": Crypto.sha256(token),
      "reset_sent_at": sent_at,
      "reset_letter": letter
    })
    this.reset_letter = letter
    this.reset_token_digest = Crypto.sha256(token)
    this.reset_sent_at = sent_at
    token
  end

  def reset_token_expired?
    return true if this.reset_sent_at.nil?

    DateTime.utc().to_unix() - this.reset_sent_at > AUTH_RESET_TOKEN_TTL
  end

  # Set the new password, burn the token, and clear any lockout.
  #
  # Also drops the remember-me digest. Resetting a password is what someone
  # does when they think the account is compromised, and a remember-me cookie
  # outlives it by up to AUTH_REMEMBER_DAYS — leaving it valid means the reset
  # doesn't actually evict the attacker.
  def finish_password_reset(plaintext)
    this.set_password(plaintext)
    this.reset_token_digest = null
    this.reset_sent_at = null
    this.remember_token_digest = null
    # A change of address under way is dropped too: the reset is what the
    # owner does when the change was not theirs.
    this.forget_email_change()
    this.failed_attempts = 0
    this.locked_at = null
    # Guesses at the old password count for nothing against the new one.
    this.sign_in_failures = null
    this.account_failures = null
    this.account_locked_at = null
    # Invalidate every session opened before this moment.
    #
    # Sessions are not indexed by user, so there is nothing to delete; instead
    # each session records the `session_version` it was opened at, and
    # `load_current_user` refuses one that is behind. Without this, an attacker
    # who was already signed in stayed signed in through the victim's reset —
    # which is the one thing a password reset is supposed to stop.
    this.session_version = (this.session_version ?? 0) + 1
    this.update()
    # The access tokens too (#539): the MCP clients and the apps connected
    # by OAuth would otherwise keep acting as the account, sessions or not.
    @_revoke_access
  end

  # Every access token of the account's deleted, and every authorization
  # code not yet exchanged for one (#539): a code issued before a reset
  # would otherwise become a token after it.
  def _revoke_access
    AccessToken.delete_all_of(this)
    OauthCode.where({"user_id": this._key}).delete_all
    true
  end

  # Why the password cannot become `new_password`, or nil: the current one
  # must be right, the new one acceptable, and typed the same twice.
  def password_change_error(current, new_password, confirmation)
    return SiteText.t("app.account.not_current_password") unless this.confirms_password?(current)

    error = this.password_error(new_password)
    return error unless error.nil?
    return SiteText.t("app.account.passwords_differ") if new_password.to_s != confirmation.to_s

    null
  end

  # A new password, and every other session and remembered browser signed
  # out, every access token revoked and any reset link sent dead, as after
  # a reset.
  def change_password(plaintext)
    this.set_password(plaintext)
    this.remember_token_digest = null
    this.forget_email_change()
    this.forget_password_reset()
    this.session_version = (this.session_version ?? 0) + 1
    this.update()
    @_revoke_access
  end

  # A reset link sent and not followed made useless (#539: not saved, the
  # caller saves): after a new password or a new address, the link in an
  # old mailbox must not choose another.
  def forget_password_reset
    this.reset_token_digest = null
    this.reset_sent_at = null
    true
  end

  # Bumped whenever every existing session must be invalidated (a password
  # reset today; add other events here as they appear).
  def current_session_version
    this.session_version ?? 0
  end

  # --- Email confirmation -----------------------------------------------------
  # Written alone, as `start_password_reset` is: the mail job's copy of the
  # account is read before the sign-ins counted since — saved whole, it
  # wrote their failures back to what it had read. `token` and `letter`:
  # the mail job's, as `start_password_reset` takes them.
  def start_email_confirmation(token = nil, letter = nil)
    token ||= uuid_v4()
    sent_at = DateTime.utc().to_unix()
    @_patch_stored({
      "confirmation_token_digest": Crypto.sha256(token),
      "confirmation_sent_at": sent_at,
      "confirmation_letter": letter
    })
    this.confirmation_letter = letter
    this.confirmation_token_digest = Crypto.sha256(token)
    this.confirmation_sent_at = sent_at
    token
  end

  # Confirmation links expire like reset links do.
  #
  # `confirmation_sent_at` was stored and never read, so a link stayed valid
  # forever: a forwarded email, an archived mailbox, or a link-following
  # security scanner could confirm the address (and, before the change below,
  # sign in as that user) months later.
  def confirmation_token_expired?
    return true if this.confirmation_sent_at.nil?

    DateTime.utc().to_unix() - this.confirmation_sent_at > AUTH_CONFIRMATION_TOKEN_TTL
  end

  def confirm_email
    this.confirmed_at = DateTime.utc().to_unix()
    this.confirmation_token_digest = null
    this.confirmation_sent_at = null
    this.update()
  end

  def confirmed?
    !this.confirmed_at.nil?
  end

  # --- Change of e-mail address -----------------------------------------------
  #
  # The new address is kept aside (`email_change_to`) with the digest of a
  # link's token, until the link mailed to it is followed: only then does
  # the account change address. The old address is told when it is asked.

  # Why the address cannot become `new_email`, or nil: the password (and,
  # with two-step sign-in on, a code) must be right, the address one, not
  # this account's, and not another account's.
  def email_change_error(new_email, password, code)
    address = new_email.to_s.trim.downcase
    return SiteText.t("app.account.email_wrong_password") unless this.confirms_password?(password, !this.two_step?())
    return SiteText.t("app.account.email_wrong_code") if this.two_step?() && !this.second_step_counted?(code)

    this.passed_confirmation() if this.two_step?()

    return SiteText.t("app.account.email_invalid") unless Regex.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$", address)
    return SiteText.t("app.account.email_same") if address == this.email
    return SiteText.t("app.account.email_taken") unless User.find_by("email", address).nil?

    nil
  end

  # `new_email` kept aside until its link is followed: the link's token,
  # which only the mail to that address carries (its digest is kept).
  def start_email_change(new_email)
    token = uuid_v4()
    this.email_change_to = new_email.to_s.trim.downcase
    this.email_change_digest = Crypto.sha256(token)
    this.email_change_sent_at = DateTime.utc.to_unix
    this.update()
    token
  end

  def email_change_expired?
    return true if this.email_change_sent_at.nil?

    DateTime.utc.to_unix - this.email_change_sent_at > EMAIL_CHANGE_TTL
  end

  # The change under way dropped (not saved: the caller saves).
  def forget_email_change
    this.email_change_to = null
    this.email_change_digest = null
    this.email_change_sent_at = null
    true
  end

  # Whether `user` may ask for one more change of address now: each asked
  # for counts, refused or not.
  static def email_change_allowed?(user)
    RateLimiter("email-change:#{user._key}", EMAIL_CHANGES_PER_HOUR, 3600).allowed()
  end

  # What the link with `token` is: {"user", "state"}, the state "ready",
  # "expired", "done" (followed already: the user is the account it
  # changed) or "unknown" (no user).
  static def email_change_for(token)
    if token.to_s.blank?
      return {"user": nil, "state": "unknown"}
    end

    digest = Crypto.sha256(token.to_s)
    user = User.find_by("email_change_digest", digest)
    unless user.nil?
      return {"user": user, "state": user.email_change_expired?() ? "expired" : "ready"}
    end

    done = User.find_by("email_changed_digest", digest)
    unless done.nil?
      return {"user": done, "state": "done"}
    end

    {"user": nil, "state": "unknown"}
  end

  # The change confirmed: the account takes the new address (confirmed, as
  # the link proves it is theirs), the shares made to the old one move with
  # it, every session, remembered browser and access token is signed out,
  # and a reset link sent to the old address dies. The old
  # address, or nil when the new one has meanwhile become another
  # account's: the change is then dropped, and nothing else changes.
  def finish_email_change
    address = this.email_change_to
    unless User.find_by("email", address).nil?
      this.forget_email_change()
      this.update()
      return nil
    end

    old = this.email
    this.email = address
    this.confirmed_at = DateTime.utc.to_unix
    this.email_changed_digest = this.email_change_digest
    this.forget_email_change()
    this.forget_password_reset()
    this.remember_token_digest = null
    this.session_version = (this.session_version ?? 0) + 1
    this.update()
    @_revoke_access
    ScoreShare.move_address(old, address, this)
    old
  end

  # How many zips "Export all my data" comes in (AccountExport): what the
  # account page can ask, where the service is out of reach.
  def export_part_count
    AccountExport.parts(this).length
  end

  # --- Remember me ------------------------------------------------------------
  def start_remember_me
    token = uuid_v4()
    this.remember_token_digest = Crypto.sha256(token)
    this.update()
    token
  end

  def forget_me
    return true if this.remember_token_digest.blank?

    this.remember_token_digest = null
    this.update()
  end

  def remembered_by?(token)
    return false if this.remember_token_digest.blank?

    Crypto.secure_compare(Crypto.sha256(token.to_s), this.remember_token_digest)
  end

  # --- Account lockout --------------------------------------------------------
  #
  # Two counts (#539). Per account AND source network: AUTH_MAX_FAILED_ATTEMPTS
  # wrong passwords from one network (an IPv4 address; an IPv6 /64, which one
  # host holds whole and moves about in at will) lock the account for that
  # network, for AUTH_LOCKOUT_SECONDS. Whoever guesses at a known address
  # locks themselves out, not its owner, who signs in from elsewhere as usual
  # — a lock of the whole account was one anybody could keep on for ever.
  # And per account: AUTH_ACCOUNT_MAX_FAILURES wrong passwords within
  # AUTH_ACCOUNT_WINDOW, from however many networks (a botnet), lock it for
  # AUTH_ACCOUNT_WINDOW for every browser it does not know. A browser that
  # signed in to it before carries its `device` cookie (`device_cookie`) and
  # still signs in, its network's count and the per-IP throttle still on it.
  #
  # `sign_in_failures` keeps, per network (a keyed digest of it, never the
  # address), {"count", "at" (the last failure), "locked_at"};
  # `account_failures` {"count", "since"}; `account_locked_at`.
  # `locked_at` / `failed_attempts` are the whole account's lock from
  # before, still honoured until it runs out.
  #
  # They are written field by field (`_patch_stored`), from the stored
  # account read again, never by saving the copy a sign-in read: that copy
  # is ~100ms of Argon2id old, and parallel guesses saving it would each
  # undo the others' counts and locks.
  #
  # The calls the sign-in pages make (kept for #538's rebase):
  # register_failed_attempt(ip = nil, by_code = false, trusted = false),
  # clear_failed_attempts(ip = nil), locked_for?(ip, trusted = false) —
  # `trusted` the browser's device cookie, checked (`trusts_device?`).

  # The network failures from `ip` are counted under: an IPv4 address
  # itself (an IPv4-mapped IPv6 address is its IPv4 one), an IPv6 address's
  # /64, in one spelling whichever it came in.
  static def failure_network(ip)
    address = ip.to_s.trim.downcase.replace("[", "").replace("]", "").split("%")[0].to_s
    address = address.substring(7, address.length) if address.starts_with?("::ffff:") && address.includes?(".")
    return address unless address.includes?(":")

    halves = address.split("::")
    head = halves[0].to_s.blank? ? [] : halves[0].split(":")
    tail = []
    tail = halves[1].split(":") if halves.length > 1 && halves[1].present?
    filler = []
    (0 .. 8 - head.length - tail.length).each do |_|
      filler.push("0")
    end
    prefix = (head + filler + tail).slice(0, 4).map do |group|
      User._hex_group(group)
    end
    prefix.join(":") + "::/64"
  end

  # An IPv6 group without its leading zeros ("0db8" is "db8", "0000" is "0").
  static def _hex_group(group)
    text = group.to_s
    while text.length > 1 && text.starts_with?("0")
      text = text.substring(1, text.length)
    end
    text.blank? ? "0" : text
  end

  # The key failures from `ip` are counted under: its network, keyed with
  # the server's secret, so that the keys stored cannot be turned back into
  # addresses by hashing all 2^32 IPv4 ones.
  static def failure_source(ip)
    Crypto.hmac("sign-in:#{User.failure_network(ip)}", User.auth_key("sign-in")).substring(0, 24)
  end

  # The server's own secret (the one the live room's tickets are signed
  # with, ScoreRoom): what sign-in records are keyed with and device cookies
  # signed with.
  static def auth_secret
    ScoreRoom.secret_from(getenv("SOLI_SESSION_SECRET"), getenv("APP_SECRET"))
  end

  # The key of one `purpose` ("sign-in", "device"), derived from the
  # server's secret: none of them is the secret itself, nor another's.
  static def auth_key(purpose)
    Crypto.hmac(purpose, User.auth_secret)
  end

  # A new `device` cookie, for a browser that has just proved itself to this
  # account (a sign-in, a reset link followed, a remember-me cookie, a new
  # password or address while signed in): "<id>.<mac>", the mac the server's
  # over the account, its session version and the id. Nothing is stored:
  # `trusts_device?` checks the mac. A reset, a new password or a new address
  # bump the session version, which voids every device given before.
  def device_cookie
    id = Crypto.random_token(16)
    "#{id}.#{this._device_mac(id)}"
  end

  # How the `device` cookie is set: a year, HttpOnly, Secure, SameSite=Lax.
  static def device_cookie_options
    {
      "max_age": AUTH_DEVICE_DAYS * 86400,
      "http_only": true,
      "same_site": "Lax",
      "secure": true
    }
  end

  # Whether `value` (a browser's `device` cookie) is one this account gave.
  def trusts_device?(value)
    parts = value.to_s.split(".")
    return false if parts.length != 2 || parts[0].blank?

    Crypto.secure_compare(@_device_mac(parts[0]), parts[1])
  end

  def _device_mac(id)
    Crypto.hmac("device:#{this._key}:#{this.current_session_version}:#{id}", User.auth_key("device"))
  end

  # Whether signing in is locked for whoever comes from `ip`, in a browser
  # the account knows (`trusted`) or not.
  def locked_for?(ip, trusted = false)
    return true if @_account_locked?
    return true if @account_locked? && !trusted

    entry = (@sign_in_failures ?? {})[User.failure_source(ip)]
    @_entry_locked?(entry, DateTime.utc.to_unix)
  end

  # Whether the account-wide lock is on: every browser the account does not
  # know is refused.
  def account_locked?
    return false if @account_locked_at.nil?

    DateTime.utc.to_unix - @account_locked_at.to_s.to_i <= AUTH_ACCOUNT_WINDOW
  end

  # How many networks signing in is locked from now.
  def locked_sources
    now = DateTime.utc.to_unix
    failures = @sign_in_failures ?? {}
    locked = failures.keys.filter do |source|
      @_entry_locked?(failures[source], now)
    end
    locked.length
  end

  # Whether signing in is locked from somewhere (what the admin pages show,
  # and lift with `unlock`).
  def locked?
    @_account_locked? || @account_locked? || @locked_sources > 0
  end

  def _entry_locked?(entry, now)
    return false if entry.nil? || entry["locked_at"].nil?

    now - entry["locked_at"].to_s.to_i <= AUTH_LOCKOUT_SECONDS
  end

  # The whole account's lock from before #539; once run out, cleared.
  def _account_locked?
    return false if this.locked_at.nil?

    if DateTime.utc().to_unix() - this.locked_at > AUTH_LOCKOUT_SECONDS
      @_patch_stored({"locked_at": nil, "failed_attempts": 0})
      return false
    end
    true
  end

  # The failures still counted at `now`: a network's are forgotten once it
  # has been quiet for AUTH_LOCKOUT_SECONDS (a lock trips at its last
  # failure, so its lock has run out too). Of the open ones, only the
  # AUTH_LOCK_SOURCES - 1 latest are kept, room for the one being counted;
  # a locked one is never dropped to make room: a lock lasts its time.
  def _live_failures(now)
    failures = @sign_in_failures ?? {}
    live = {}
    unlocked = []
    failures.keys.each do |source|
      entry = failures[source]
      next if entry.nil? || now - entry["at"].to_s.to_i > AUTH_LOCKOUT_SECONDS

      if @_entry_locked?(entry, now)
        live[source] = entry
      else
        unlocked.push(source)
      end
    end
    latest = unlocked.sort_by do |source|
      0 - failures[source]["at"].to_s.to_i
    end
    latest.slice(0, AUTH_LOCK_SOURCES - 1).each do |source|
      live[source] = failures[source]
    end
    live
  end

  # A wrong password (or, `by_code`, a wrong two-step code) from `ip`, in a
  # browser the account knows (`trusted`) or not: counted for its network
  # and for the account, on the stored account read again now.
  def register_failed_attempt(ip = nil, by_code = false, trusted = false)
    stored = User.find_by("_key", this._key)
    return true if stored.nil?

    # Don't count guesses from an address that is *currently* locked: doing
    # so would slide its window forward on every further guess. The lock
    # runs out on schedule no matter how loud the attack is.
    return true if stored.locked_for?(ip, trusted)

    now = DateTime.utc.to_unix
    live = stored._live_failures(now)
    # The entries to drop (quiet, or the oldest open ones): those still open
    # when the statement runs go.
    dropped = (stored.sign_in_failures ?? {}).keys.filter do |key|
      !live.has_key(key)
    end
    counted = User.count_failure(this._key, User.failure_source(ip), now, dropped)
    return true if counted.nil?

    @_read_lock_fields(User.find_by("_key", this._key))
    # The sign-in response says only "Invalid email or password" whether or
    # not the address is locked, because a distinct "locked" reply during the
    # lockout tells an attacker which guess was the right one. The mail is
    # queued: its sending, or failing, is not the request's.
    if counted["told"]
      AuthMailJob.ask("account_locked", @email, {
        "lock": counted["account_locked"] ? "account" : "source",
        "by_code": by_code
      })
    end
    true
  end

  # One more failure from network `source` at the account of key `key`, at
  # `now`, counted by the database in the one statement that writes it: the
  # +1 and whether it trips a lock are decided from the stored values, so
  # two failures at once count two, whatever copies their requests read.
  # The networks in `dropped` go unless they are locked by then; the
  # account's own count is not counted while its lock is on (a browser it
  # knows is still guessing: the lock runs out on schedule). The owner is
  # told when a network's lock trips, once a window however many lock (a
  # mail per network would be a way to flood them), and when the account's
  # trips, which is once a window at most. Answers {"source_locked",
  # "account_locked" (tripped by this one), "told"}, or nil (no account).
  static def count_failure(key, source, now, dropped = [])
    lockout = AUTH_LOCKOUT_SECONDS
    max_failures = AUTH_MAX_FAILED_ATTEMPTS
    account_window = AUTH_ACCOUNT_WINDOW
    account_max = AUTH_ACCOUNT_MAX_FAILURES
    rows = @sdbql{
      FOR u IN users
      FILTER u._key == #{key}
      LET old_entries = u.sign_in_failures == null ? {} : u.sign_in_failures
      LET gone_keys = (FOR k IN #{dropped} FILTER old_entries[k] == null || old_entries[k].locked_at == null RETURN k)
      LET old_entry = old_entries[#{source}]
      LET is_recent = old_entry != null && #{now} - old_entry.at <= #{lockout}
      LET source_count = (is_recent ? old_entry.count : 0) + 1
      LET source_trips = source_count >= #{max_failures}
      LET is_open = u.account_locked_at == null || #{now} - u.account_locked_at > #{account_window}
      LET in_window = u.account_failures != null && #{now} - u.account_failures.since <= #{account_window}
      LET account_total = (in_window ? u.account_failures.count : 0) + 1
      LET account_trips = is_open && account_total >= #{account_max}
      LET source_tells = source_trips && (u.lock_told_at == null || #{now} - u.lock_told_at > #{lockout})
      LET tells = account_trips || source_tells
      LET source_entry = {count: source_count, at: #{now}, locked_at: source_trips ? #{now} : null}
      LET window_since = in_window ? u.account_failures.since : #{now}
      LET account_doc = account_trips ? null : {count: account_total, since: window_since}
      UPDATE u WITH {
        sign_in_failures: MERGE(UNSET(old_entries, gone_keys), ZIP([#{source}], [source_entry])),
        account_failures: is_open ? account_doc : u.account_failures,
        account_locked_at: account_trips ? #{now} : u.account_locked_at,
        lock_told_at: tells ? #{now} : u.lock_told_at
      } IN users
      RETURN {source_locked: source_trips, account_locked: account_trips, told: tells}
    }
    # An @sdbql block answers a refused query with its error, as a string.
    throw "User.count_failure: #{rows}" if type(rows) == "string"
    return nil if rows.length == 0

    rows[0]
  end

  # A right password from `ip`: its network's count starts again. Another
  # network's does not, nor the account's: a sign-in by the owner does not
  # lift an attacker's lock.
  def clear_failed_attempts(ip = nil)
    source = User.failure_source(ip)
    return true unless (@sign_in_failures ?? {}).has_key(source)

    @_patch_stored({}, {}, [source])
  end

  # `patch` written into the stored account, the fields it names only, and
  # in `sign_in_failures` the networks `entries` names written, those
  # `dropped` names removed, the others' left as the database has them — in
  # one statement, from the document it updates. Then this copy's lockout
  # fields read back.
  def _patch_stored(patch, entries = {}, dropped = [])
    key = this._key
    written = @sdbql{
      FOR u IN users
      FILTER u._key == #{key}
      LET kept = UNSET(u.sign_in_failures == null ? {} : u.sign_in_failures, #{dropped})
      UPDATE u WITH MERGE(#{patch}, {sign_in_failures: MERGE(kept, #{entries})}) IN users
      RETURN NEW._key
    }
    # An @sdbql block answers a refused query with its error, as a string.
    throw "User#_patch_stored: #{written}" if type(written) == "string"

    @_read_lock_fields(User.find_by("_key", this._key))
  end

  # This copy's lockout fields, as `stored` (the account read again) has them.
  def _read_lock_fields(stored)
    return true if stored.nil?

    @sign_in_failures = stored.sign_in_failures
    @account_failures = stored.account_failures
    @account_locked_at = stored.account_locked_at
    @lock_told_at = stored.lock_told_at
    @locked_at = stored.locked_at
    @failed_attempts = stored.failed_attempts
    @password_round = stored.password_round
    true
  end

  # --- Two-step sign-in (TOTP) -------------------------------------------------
  #
  # An authenticator app's six-digit codes on top of the password, if the
  # owner turns it on. The secret is stored encrypted (SOLI_ENCRYPTION_KEY):
  # `totp_pending` while it is being set up, `totp_secret` once a first code
  # proves the app holds it. The time step of each accepted code is kept, so
  # a code is good once; ten backup codes, kept as digests, are good once each.

  # Whether this server can keep the secrets: it has a key to encrypt them.
  static def two_step_available?
    getenv("SOLI_ENCRYPTION_KEY").present?
  end

  def two_step?
    !this.totp_secret.blank?
  end

  # The same question as `two_step_available?`, asked of an account: what a
  # page can call, where the model's class is out of reach.
  def can_use_two_step?
    User.two_step_available?()
  end

  # A new secret, kept aside until a code confirms it: its Base32 text.
  def start_two_step
    secret = Crypto.random_bytes(32).map do |b|
      TOTP_ALPHABET[b % 32]
    end.join("")
    this.totp_pending = Crypto.encrypt(secret, getenv("SOLI_ENCRYPTION_KEY"))
    this.totp_pending_at = DateTime.utc.to_unix
    this.update()
    secret
  end

  # The secret being set up, or nil: none, or one left past its time.
  def pending_two_step
    return nil if this.totp_pending.blank? || @two_step_setup_expired?

    Crypto.decrypt(this.totp_pending, getenv("SOLI_ENCRYPTION_KEY"))
  end

  # A setup started more than TWO_STEP_PENDING_SECONDS ago (#687): its
  # secret no longer takes a code. One started before #687 kept no time,
  # and has run out too.
  def two_step_setup_expired?
    return false if this.totp_pending.blank?

    DateTime.utc.to_unix - this.totp_pending_at.to_s.to_i > TWO_STEP_PENDING_SECONDS
  end

  # What an authenticator app enrols from (the QR code's text).
  def two_step_uri(secret)
    Crypto.totp_uri(secret, this.email, "Score")
  end

  # The pending secret turned on, if `code` is one of its: the backup codes,
  # to show once; nil when the code is not.
  #
  # Each code is counted before it is checked (#687), as the sign-in's are
  # (TwoStepGuard.take_try): TWO_STEP_MAX_WRONG wrong ones pause the code
  # step, this one included — no code is checked then (`codes_locked?`).
  def confirm_two_step(code)
    secret = this.pending_two_step()
    return nil if secret.nil?
    return nil if TwoStepGuard.take_try(this).nil?

    step = User.totp_step(secret, code, DateTime.utc().to_unix())
    return nil if step.nil?

    TwoStepGuard.clear_wrong(this)

    codes = (1 .. TOTP_BACKUP_COUNT + 1).map do |_|
      User.backup_code()
    end
    this.totp_secret = this.totp_pending
    this.totp_pending = null
    this.totp_last_step = step
    this.totp_backup = codes.map do |c|
      Crypto.sha256(User.backup_digest_text(c))
    end
    this.totp_enabled_at = DateTime.utc().to_unix()
    # Every session and remembered browser opened on the password alone is
    # signed out (#538): turned on because the password may be known, it
    # would otherwise leave in whoever got in with it. The browser that
    # turned it on is stamped again by the controller.
    this.session_version = (this.session_version ?? 0) + 1
    this.remember_token_digest = null
    this.update()
    codes
  end

  # Whether `code` passes the second step: a code of the app not used
  # before, or a backup code not used before — which is then spent.
  #
  # Spent as a compare-and-set on the account's TwoStepGuard row (#538):
  # reading the account, then writing it, let two requests sent together
  # both pass with the same code, each having read it unused. The account
  # read again must still have this secret on: a copy read before two-step
  # was turned off passes nothing.
  def second_step?(code)
    return false unless this.two_step?()

    stored = User.find_by("_key", this._key)
    return false if stored.nil? || stored.totp_secret != this.totp_secret

    guard = TwoStepGuard.of(this)
    text = code.to_s.replace(" ", "")
    if Regex.matches("^[0-9]{6}$", text)
      secret = Crypto.decrypt(this.totp_secret, getenv("SOLI_ENCRYPTION_KEY"))
      step = User.totp_step(secret, text, DateTime.utc().to_unix())
      return false if step.nil?

      return this._spent_step(guard, step, stored.totp_last_step)
    end
    digest = Crypto.sha256(User.backup_digest_text(text))
    this._spent_backup(guard, digest, stored.totp_backup ?? [])
  end

  # The code of time step `step` spent from `guard` (the account's
  # TwoStepGuard row, as read): whether it was. The account keeps the step
  # too, written alone, for what it shows.
  def _spent_step(guard, step, floor)
    return false unless TwoStepGuard.spend_step(guard, step, floor)

    @_patch_stored({"totp_last_step": step})
    this.totp_last_step = step
    true
  end

  # The backup code of `digest` spent from `guard`, if it is one of
  # `valid` (the account's set): whether it was. The set itself stays as
  # issued — the codes left are counted against the guard's `spent`
  # (`backup_codes_left`): a list written back from a copy read before
  # another code was spent would make that code good again.
  def _spent_backup(guard, digest, valid)
    TwoStepGuard.spend_backup(guard, digest, valid)
  end

  # Whether `code` passes the second step, counted (#538): the try is
  # counted first (TwoStepGuard.take_try), so requests sent together cannot
  # all pass the pause's check before any is counted; while the code step
  # is paused no code is looked at, the right one included. A wrong one
  # stays counted, wherever it is typed — signing in, turning two-step off,
  # a new address, deleting the account — and the owner is told when it
  # paused the code step; a right one gives the count back.
  def second_step_counted?(code)
    tried = TwoStepGuard.take_try(this)
    return false if tried.nil?

    if this.second_step?(code)
      TwoStepGuard.clear_wrong(this)
      return true
    end
    @_tell_paused if tried == "pausing"
    false
  end

  # Whether the code step is paused, after too many wrong codes.
  def codes_locked?
    TwoStepGuard.locked?(this)
  end

  # One more wrong code (a try counted, known wrong): whether it paused the
  # code step, the owner then told (queued, AuthMailJob), once a pause.
  def count_wrong_code
    paused = TwoStepGuard.take_try(this) == "pausing"
    @_tell_paused if paused
    paused
  end

  def _tell_paused
    AuthMailJob.ask("account_locked", @email, {
      "lock": "code",
      "by_code": true
    })
  end

  # The backup codes not spent yet: the set issued, less those the
  # second step's record has as spent (TwoStepGuard).
  def backup_codes_left
    TwoStepGuard.codes_left(this, this.totp_backup ?? [])
  end

  def stop_two_step
    this.totp_secret = null
    this.totp_pending = null
    this.totp_backup = null
    this.totp_last_step = null
    this.totp_enabled_at = null
    this.update()
  end

  # An AI key of one's own, for reading photos of scores and the editor's
  # assistant (AiClient):
  # `provider` one of AI_PROVIDERS, the key kept encrypted and
  # shown only by its last four characters. An error message, or nil once
  # kept.
  def keep_ai_key(provider, model, key)
    return SiteText.t("app.account.ai_choose_provider") unless AI_PROVIDERS.has_key(provider.to_s)
    return SiteText.t("app.account.ai_name_model") if model.to_s.trim.blank?
    return SiteText.t("app.account.ai_paste_key") if key.to_s.trim.length < 8
    return SiteText.t("app.account.ai_no_keys_here") unless User.two_step_available?()

    this.ai_provider = provider
    this.ai_model = model.to_s.trim
    typed = key.to_s.trim
    this.ai_key = Crypto.encrypt(typed, getenv("SOLI_ENCRYPTION_KEY"))
    this.ai_key_hint = typed.substring(typed.length - 4, typed.length)
    this.update()
    nil
  end

  def own_ai?
    !this.ai_key.blank?
  end

  def ai_provider_name
    AiClient.provider_name(this.ai_provider)
  end

  # The providers a key may be for, as the account page lists them.
  def ai_choices
    AI_PROVIDERS.keys.map do |id|
      {
        "id": id,
        "name": AI_PROVIDERS[id]["name"],
        "models": AI_PROVIDERS[id]["models"]
      }
    end
  end

  def forget_ai_key
    this.ai_provider = null
    this.ai_model = null
    this.ai_key = null
    this.ai_key_hint = null
    this.update()
  end

  # This person's own provider, model and key; nil without one. The site
  # has no key of its own to fall back on (#396); whether this one may be
  # used now is AiClient.refusal's.
  def ai_settings
    return nil unless @own_ai?

    {
      "provider": @ai_provider,
      "model": @ai_model,
      "key": Crypto.decrypt(@ai_key, getenv("SOLI_ENCRYPTION_KEY"))
    }
  end

  # Why the AI cannot run for them now (AiClient.refusal), or nil: for the
  # pages, which cannot reach AiClient.
  def ai_refusal(open = nil)
    AiClient.refusal(this, open)
  end

  # What the account's AI section says when the plan stands in the way
  # (payments open, not on Pro), or nil: a kept key stays kept, unused.
  def ai_plan_note(open = nil)
    return nil unless @ai_refusal(open) == "plan"

    pro_only = SiteText.t("app.account.ai_pro_only")
    return pro_only unless @own_ai?

    "#{pro_only} #{SiteText.t("app.account.ai_key_kept")}"
  end

  # --- Notification e-mails (#385) ---------------------------------------------

  # Whether `kind` (NOTIFICATION_KINDS) is e-mailed to them: each is, until
  # they turn it off. The app lists every notification either way.
  def mails?(kind)
    (@mail_prefs ?? {})[kind] != false
  end

  # The e-mails they want: the kinds in `wanted`, the others off.
  def keep_mail_prefs(wanted)
    chosen = wanted ?? []
    prefs = {}
    NOTIFICATION_KINDS.each do |kind|
      prefs[kind] = chosen.includes?(kind)
    end
    @mail_prefs = prefs
    @save
  end

  # Whether a push notification of `kind` (#400) goes to their devices:
  # every kind until they choose.
  def pushes?(kind)
    (@push_prefs ?? {})[kind] != false
  end

  # What the account page's Push section needs (#400), which a view cannot
  # ask WebPush or PushSubscription itself: the key a browser subscribes
  # with ("" while push is not set up here) and how many devices are on.
  def push_setup
    {"key": WebPush.public_key, "devices": PushSubscription.count_of(this)}
  end

  # The push notifications they want: the kinds in `wanted`, the others off.
  def keep_push_prefs(wanted)
    chosen = wanted ?? []
    prefs = {}
    NOTIFICATION_KINDS.each do |kind|
      prefs[kind] = chosen.includes?(kind)
    end
    @push_prefs = prefs
    @save
  end

  # --- The plan (#393) --------------------------------------------------------
  #
  # Set by Stripe's webhook only (Billing): `plan`, `plan_status`,
  # `current_period_end`, `cancel_at_period_end`, `stripe_customer_id`,
  # `stripe_subscription_id`. What each plan allows is Plan's.

  # Whether the account is on Pro now: a Pro subscription active or on
  # trial, whose period paid for has not ended.
  def pro?
    @pro_at?(DateTime.utc.to_unix)
  end

  def pro_at?(now)
    return false unless @plan == "pro"
    return false unless ["active", "trialing"].includes?(@plan_status.to_s)
    return false if @current_period_end.nil?

    @current_period_end.to_s.to_i > now
  end

  # --- What an admin may change (#399, /admin) ----------------------------------

  # Whether Pro is paid for through Stripe: a subscription the webhook set.
  def paying?
    @pro? && @plan_gift != true && @stripe_subscription_id.present?
  end

  # Pro offered for `days` from `now`: nil, or why not. An offer already
  # running is lengthened from its end; a paying account is left alone.
  def gift_pro(days, now)
    return "This account pays for Pro already: Stripe manages it." if @paying?
    return "An offer lasts from 1 to 3660 days." if days < 1 || days > 3660

    starts = @plan_gift == true && @pro_at?(now) ? @current_period_end.to_s.to_i : now
    @plan = "pro"
    @plan_status = "active"
    @plan_gift = true
    @cancel_at_period_end = false
    @current_period_end = starts + days * 86400
    @update()
    nil
  end

  # The offer of Pro ended now: back on Free. nil, or why not.
  def stop_gift
    return "This account has no offer of Pro." unless @plan_gift == true

    @plan = "free"
    @plan_status = "canceled"
    @plan_gift = false
    @current_period_end = nil
    @update()
    nil
  end

  # Signing in allowed again after too many wrong passwords, from every
  # address, and the code step's pause lifted too (#538): an admin lifts
  # the lock whole.
  def unlock
    TwoStepGuard.clear_wrong(this)
    @locked_at = nil
    @failed_attempts = 0
    @sign_in_failures = nil
    @account_failures = nil
    @account_locked_at = nil
    @update()
  end

  # The plan's name, as the account page shows it.
  def plan_name
    SiteText.t(@pro? ? "app.account.plan_pro" : "app.account.plan_free")
  end

  # What the account page says of the subscription at `now`, or nil on Free
  # with nothing to say.
  def plan_summary(now = nil)
    at = now ?? DateTime.utc.to_unix
    ends = @current_period_end.nil? ? "" : User.plan_date(@current_period_end.to_s.to_i)
    when_ends = {"date": ends}
    if @pro_at?(at)
      return SiteText.t("app.account.plan_offered", when_ends) if @plan_gift == true
      return SiteText.t("app.account.plan_ends", when_ends) if @cancel_at_period_end == true
      return SiteText.t("app.account.plan_trial", when_ends) if @plan_status == "trialing"

      return SiteText.t("app.account.plan_renews", when_ends)
    end

    return SiteText.t("app.account.plan_failed") if ["past_due", "unpaid"].includes?(@plan_status.to_s)
    return SiteText.t("app.account.plan_ended", when_ends) if @plan == "pro" && !ends.blank?

    nil
  end

  # `unix` as the account page writes a date, in the request's language:
  # "November 1, 2026", "1er novembre 2026".
  static def plan_date(unix)
    day = DateTime.from_unix(unix)
    number = day.format("%-d")
    number = SiteText.t("app.account.plan_first_day") if number == "1"
    SiteText.t(
      "app.account.plan_date",
      {
        "month": SiteText.t("date.months.m#{day.format("%m").to_i}"),
        "d": number,
        "year": day.format("%Y")
      }
    )
  end

  # Whether there is a Stripe customer to manage (Manage billing).
  def billed?
    @stripe_customer_id.present?
  end

  # What the account page offers (Plan, Stripe): the prices, and whether
  # payments are open. A page cannot reach those classes; it asks here.
  def plan_offer
    {
      "monthly": Plan.price("monthly"),
      "annual": Plan.price("annual"),
      "open": Stripe.configured?
    }
  end

  # The account gone, and all it left, its writing on other people's
  # scores and in the library included (AccountErasure, #686). A
  # subscription is cancelled first; if Stripe cannot be reached, that is
  # logged and the account goes all the same. `batch`: how many rows are
  # read at a time.
  def erase_account(batch = ERASE_BATCH)
    AccountErasure.erase(this, batch)
  end

  # The time step `code` is for, one step either side of `now`, or nil.
  static def totp_step(secret, code, now)
    text = code.to_s.replace(" ", "")
    return nil unless Regex.matches("^[0-9]{6}$", text)

    here = now / 30
    [here - 1, here, here + 1].find do |step|
      Crypto.secure_compare(Crypto.totp_generate(secret, step * 30, 30), text)
    end
  end

  # A backup code, xxxxx-xxxxx.
  static def backup_code
    letters = Crypto.random_bytes(10).map do |b|
      TOTP_BACKUP_ALPHABET[b % TOTP_BACKUP_ALPHABET.length]
    end
    letters.slice(0, 5).join("") + "-" + letters.slice(5, 10).join("")
  end

  # A backup code as it is kept: lower case, without its dash or spaces.
  static def backup_digest_text(code)
    code.to_s.downcase().replace("-", "").replace(" ", "")
  end
end
