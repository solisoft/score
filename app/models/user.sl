# User model — generated by `soli generate auth`.
# Collection: users
#
# Passwords are never stored in plaintext: assign through `set_password`,
# which hashes with Argon2id (the built-in Crypto module), and verify with
# `authenticate`. Reset/confirmation/remember tokens are random UUIDs whose
# SHA-256 digest is stored — a database leak can't be replayed as a live link.

# --- Auth flow tuning --------------------------------------------------------
const AUTH_RESET_TOKEN_TTL = 7200  # password-reset links live 2 hours
const AUTH_MAX_FAILED_ATTEMPTS = 10  # failed logins before lockout
const AUTH_LOCKOUT_SECONDS = 1800  # auto-unlock after 30 minutes
const AUTH_CONFIRMATION_TOKEN_TTL = 172800  # confirmation links last 48 hours
const AUTH_REMEMBER_DAYS = 30  # remember-me cookie lifetime
const AUTH_MIN_PASSWORD_LENGTH = 12  # shortest password accepted at sign-up
const TOTP_ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"  # Base32, for the authenticator's secret
const TOTP_BACKUP_ALPHABET = "abcdefghjkmnpqrstuvwxyz23456789"  # backup codes: no 0/o, 1/l/i
const TOTP_BACKUP_COUNT = 10
# A link to confirm a new e-mail address lives 24 hours.
const EMAIL_CHANGE_TTL = 86400
# Changes of address one person may ask for in an hour, right or wrong
# password: the form must not become a way to guess it.
const EMAIL_CHANGES_PER_HOUR = 5

# Per-IP throttle on the credential endpoints (login, sign-up, reset). The
# per-account lockout above cannot see these two attacks: credential stuffing
# spread thinly across thousands of accounts never trips it, and an attacker
# who knows an email address can lock its owner out on demand. Keying on the
# source address covers both.
const AUTH_ATTEMPTS_PER_IP = (getenv("AUTH_ATTEMPTS_PER_IP") ?? "15").to_i
const AUTH_IP_WINDOW_SECONDS = 300
# Account e-mails asked for from a form (a confirmation link sent again, a
# password reset): at most AUTH_EMAILS_PER_ADDRESS to one address, and
# AUTH_EMAILS_PER_IP asked from one source address, in AUTH_EMAILS_WINDOW_SECONDS.
# Counted whether or not the address has an account, so a refusal says
# nothing of it.
const AUTH_EMAILS_PER_ADDRESS = 5
const AUTH_EMAILS_PER_IP = (getenv("AUTH_EMAILS_PER_IP") ?? "20").to_i
const AUTH_EMAILS_WINDOW_SECONDS = 3600
# What a refused request reads, the same for any address.
const AUTH_EMAILS_REFUSED = "Too many emails asked for: try again in an hour."

# Sign-up against spam (#448), past the honeypot and the render time every
# form carries: each sign-up page asks the browser for a proof of work of
# SIGNUP_POW_BITS bits (well under a second for a person, real CPU for a bot
# making accounts by the thousand), one source address makes
# SIGNUPS_PER_IP_HOUR accounts an hour at most, and a throwaway address —
# the kind made to receive one mail and vanish — is refused.
const SIGNUP_POW_BITS = (getenv("SIGNUP_POW_BITS") ?? "17").to_i
const SIGNUPS_PER_IP_HOUR = (getenv("SIGNUPS_PER_IP_HOUR") ?? "10").to_i
const THROWAWAY_EMAIL_DOMAINS = [
  "mailinator.com",
  "guerrillamail.com",
  "guerrillamail.net",
  "guerrillamail.org",
  "guerrillamailblock.com",
  "sharklasers.com",
  "grr.la",
  "10minutemail.com",
  "10minutemail.net",
  "yopmail.com",
  "yopmail.fr",
  "yopmail.net",
  "temp-mail.org",
  "tempmail.com",
  "tempmail.net",
  "tempmailo.com",
  "temp-mail.io",
  "tempail.com",
  "throwawaymail.com",
  "trashmail.com",
  "trashmail.de",
  "getnada.com",
  "nada.email",
  "dispostable.com",
  "maildrop.cc",
  "mailnesia.com",
  "mintemail.com",
  "mohmal.com",
  "emailondeck.com",
  "fakeinbox.com",
  "spamgourmet.com",
  "getairmail.com",
  "mailcatch.com",
  "moakt.com",
  "burnermail.io",
  "33mail.com",
  "spam4.me",
  "inboxkitten.com",
  "1secmail.com",
  "1secmail.net",
  "1secmail.org",
  "mail.tm",
  "mail.gw",
  "emailfake.com",
  "fakemail.net",
  "discard.email",
  "mailpoof.com",
  "tmail.ws",
  "tmpmail.org",
  "tmpmail.net"
]

# Base URL used in password-reset / confirmation emails.
#
# Read from the environment so a deployment sets it once, next to its other
# config, rather than by editing this file. The literal fallback is a dev
# convenience: left in place in production it mails `http://localhost` reset
# links, which are both useless and, if the host does resolve, sent in the
# clear. Set APP_BASE_URL to your `https://` origin.
def auth_base_url
  return getenv("APP_BASE_URL").to_s if getenv("APP_BASE_URL").present?
  # The site's own setting (deploy/README.md), which the share tags read too.
  return getenv("APP_URL").to_s if getenv("APP_URL").present?

  "http://localhost:5011"
end

# Require a confirmed email before sign-in: the site sends mail (SOLI_SMTP_*,
# deploy/README.md), and an account whose link went astray asks for another
# from the sign-in page or the confirmation page.
def auth_require_confirmed_email
  true
end

class User < Model
  # Fields: email, password_digest, role, plus the auth-flow fields:
  # reset_token_digest, reset_sent_at, confirmation_token_digest,
  # confirmation_sent_at, confirmed_at, remember_token_digest,
  # failed_attempts, locked_at.
  # (Model stores fields dynamically — no need to declare them.)
  validates(
    "email",
    {
      "presence": true,
      "uniqueness": true,
      "format": "email"
    }
  )
  before_save("normalize")

  def normalize
    this.email = this.email.trim().downcase() unless this.email.blank?
    this.role = "member" if this.role.blank?
  end

  # Hash `plaintext` and store it in `password_digest`. No-op when blank so a
  # profile update that doesn't change the password leaves the digest intact.
  # Callers that accept a *new* password must run `password_error` first —
  # this method deliberately has no opinion, so that a profile save with no
  # password field doesn't wipe the digest.
  def set_password(plaintext)
    return if plaintext.blank?

    this.password_digest = Crypto.password_hash(plaintext)
  end

  # Why `plaintext` is unacceptable as a new password, or null when it is fine.
  #
  # Length is the only rule here on purpose. Composition rules ("one digit,
  # one symbol") push people toward `Password1!` — they add a decimal digit of
  # real entropy and a lot of friction. Length is what actually raises the
  # cost of an offline attack against the Argon2id digest.
  def password_error(plaintext)
    value = plaintext.to_s
    return SiteText.t("auth.password_required") if value.blank?

    if value.length() < AUTH_MIN_PASSWORD_LENGTH
      return SiteText.t("auth.password_short", {"n": AUTH_MIN_PASSWORD_LENGTH})
    end

    null
  end

  # True when `plaintext` matches the stored Argon2id digest.
  def authenticate(plaintext)
    return false if this.password_digest.blank?

    Crypto.password_verify(plaintext, this.password_digest)
  end

  # Spend the same Argon2id work as a real `authenticate` without having an
  # account to check against. Sign-in calls this when no user matches the
  # submitted email: verifying costs ~100ms and returning early costs none, so
  # without it the response time alone tells an attacker which addresses are
  # registered — a user-enumeration oracle that no error-message wording can
  # close. The result is deliberately discarded.
  static def burn_password_work(plaintext)
    Crypto.password_hash(plaintext.to_s)
    return false
  end

  # Whether an account e-mail may go to `email`, asked from `ip`: each one
  # allowed counts against both, whether or not `email` has an account.
  # Whether `email` is at a throwaway address's domain, or one of its
  # subdomains (#448).
  static def throwaway_email?(email)
    domain = email.to_s.trim.downcase.split("@").last.to_s
    return false if domain.blank?

    THROWAWAY_EMAIL_DOMAINS.any? do |known|
      domain == known || domain.ends_with?(".#{known}")
    end
  end

  static def account_email_allowed?(email, ip)
    by_ip = RateLimiter("account-email-ip:#{ip}", AUTH_EMAILS_PER_IP, AUTH_EMAILS_WINDOW_SECONDS)
    by_address = RateLimiter(
      "account-email-to:#{email.to_s.trim.downcase}",
      AUTH_EMAILS_PER_ADDRESS,
      AUTH_EMAILS_WINDOW_SECONDS
    )
    return false if by_ip.throttle() > 0 || by_address.throttle() > 0

    by_ip.allowed() && by_address.allowed()
  end

  def admin?
    this.role == "admin"
  end

  # `text` as the name others see this person by — in the shared library
  # (#444), in comments — when they give one: nil once done, else why not.
  # A blank name leaves the one they have.
  def name_as(text)
    name = text.to_s.trim
    return nil if name.blank? || name == @name.to_s
    return "A name holds 60 characters at most." if name.chars().length > 60

    @name = name
    @update()
    nil
  end

  # How the app names someone to others: their name when they have one, else
  # their email address.
  def display_name
    @name.blank? ? @email : @name
  end

  # The users whose keys are `keys` (blanks and repeats ignored), each key to
  # its `display_name`: one query however many there are, reading nothing
  # else of them. A key with no user left is missing from the answer.
  static def names_of(keys)
    wanted = keys.filter do |key|
      !key.blank?
    end
    return {} if wanted.length == 0

    User.names_in(User.named(wanted).all)
  end

  # The query for the users whose keys are `keys`, reading only what names
  # them: to run alone (`names_of`) or among others in `grouped`.
  static def named(keys)
    wanted = keys.filter do |key|
      !key.blank?
    end.uniq
    User.where("doc._key IN @keys", {"keys": wanted}).select("email", "name")
  end

  # `users` (read by `named`), each key to its `display_name`.
  static def names_in(users)
    names = {}
    users.each do |user|
      names[user._key] = user.display_name
    end
    names
  end

  # --- Password reset ---------------------------------------------------------

  # Issue a reset token: returns the plaintext token (goes into the email);
  # only its digest is stored.
  def start_password_reset
    token = uuid_v4()
    this.reset_token_digest = Crypto.sha256(token)
    this.reset_sent_at = DateTime.utc().to_unix()
    this.update()
    token
  end

  def reset_token_expired?
    return true if this.reset_sent_at.nil?

    DateTime.utc().to_unix() - this.reset_sent_at > AUTH_RESET_TOKEN_TTL
  end

  # Set the new password, burn the token, and clear any lockout.
  #
  # Also drops the remember-me digest. Resetting a password is what someone
  # does when they think the account is compromised, and a remember-me cookie
  # outlives it by up to AUTH_REMEMBER_DAYS — leaving it valid means the reset
  # doesn't actually evict the attacker.
  def finish_password_reset(plaintext)
    this.set_password(plaintext)
    this.reset_token_digest = null
    this.reset_sent_at = null
    this.remember_token_digest = null
    # A change of address under way is dropped too: the reset is what the
    # owner does when the change was not theirs.
    this.forget_email_change()
    this.failed_attempts = 0
    this.locked_at = null
    # Invalidate every session opened before this moment.
    #
    # Sessions are not indexed by user, so there is nothing to delete; instead
    # each session records the `session_version` it was opened at, and
    # `load_current_user` refuses one that is behind. Without this, an attacker
    # who was already signed in stayed signed in through the victim's reset —
    # which is the one thing a password reset is supposed to stop.
    this.session_version = (this.session_version ?? 0) + 1
    this.update()
  end

  # Why the password cannot become `new_password`, or nil: the current one
  # must be right, the new one acceptable, and typed the same twice.
  def password_change_error(current, new_password, confirmation)
    return SiteText.t("app.account.not_current_password") unless this.authenticate(current.to_s)

    error = this.password_error(new_password)
    return error unless error.nil?
    return SiteText.t("app.account.passwords_differ") if new_password.to_s != confirmation.to_s

    null
  end

  # A new password, and every other session and remembered browser signed
  # out, as after a reset.
  def change_password(plaintext)
    this.set_password(plaintext)
    this.remember_token_digest = null
    this.forget_email_change()
    this.session_version = (this.session_version ?? 0) + 1
    this.update()
  end

  # Bumped whenever every existing session must be invalidated (a password
  # reset today; add other events here as they appear).
  def current_session_version
    this.session_version ?? 0
  end

  # --- Email confirmation -----------------------------------------------------
  def start_email_confirmation
    token = uuid_v4()
    this.confirmation_token_digest = Crypto.sha256(token)
    this.confirmation_sent_at = DateTime.utc().to_unix()
    this.update()
    token
  end

  # Confirmation links expire like reset links do.
  #
  # `confirmation_sent_at` was stored and never read, so a link stayed valid
  # forever: a forwarded email, an archived mailbox, or a link-following
  # security scanner could confirm the address (and, before the change below,
  # sign in as that user) months later.
  def confirmation_token_expired?
    return true if this.confirmation_sent_at.nil?

    DateTime.utc().to_unix() - this.confirmation_sent_at > AUTH_CONFIRMATION_TOKEN_TTL
  end

  def confirm_email
    this.confirmed_at = DateTime.utc().to_unix()
    this.confirmation_token_digest = null
    this.confirmation_sent_at = null
    this.update()
  end

  def confirmed?
    !this.confirmed_at.nil?
  end

  # --- Change of e-mail address -----------------------------------------------
  #
  # The new address is kept aside (`email_change_to`) with the digest of a
  # link's token, until the link mailed to it is followed: only then does
  # the account change address. The old address is told when it is asked.

  # Why the address cannot become `new_email`, or nil: the password (and,
  # with two-step sign-in on, a code) must be right, the address one, not
  # this account's, and not another account's.
  def email_change_error(new_email, password, code)
    address = new_email.to_s.trim.downcase
    return SiteText.t("app.account.email_wrong_password") unless this.authenticate(password.to_s)
    return SiteText.t("app.account.email_wrong_code") if this.two_step?() && !this.second_step?(code)

    return SiteText.t("app.account.email_invalid") unless Regex.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$", address)
    return SiteText.t("app.account.email_same") if address == this.email
    return SiteText.t("app.account.email_taken") unless User.find_by("email", address).nil?

    nil
  end

  # `new_email` kept aside until its link is followed: the link's token,
  # which only the mail to that address carries (its digest is kept).
  def start_email_change(new_email)
    token = uuid_v4()
    this.email_change_to = new_email.to_s.trim.downcase
    this.email_change_digest = Crypto.sha256(token)
    this.email_change_sent_at = DateTime.utc.to_unix
    this.update()
    token
  end

  def email_change_expired?
    return true if this.email_change_sent_at.nil?

    DateTime.utc.to_unix - this.email_change_sent_at > EMAIL_CHANGE_TTL
  end

  # The change under way dropped (not saved: the caller saves).
  def forget_email_change
    this.email_change_to = null
    this.email_change_digest = null
    this.email_change_sent_at = null
    true
  end

  # Whether `user` may ask for one more change of address now: each asked
  # for counts, refused or not.
  static def email_change_allowed?(user)
    RateLimiter("email-change:#{user._key}", EMAIL_CHANGES_PER_HOUR, 3600).allowed()
  end

  # What the link with `token` is: {"user", "state"}, the state "ready",
  # "expired", "done" (followed already: the user is the account it
  # changed) or "unknown" (no user).
  static def email_change_for(token)
    if token.to_s.blank?
      return {"user": nil, "state": "unknown"}
    end

    digest = Crypto.sha256(token.to_s)
    user = User.find_by("email_change_digest", digest)
    unless user.nil?
      return {"user": user, "state": user.email_change_expired?() ? "expired" : "ready"}
    end

    done = User.find_by("email_changed_digest", digest)
    unless done.nil?
      return {"user": done, "state": "done"}
    end

    {"user": nil, "state": "unknown"}
  end

  # The change confirmed: the account takes the new address (confirmed, as
  # the link proves it is theirs), the shares made to the old one move with
  # it, and every session and remembered browser is signed out. The old
  # address, or nil when the new one has meanwhile become another
  # account's: the change is then dropped, and nothing else changes.
  def finish_email_change
    address = this.email_change_to
    unless User.find_by("email", address).nil?
      this.forget_email_change()
      this.update()
      return nil
    end

    old = this.email
    this.email = address
    this.confirmed_at = DateTime.utc.to_unix
    this.email_changed_digest = this.email_change_digest
    this.forget_email_change()
    this.remember_token_digest = null
    this.session_version = (this.session_version ?? 0) + 1
    this.update()
    ScoreShare.move_address(old, address, this)
    old
  end

  # How many zips "Export all my data" comes in (AccountExport): what the
  # account page can ask, where the service is out of reach.
  def export_part_count
    AccountExport.parts(this).length
  end

  # --- Remember me ------------------------------------------------------------
  def start_remember_me
    token = uuid_v4()
    this.remember_token_digest = Crypto.sha256(token)
    this.update()
    token
  end

  def forget_me
    return true if this.remember_token_digest.blank?

    this.remember_token_digest = null
    this.update()
  end

  def remembered_by?(token)
    return false if this.remember_token_digest.blank?

    Crypto.secure_compare(Crypto.sha256(token.to_s), this.remember_token_digest)
  end

  # --- Account lockout --------------------------------------------------------
  def locked?
    return false if this.locked_at.nil?

    if DateTime.utc().to_unix() - this.locked_at > AUTH_LOCKOUT_SECONDS
      # The lockout window has passed — auto-unlock.
      this.locked_at = null
      this.failed_attempts = 0
      this.update()
      return false
    end
    true
  end

  # A wrong password, or with `by_code` a wrong second-step code (#538):
  # both count towards the same lock, so that the codes cannot be guessed
  # by opening sign-in after sign-in with a password already known.
  def register_failed_attempt(by_code = false)

    # Don't re-stamp `locked_at` on an account that is *currently* locked:
    # doing so slides the 30-minute window forward on every further guess, so
    # an attacker who keeps knocking keeps the owner locked out indefinitely.
    # The lockout should expire on schedule no matter how loud the attack is.
    #
    # Ask `locked?()` rather than testing `locked_at` directly — it is what
    # clears an expired stamp. Testing the raw field meant that once the first
    # lockout landed, nothing on the failure path ever cleared it, so
    # `failed_attempts` froze and the account could never lock a second time:
    # after the first window elapsed the attacker guessed at full rate forever.
    return true if this.locked?()

    this.failed_attempts = (this.failed_attempts ?? 0) + 1
    just_locked = this.failed_attempts >= AUTH_MAX_FAILED_ATTEMPTS
    this.locked_at = DateTime.utc().to_unix() if just_locked
    this.update()

    # Tell the owner once, when the lock trips. The sign-in response says only
    # "Invalid email or password" whether or not the account is locked, because
    # a distinct "locked" reply during the lockout tells an attacker which guess
    # was the right one. Delivery failures must not break sign-in.
    if just_locked
      try
        AuthMailer.account_locked(this, AUTH_LOCKOUT_SECONDS / 60, by_code).deliver()
      catch error
        Logger.warn("account-locked notification failed: " + str(error))
      end
    end

    true
  end

  def clear_failed_attempts
    attempts = this.failed_attempts ?? 0
    return if attempts == 0 && this.locked_at.nil?

    this.failed_attempts = 0
    this.locked_at = null
    this.update()
  end

  # --- Two-step sign-in (TOTP) -------------------------------------------------
  #
  # An authenticator app's six-digit codes on top of the password, if the
  # owner turns it on. The secret is stored encrypted (SOLI_ENCRYPTION_KEY):
  # `totp_pending` while it is being set up, `totp_secret` once a first code
  # proves the app holds it. The time step of each accepted code is kept, so
  # a code is good once; ten backup codes, kept as digests, are good once each.

  # Whether this server can keep the secrets: it has a key to encrypt them.
  static def two_step_available?
    getenv("SOLI_ENCRYPTION_KEY").present?
  end

  def two_step?
    !this.totp_secret.blank?
  end

  # The same question as `two_step_available?`, asked of an account: what a
  # page can call, where the model's class is out of reach.
  def can_use_two_step?
    User.two_step_available?()
  end

  # A new secret, kept aside until a code confirms it: its Base32 text.
  def start_two_step
    secret = Crypto.random_bytes(32).map do |b|
      TOTP_ALPHABET[b % 32]
    end.join("")
    this.totp_pending = Crypto.encrypt(secret, getenv("SOLI_ENCRYPTION_KEY"))
    this.update()
    secret
  end

  # The secret being set up, or nil.
  def pending_two_step
    return nil if this.totp_pending.blank?

    Crypto.decrypt(this.totp_pending, getenv("SOLI_ENCRYPTION_KEY"))
  end

  # What an authenticator app enrols from (the QR code's text).
  def two_step_uri(secret)
    Crypto.totp_uri(secret, this.email, "Score")
  end

  # The pending secret turned on, if `code` is one of its: the backup codes,
  # to show once; nil when the code is not.
  def confirm_two_step(code)
    secret = this.pending_two_step()
    return nil if secret.nil?

    step = User.totp_step(secret, code, DateTime.utc().to_unix())
    return nil if step.nil?

    codes = (1 .. TOTP_BACKUP_COUNT + 1).map do |_|
      User.backup_code()
    end
    this.totp_secret = this.totp_pending
    this.totp_pending = null
    this.totp_last_step = step
    this.totp_backup = codes.map do |c|
      Crypto.sha256(User.backup_digest_text(c))
    end
    this.totp_enabled_at = DateTime.utc().to_unix()
    # Every session and remembered browser opened on the password alone is
    # signed out (#538): turned on because the password may be known, it
    # would otherwise leave in whoever got in with it. The browser that
    # turned it on is stamped again by the controller.
    this.session_version = (this.session_version ?? 0) + 1
    this.remember_token_digest = null
    this.update()
    codes
  end

  # Whether `code` passes the second step: a code of the app not used
  # before, or a backup code not used before — which is then spent.
  #
  # Spent in one conditional statement each (#538): reading the account,
  # then writing it, let two requests sent together both pass with the same
  # code, each having read it unused. The statement matches only while the
  # code is still unused and the same secret still on; matching nothing is a
  # refusal.
  def second_step?(code)
    return false unless this.two_step?()

    text = code.to_s.replace(" ", "")
    if Regex.matches("^[0-9]{6}$", text)
      secret = Crypto.decrypt(this.totp_secret, getenv("SOLI_ENCRYPTION_KEY"))
      step = User.totp_step(secret, text, DateTime.utc().to_unix())
      return false if step.nil? || step <= (this.totp_last_step ?? -1)

      return this._spend_step(step)
    end
    digest = Crypto.sha256(User.backup_digest_text(text))
    left = this.totp_backup ?? []
    return false unless left.includes?(digest)

    this._spend_backup(digest)
  end

  # `step` kept as the last one used, unless a code of it or of a later one
  # was used meanwhile: whether it was.
  def _spend_step(step)
    user_key = this._key
    secret = this.totp_secret
    written = @sdbql{
      FOR u IN users
      FILTER u._key == #{user_key} AND u.totp_secret == #{secret}
      FILTER u.totp_last_step == null OR u.totp_last_step < #{step}
      UPDATE u WITH { totp_last_step: #{step} } IN users
      RETURN NEW
    }
    raise("The code could not be spent: #{written}") if type(written) == "string"
    return false if written.length == 0

    this.totp_last_step = step
    true
  end

  # The backup code of `digest` taken off the list, unless it was meanwhile:
  # whether it was.
  def _spend_backup(digest)
    user_key = this._key
    secret = this.totp_secret
    written = @sdbql{
      FOR u IN users
      FILTER u._key == #{user_key} AND u.totp_secret == #{secret} AND POSITION(u.totp_backup, #{digest})
      UPDATE u WITH { totp_backup: (FOR d IN u.totp_backup FILTER d != #{digest} RETURN d) } IN users
      RETURN NEW
    }
    raise("The code could not be spent: #{written}") if type(written) == "string"
    return false if written.length == 0

    this.totp_backup = written[0]["totp_backup"]
    true
  end

  def backup_codes_left
    left = this.totp_backup ?? []
    left.length
  end

  def stop_two_step
    this.totp_secret = null
    this.totp_pending = null
    this.totp_backup = null
    this.totp_last_step = null
    this.totp_enabled_at = null
    this.update()
  end

  # An AI key of one's own, for reading photos of scores and the editor's
  # assistant (AiClient):
  # `provider` one of AI_PROVIDERS, the key kept encrypted and
  # shown only by its last four characters. An error message, or nil once
  # kept.
  def keep_ai_key(provider, model, key)
    return SiteText.t("app.account.ai_choose_provider") unless AI_PROVIDERS.has_key(provider.to_s)
    return SiteText.t("app.account.ai_name_model") if model.to_s.trim.blank?
    return SiteText.t("app.account.ai_paste_key") if key.to_s.trim.length < 8
    return SiteText.t("app.account.ai_no_keys_here") unless User.two_step_available?()

    this.ai_provider = provider
    this.ai_model = model.to_s.trim
    typed = key.to_s.trim
    this.ai_key = Crypto.encrypt(typed, getenv("SOLI_ENCRYPTION_KEY"))
    this.ai_key_hint = typed.substring(typed.length - 4, typed.length)
    this.update()
    nil
  end

  def own_ai?
    !this.ai_key.blank?
  end

  def ai_provider_name
    AiClient.provider_name(this.ai_provider)
  end

  # The providers a key may be for, as the account page lists them.
  def ai_choices
    AI_PROVIDERS.keys.map do |id|
      {
        "id": id,
        "name": AI_PROVIDERS[id]["name"],
        "models": AI_PROVIDERS[id]["models"]
      }
    end
  end

  def forget_ai_key
    this.ai_provider = null
    this.ai_model = null
    this.ai_key = null
    this.ai_key_hint = null
    this.update()
  end

  # This person's own provider, model and key; nil without one. The site
  # has no key of its own to fall back on (#396); whether this one may be
  # used now is AiClient.refusal's.
  def ai_settings
    return nil unless @own_ai?

    {
      "provider": @ai_provider,
      "model": @ai_model,
      "key": Crypto.decrypt(@ai_key, getenv("SOLI_ENCRYPTION_KEY"))
    }
  end

  # Why the AI cannot run for them now (AiClient.refusal), or nil: for the
  # pages, which cannot reach AiClient.
  def ai_refusal(open = nil)
    AiClient.refusal(this, open)
  end

  # What the account's AI section says when the plan stands in the way
  # (payments open, not on Pro), or nil: a kept key stays kept, unused.
  def ai_plan_note(open = nil)
    return nil unless @ai_refusal(open) == "plan"

    pro_only = SiteText.t("app.account.ai_pro_only")
    return pro_only unless @own_ai?

    "#{pro_only} #{SiteText.t("app.account.ai_key_kept")}"
  end

  # --- Notification e-mails (#385) ---------------------------------------------

  # Whether `kind` (NOTIFICATION_KINDS) is e-mailed to them: each is, until
  # they turn it off. The app lists every notification either way.
  def mails?(kind)
    (@mail_prefs ?? {})[kind] != false
  end

  # The e-mails they want: the kinds in `wanted`, the others off.
  def keep_mail_prefs(wanted)
    chosen = wanted ?? []
    prefs = {}
    NOTIFICATION_KINDS.each do |kind|
      prefs[kind] = chosen.includes?(kind)
    end
    @mail_prefs = prefs
    @save
  end

  # Whether a push notification of `kind` (#400) goes to their devices:
  # every kind until they choose.
  def pushes?(kind)
    (@push_prefs ?? {})[kind] != false
  end

  # What the account page's Push section needs (#400), which a view cannot
  # ask WebPush or PushSubscription itself: the key a browser subscribes
  # with ("" while push is not set up here) and how many devices are on.
  def push_setup
    {"key": WebPush.public_key, "devices": PushSubscription.count_of(this)}
  end

  # The push notifications they want: the kinds in `wanted`, the others off.
  def keep_push_prefs(wanted)
    chosen = wanted ?? []
    prefs = {}
    NOTIFICATION_KINDS.each do |kind|
      prefs[kind] = chosen.includes?(kind)
    end
    @push_prefs = prefs
    @save
  end

  # --- The plan (#393) --------------------------------------------------------
  #
  # Set by Stripe's webhook only (Billing): `plan`, `plan_status`,
  # `current_period_end`, `cancel_at_period_end`, `stripe_customer_id`,
  # `stripe_subscription_id`. What each plan allows is Plan's.

  # Whether the account is on Pro now: a Pro subscription active or on
  # trial, whose period paid for has not ended.
  def pro?
    @pro_at?(DateTime.utc.to_unix)
  end

  def pro_at?(now)
    return false unless @plan == "pro"
    return false unless ["active", "trialing"].includes?(@plan_status.to_s)
    return false if @current_period_end.nil?

    @current_period_end.to_s.to_i > now
  end

  # --- What an admin may change (#399, /admin) ----------------------------------

  # Whether Pro is paid for through Stripe: a subscription the webhook set.
  def paying?
    @pro? && @plan_gift != true && @stripe_subscription_id.present?
  end

  # Pro offered for `days` from `now`: nil, or why not. An offer already
  # running is lengthened from its end; a paying account is left alone.
  def gift_pro(days, now)
    return "This account pays for Pro already: Stripe manages it." if @paying?
    return "An offer lasts from 1 to 3660 days." if days < 1 || days > 3660

    starts = @plan_gift == true && @pro_at?(now) ? @current_period_end.to_s.to_i : now
    @plan = "pro"
    @plan_status = "active"
    @plan_gift = true
    @cancel_at_period_end = false
    @current_period_end = starts + days * 86400
    @update()
    nil
  end

  # The offer of Pro ended now: back on Free. nil, or why not.
  def stop_gift
    return "This account has no offer of Pro." unless @plan_gift == true

    @plan = "free"
    @plan_status = "canceled"
    @plan_gift = false
    @current_period_end = nil
    @update()
    nil
  end

  # Signing in allowed again after too many wrong passwords.
  def unlock
    @locked_at = nil
    @failed_attempts = 0
    @update()
  end

  # The plan's name, as the account page shows it.
  def plan_name
    SiteText.t(@pro? ? "app.account.plan_pro" : "app.account.plan_free")
  end

  # What the account page says of the subscription at `now`, or nil on Free
  # with nothing to say.
  def plan_summary(now = nil)
    at = now ?? DateTime.utc.to_unix
    ends = @current_period_end.nil? ? "" : User.plan_date(@current_period_end.to_s.to_i)
    when_ends = {"date": ends}
    if @pro_at?(at)
      return SiteText.t("app.account.plan_offered", when_ends) if @plan_gift == true
      return SiteText.t("app.account.plan_ends", when_ends) if @cancel_at_period_end == true
      return SiteText.t("app.account.plan_trial", when_ends) if @plan_status == "trialing"

      return SiteText.t("app.account.plan_renews", when_ends)
    end

    return SiteText.t("app.account.plan_failed") if ["past_due", "unpaid"].includes?(@plan_status.to_s)
    return SiteText.t("app.account.plan_ended", when_ends) if @plan == "pro" && !ends.blank?

    nil
  end

  # `unix` as the account page writes a date, in the request's language:
  # "November 1, 2026", "1er novembre 2026".
  static def plan_date(unix)
    day = DateTime.from_unix(unix)
    number = day.format("%-d")
    number = SiteText.t("app.account.plan_first_day") if number == "1"
    SiteText.t(
      "app.account.plan_date",
      {
        "month": SiteText.t("date.months.m#{day.format("%m").to_i}"),
        "d": number,
        "year": day.format("%Y")
      }
    )
  end

  # Whether there is a Stripe customer to manage (Manage billing).
  def billed?
    @stripe_customer_id.present?
  end

  # What the account page offers (Plan, Stripe): the prices, and whether
  # payments are open. A page cannot reach those classes; it asks here.
  def plan_offer
    {
      "monthly": Plan.price("monthly"),
      "annual": Plan.price("annual"),
      "open": Stripe.configured?
    }
  end

  # The account gone, and all it left: its scores (trash, versions, shares
  # and the AI's suggestions included), what was shared with it, its photo
  # readings and the requests it made of the AI, its devices for push
  # notifications. A subscription is
  # cancelled first; if Stripe cannot be reached, that is logged and the
  # account goes all the same.
  def erase_account
    Billing.cancel_on_leaving(this)
    Score.delete_all_of(this)
    ScoreReading.delete_all_of(this)
    ScoreSuggestion.delete_all_of(this)
    UserNotification.delete_all_of(this)
    PushSubscription.delete_all_of(this)
    AccessToken.delete_all_of(this)
    @delete
  end

  # The time step `code` is for, one step either side of `now`, or nil.
  static def totp_step(secret, code, now)
    text = code.to_s.replace(" ", "")
    return nil unless Regex.matches("^[0-9]{6}$", text)

    here = now / 30
    [here - 1, here, here + 1].find do |step|
      Crypto.secure_compare(Crypto.totp_generate(secret, step * 30, 30), text)
    end
  end

  # A backup code, xxxxx-xxxxx.
  static def backup_code
    letters = Crypto.random_bytes(10).map do |b|
      TOTP_BACKUP_ALPHABET[b % TOTP_BACKUP_ALPHABET.length]
    end
    letters.slice(0, 5).join("") + "-" + letters.slice(5, 10).join("")
  end

  # A backup code as it is kept: lower case, without its dash or spaces.
  static def backup_digest_text(code)
    code.to_s.downcase().replace("-", "").replace(" ", "")
  end
end
