<section class="auth">
  <h1><%= t("auth.create_title") %></h1>
  <p class="muted"><%= t("auth.create_lead") %></p>
  <% if error.present? %>
    <p class="form-error" role="alert"><%= error %></p>
  <% end %>
  <form action="<%= lp(signup_path()) %>" method="POST" class="auth-form">
    <%- csrf_field() %>
    <%- pow_field(pow_bits) %>
    <label class="field"><%= t("auth.email") %>
      <input id="email" name="email" type="email" required autofocus autocomplete="email" value="<%= user.email.to_s %>">
    </label>
    <label class="field"><span><%= t("auth.password") %> <span class="muted">— <%= t("auth.twelve") %></span></span>
      <input id="password" name="password" type="password" required minlength="12" autocomplete="new-password">
    </label>
    <button type="submit" class="btn btn-primary"><%= t("auth.create_account") %></button>
  </form>
  <noscript><p class="form-error"><%= t("auth.needs_js") %></p></noscript>
  <p class="auth-alt"><%= t("auth.have_one") %> <a href="<%= lp(login_path()) %>"><%= t("auth.sign_in") %></a></p>
</section>
