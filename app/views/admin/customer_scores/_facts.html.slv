<%# A customer's score, read only (#626): what the admin pages show of it
    above its engraving — `customer`, `score`, and `read_page` (its read
    page's path, or nil). %>
<p class="admin-note" data-admin-read-only><%= t("admin_626.read_only") %></p>
<dl class="account-facts" data-admin-score-facts>
  <dt><%= t("admin_626.title") %></dt><dd data-admin-score-title><%= score.title %></dd>
  <% if score.composer.present? %><dt><%= t("admin_626.composer") %></dt><dd><%= score.composer %></dd><% end %>
  <dt><%= t("admin_626.owner") %></dt><dd><a href="<%= admin_customer_path(customer) %>"><%= customer.display_name %></a></dd>
  <dt><%= t("admin_626.visibility") %></dt><dd data-admin-visibility="<%= score.visibility ?? "private" %>"><%= t("admin_626.visibility_" + (score.visibility ?? "private")) %></dd>
  <dt><%= t("admin_626.updated") %></dt><dd><%= time_ago(score.updated_at) %></dd>
  <% unless score.trashed_at.nil? %>
    <dt><%= t("admin_626.trash") %></dt><dd><span class="admin-badge admin-badge-trouble" data-admin-trashed><%= t("admin_626.in_trash_since", {"when": time_ago(score.trashed_at)}) %></span></dd>
  <% end %>
  <% unless read_page.nil? %>
    <dt><%= t("admin_626.read_page") %></dt><dd><a href="<%= read_page %>" target="_blank" rel="noopener" data-admin-read-page><%= t("admin_626.open_read_page") %> ↗</a></dd>
  <% end %>
</dl>
