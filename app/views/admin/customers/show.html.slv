<section class="admin" data-admin="customer">
  <%- partial("admin/head", {"heading": customer.display_name, "current": "customers"}) %>

  <div class="admin-panels">
    <section class="admin-panel">
      <h2>Account</h2>
      <dl class="account-facts">
        <dt>Email</dt><dd><%= customer.email %></dd>
        <% if customer.name.present? %><dt>Name</dt><dd><%= customer.name %></dd><% end %>
        <dt>Signed up</dt><dd><%= admin_day(customer._created_at) %></dd>
        <dt>Address</dt><dd data-confirmed="<%= customer.confirmed?() %>"><%= customer.confirmed?() ? "Confirmed" : "Not confirmed" %></dd>
        <dt>Two-step</dt><dd><%= customer.two_step?() ? "On" : "Off" %></dd>
        <%# Which lock (#539): the account's, for every browser that never signed in to it, or some networks'. %>
        <% sources = customer.locked_sources() %>
        <% lock_text = "Locked from #{sources} networks: too many wrong passwords from each" %>
        <% lock_text = "Locked from 1 network: too many wrong passwords from it" if sources == 1 %>
        <% if customer.account_locked?() %>
          <% lock_text = "Locked for every browser that never signed in to it: too many wrong passwords from many networks" %>
        <% end %>
        <% lock_text = "Locked: too many wrong passwords" if !customer.locked_at.nil? %>
        <dt>Signing in</dt><dd data-locked="<%= customer.locked?() %>"><%= customer.locked?() ? lock_text : "Open" %></dd>
        <dt>Role</dt><dd><%= customer.admin?() ? "Admin" : "Member" %></dd>
        <dt>Own AI key</dt><dd><%= customer.ai_key.blank? ? "None" : "#{customer.ai_provider} · …#{customer.ai_key_hint}" %></dd>
        <dt>Scores</dt><dd><%= picture["score_count"] %></dd>
        <dt>Audio takes</dt><dd><%= (picture["take_bytes"] / 1000000).to_i %> MB</dd>
      </dl>
      <div class="admin-actions">
        <% if customer.locked?() %>
          <form action="<%= admin_customer_unlock_path(customer) %>" method="POST"><%- csrf_field() %><button type="submit" class="btn btn-ghost">Unlock signing in</button></form>
        <% end %>
        <% unless customer.confirmed?() %>
          <form action="<%= admin_customer_confirm_path(customer) %>" method="POST"><%- csrf_field() %><button type="submit" class="btn btn-ghost">Confirm the address</button></form>
        <% end %>
      </div>
    </section>

    <section class="admin-panel" id="plan">
      <h2>Plan</h2>
      <dl class="account-facts">
        <dt>Plan</dt><dd><%- partial("admin/badge", {"customer": customer}) %></dd>
        <% summary = customer.plan_summary() %>
        <% if summary.present? %><dt>Status</dt><dd><%= summary %></dd><% end %>
        <% if customer.plan_interval.present? %><dt>Paid</dt><dd><%= customer.plan_interval == "annual" ? "Yearly" : "Monthly" %></dd><% end %>
        <dt>Stripe</dt>
        <dd>
          <% if stripe_customer.nil? %>
            No Stripe customer
          <% else %>
            <a href="<%= stripe_customer %>" target="_blank" rel="noopener" data-stripe-customer><%= customer.stripe_customer_id %> ↗</a>
          <% end %>
        </dd>
      </dl>
      <div class="admin-actions">
        <% if customer.paying?() %>
          <p class="muted">Paid through Stripe: refunds, cancelling and the card are changed in Stripe's dashboard.</p>
        <% else %>
          <form action="<%= admin_customer_gift_path(customer) %>" method="POST" data-gift>
            <%- csrf_field() %>
            <select name="days" aria-label="For how long">
              <option value="30">30 days</option>
              <option value="90">3 months</option>
              <option value="365">1 year</option>
            </select>
            <button type="submit" class="btn btn-primary"><%= customer.plan_gift == true && customer.pro?() ? "Offer more Pro" : "Offer Pro" %></button>
          </form>
          <% if customer.plan_gift == true %>
            <form action="<%= admin_customer_stop_gift_path(customer) %>" method="POST" data-stop-gift><%- csrf_field() %><button type="submit" class="btn btn-danger">End the offer</button></form>
          <% end %>
        <% end %>
      </div>
    </section>
  </div>

  <section class="admin-panel">
    <h2>Invoices</h2>
    <% if invoices["error"].present? %>
      <p class="admin-note"><%= invoices["error"] %></p>
    <% elsif invoices["invoices"].length == 0 %>
      <p class="admin-empty">No invoice.</p>
    <% else %>
      <%- partial("admin/invoices", {"rows": invoices["invoices"], "accounts": {}}) %>
    <% end %>
  </section>

  <%# Their scores (#626), each opened read only; the latest changed first. %>
  <section class="admin-panel" id="scores">
    <h2><%= t("admin_626.scores") %></h2>
    <% if scores["scores"].length == 0 %>
      <p class="admin-empty"><%= t("admin_626.no_score") %></p>
    <% else %>
      <div class="table-scroll">
        <table class="ref-table admin-table" data-customer-scores>
          <thead><tr>
            <th><%= t("admin_626.title") %></th>
            <th><%= t("admin_626.updated") %></th>
            <th><%= t("admin_626.visibility") %></th>
            <th class="num"><%= t("admin_626.shared_with") %></th>
            <th class="num"><%= t("admin_626.versions") %></th>
            <th></th>
          </tr></thead>
          <tbody>
            <% for score in scores["scores"] %>
              <tr data-customer-score="<%= score._key %>">
                <td><a href="<%= admin_customer_score_path(customer._key, score._key) %>"><%= score.title %></a><% if score.composer.present? %> <span class="muted">— <%= score.composer %></span><% end %></td>
                <td><%= time_ago(score.updated_at) %></td>
                <td data-visibility="<%= score.visibility %>"><%= t("admin_626.visibility_" + (score.visibility ?? "private")) %></td>
                <td class="num"><%= scores["shares"][score._key] ?? 0 %></td>
                <td class="num"><%= scores["versions"][score._key] ?? 0 %></td>
                <td><% unless score.trashed_at.nil? %><span class="admin-badge admin-badge-trouble" data-trashed><%= t("admin_626.in_trash") %></span><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if scores_page > 1 || scores["more"] %>
        <nav class="admin-pager" aria-label="<%= t("admin_626.scores") %>">
          <% if scores_page > 1 %><a class="btn btn-ghost" href="<%= admin_customer_path(customer) %>?scores_page=<%= scores_page - 1 %>#scores"><%= t("admin_626.newer") %></a><% end %>
          <% if scores["more"] %><a class="btn btn-ghost" href="<%= admin_customer_path(customer) %>?scores_page=<%= scores_page + 1 %>#scores" data-more-scores><%= t("admin_626.more") %></a><% end %>
        </nav>
      <% end %>
    <% end %>
  </section>

  <section class="admin-panel">
    <h2><%= t("admin_626.shared_with_them") %></h2>
    <% if shared_with.length == 0 %>
      <p class="admin-empty"><%= t("admin_626.none_shared") %></p>
    <% else %>
      <ul data-shared-with-customer>
        <% for shared in shared_with %>
          <li>
            <a href="<%= admin_customer_score_path(shared["score"].user_id, shared["score"]._key) %>"><%= shared["score"].title %></a>
            <span class="muted">· <%= t("admin_626.owned_by", {"name": shared["owner"]}) %> · <%= t("admin_626.role_" + shared["role"].to_s) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="admin-panel" id="admin-actions">
    <h2>What the admins did</h2>
    <%- partial("admin/actions", {"actions": admin_actions, "names": {customer._key: customer.display_name}}) %>
  </section>

  <section class="admin-panel">
    <h2>Events from Stripe</h2>
    <%- partial("admin/events", {"events": picture["events"], "names": picture["names"]}) %>
  </section>
</section>
