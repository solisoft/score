<section class="auth">
  <h1>Reset your password</h1>
  <p class="muted">We send a link to the address of your account.</p>
  <% if notice.present? %>
    <p class="form-notice" role="status"><%= notice %></p>
  <% end %>
  <% if error.present? %>
    <p class="form-error" role="alert"><%= error %></p>
  <% end %>
  <form action="<%= password_reset_path() %>" method="POST" class="auth-form">
    <%- csrf_field() %>
    <label class="field">Email
      <input id="email" name="email" type="email" required autofocus autocomplete="email">
    </label>
    <button type="submit" class="btn btn-primary">Send the link</button>
  </form>
  <p class="auth-alt"><a href="<%= login_path() %>">Back to sign in</a></p>
</section>
