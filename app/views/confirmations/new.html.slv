<section class="auth">
  <h1><%= title %></h1>
  <% if notice.present? %>
    <p class="form-notice" role="status"><%= notice %></p>
  <% end %>
  <% if error.present? %>
    <p class="form-error" role="alert"><%= error %></p>
  <% end %>
  <form action="<%= lp(confirmation_resend_path()) %>" method="POST" class="auth-form">
    <%- csrf_field() %>
    <label class="field"><%= t("auth.email") %>
      <input id="email" name="email" type="email" required autocomplete="email" value="<%= locals["email"].to_s %>">
    </label>
    <button type="submit" class="btn btn-primary"><%= t("auth.send_confirmation") %></button>
  </form>
  <p class="auth-alt"><a href="<%= lp(login_path()) %>"><%= t("auth.sign_in") %></a></p>
</section>
