<%# An application asked to connect in a way that cannot go on (#461). %>
<section class="auth">
  <h1><%= title %></h1>
  <% if reason == "nothing_pending" %>
    <p>No application is waiting for your answer: start again from the application that asked to connect.</p>
  <% elsif reason == "unknown_client" %>
    <p>The application asking to connect is not one Score knows: start again from it.</p>
  <% else %>
    <p>The application asked to send its answer to an address it did not register: nothing is sent.</p>
  <% end %>
  <p><a href="<%= app_home_path() %>">Your scores</a></p>
</section>
