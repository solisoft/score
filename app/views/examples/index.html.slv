<div class="wrap">
  <header class="page-head">
    <span class="eyebrow"><%= t("examples.eyebrow") %></span>
    <h1><%= t("examples.title") %></h1>
    <p class="lead"><%= t("examples.lead") %></p>
    <nav class="pills" aria-label="<%= t("examples.families") %>" style="margin-top: 24px">
      <% for section in sections %>
        <a class="pill" href="#<%= section["slug"] %>"><%= section["title"] %></a>
      <% end %>
    </nav>
  </header>

  <% for section in sections %>
    <section class="gallery-section" id="<%= section["slug"] %>">
      <header>
        <h2><a href="<%= lp(example_category_path(section["slug"])) %>" style="color: inherit"><%= section["title"] %></a></h2>
        <p><%= section["lead"] %></p>
      </header>
      <div class="example-grid">
        <% for example in section["examples"] %>
          <%- partial("examples/card", {"example": example}) %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
