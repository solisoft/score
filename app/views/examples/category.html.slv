<div class="wrap">
  <header class="page-head">
    <nav class="breadcrumb" aria-label="<%= t("examples.breadcrumb") %>">
      <a href="<%= lp(examples_path()) %>"><%= t("examples.examples") %></a><span>/</span><span><%= category["title"] %></span>
    </nav>
    <h1><%= category["title"] %></h1>
    <p class="lead"><%= category["lead"] %></p>
    <nav class="pills" aria-label="<%= t("examples.families") %>" style="margin-top: 24px">
      <% for cat in categories %>
        <a class="pill" href="<%= lp(example_category_path(cat["slug"])) %>"<%- cat["slug"] == category["slug"] ? " aria-current=\"page\"" : "" %>><%= cat["title"] %></a>
      <% end %>
    </nav>
  </header>

  <div class="example-grid">
    <% for example in examples %>
      <%- partial("examples/card", {"example": example}) %>
    <% end %>
  </div>
</div>
