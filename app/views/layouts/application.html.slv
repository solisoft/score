<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#fbf9f4">
    <title><%= title %> · Score</title>

    <%# Share tags (Open Graph, Twitter card, canonical): every layout carries
        them. Actions set @title and @description; @og_image overrides the
        default image. See app/views/CLAUDE.md. %>
    <% share_description = description ?? "eui-score engraves LilyPond into paths, plays it as MIDI, prints it as PDF." %>
    <% current_path = req ? req["path"] : "/" %>
    <% share_url = absolute_url(current_path) %>
    <meta name="description" content="<%= share_description %>">
    <% if indexable == false %>
    <meta name="robots" content="noindex">
    <% end %>
    <link rel="canonical" href="<%= share_url %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Score">
    <meta property="og:title" content="<%= title %> · Score">
    <meta property="og:description" content="<%= share_description %>">
    <meta property="og:url" content="<%= share_url %>">
    <meta property="og:image" content="<%= absolute_url(og_image ?? "/images/og.png") %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="<%= public_path("images/favicon.svg") %>" type="image/svg+xml">

    <link rel="stylesheet" href="<%= public_path("css/application.css") %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Music&display=swap" rel="stylesheet">
</head>
<body>
    <%# The header leads with the app (#397): App, Pricing, Guide, Changelog;
        the engraver's own pages (Syntax, Examples, Embed, Limits) are under
        Guide and in the footer. An item is [label, path, the paths it covers]. %>
    <% app_path = app_open?() ? app_home_path() : playground_path() %>
    <% nav_items = [["App", app_path, [app_path]], ["Sections", sections_path(), [sections_path()]],
                    ["Pricing", pricing_path(), [pricing_path()]],
                    ["Guide", guide_path(), [guide_path(), syntax_path(), embed_path(), limits_path()]],
                    ["Changelog", changelog_path(), [changelog_path()]]] %>
    <header class="site-header">
        <div class="wrap">
            <a class="brand" href="<%= root_path() %>" aria-label="Score, home">
                <span class="brand-mark" aria-hidden="true">
                    <svg width="16" height="18" viewBox="0 0 16 18" fill="currentColor"><path d="M6 1.5 15 0v12.2a2.8 2.3 0 1 1-1.6-2.1V3.4L7.6 4.3v9.9A2.8 2.3 0 1 1 6 12.1Z"/></svg>
                </span>
                <span><em>Score</em></span>
            </a>
            <nav class="site-nav" aria-label="Main navigation">
                <% for item in nav_items %>
                    <% here = item[2].includes?(current_path) || current_path.starts_with?(item[1] + "/") %>
                    <a href="<%= item[1] %>"<%- here ? " aria-current=\"page\"" : "" %>><%= item[0] %></a>
                <% end %>
            </nav>
            <%# Outside the links' row: on a phone it stays beside the brand while the links wrap below. %>
            <div class="nav-account">
                <% if !app_open?() %>
                    <a class="nav-cta" href="<%= playground_path() %>">Playground</a>
                <% elsif signed_in?() %>
                    <a class="nav-cta" href="<%= app_home_path() %>">Open the app</a>
                <% else %>
                    <a class="nav-signin" href="<%= login_path() %>">Sign in</a>
                    <a class="nav-cta" href="<%= signup_path() %>">Start free</a>
                <% end %>
            </div>
        </div>
    </header>

    <main>
        <%= yield %>
    </main>

    <footer class="site-footer">
        <div class="wrap">
            <nav class="footer-nav" aria-label="The site">
                <a href="<%= app_path %>">App</a>
                <a href="<%= playground_path() %>">Playground</a>
                <a href="<%= pricing_path() %>">Pricing</a>
                <a href="<%= changelog_path() %>">Changelog</a>
                <a href="<%= guide_path() %>">Guide</a>
                <a href="<%= syntax_path() %>">Syntax</a>
                <a href="<%= examples_path() %>">Examples</a>
                <a href="<%= embed_path() %>">Embed</a>
                <a href="<%= limits_path() %>">Limits</a>
            </nav>
            <p>
                <strong>Score</strong> writes, plays and shares scores in the browser. Its engraver,
                <strong>eui-score</strong>, is the engraver of <a href="https://eui.solisoft.net">EUI</a>: the
                LilyPond subset it reads is engraved into paths, played as MIDI and printed as PDF. Every score on
                this site is engraved on the fly by it — on the server, or in your browser.
            </p>
            <p>
                Music glyphs: Emmentaler (OFL). Score text: TeX Gyre Schola (GUST Font License).
                Sounds: <a href="/soundfonts/MuseScore_General_License.txt">MuseScore_General</a> (MIT), played by
                <a href="https://github.com/spessasus/spessasynth_lib">SpessaSynth</a> (Apache 2.0).
                Built with <a href="https://solisoft.net">Soli</a>.
            </p>
        </div>
    </footer>

    <script defer src="<%= public_path("js/score.js") %>" data-player="<%= public_path("eui-score/player.js") %>"
      data-engine="<%= public_path("eui-score/eui-score.js") %>" data-model="<%= public_path("eui-score/score-model.js") %>" data-feel="<%= public_path("eui-score/feel.js") %>" data-velocity="<%= public_path("eui-score/velocity.js") %>"
      data-musicxml="<%= public_path("eui-score/musicxml.js") %>"></script>
</body>
</html>
