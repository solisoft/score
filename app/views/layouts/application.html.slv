<!DOCTYPE html>
<html lang="<%= I18n.locale() %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#fbf9f4">
    <title><%= title %> · Score</title>

    <%# Share tags (Open Graph, Twitter card, canonical): every layout carries
        them. Actions set @title and @description; @og_image overrides the
        default image. See app/views/CLAUDE.md. %>
    <% share_description = description ?? "eui-score engraves LilyPond into paths, plays it as MIDI, prints it as PDF." %>
    <% current_path = req ? req["path"] : "/" %>
    <% share_url = absolute_url(current_path) %>
    <meta name="description" content="<%= share_description %>">
    <% if indexable == false %>
    <meta name="robots" content="noindex">
    <% end %>
    <link rel="canonical" href="<%= share_url %>">
    <%# The page in each language (#471): what a search engine shows to whom. %>
    <% other_path = other_language_path(current_path) %>
    <% unless other_path.nil? %>
    <% english_path = I18n.locale() == "fr" ? other_path : current_path %>
    <link rel="alternate" hreflang="en" href="<%= absolute_url(english_path) %>">
    <link rel="alternate" hreflang="fr" href="<%= absolute_url(I18n.locale() == "fr" ? current_path : other_path) %>">
    <link rel="alternate" hreflang="x-default" href="<%= absolute_url(english_path) %>">
    <% end %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Score">
    <meta property="og:title" content="<%= title %> · Score">
    <meta property="og:description" content="<%= share_description %>">
    <meta property="og:url" content="<%= share_url %>">
    <meta property="og:image" content="<%= absolute_url(og_image ?? "/images/og.png") %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="<%= public_path("images/favicon.svg") %>" type="image/svg+xml">

    <link rel="stylesheet" href="<%= public_path("css/application.css") %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Music&display=swap" rel="stylesheet">
</head>
<body>
    <%# The header leads with the app (#397): App, Pricing, Guide, Changelog;
        the engraver's own pages (Syntax, Examples, Embed, Limits) are under
        Guide and in the footer. An item is [label, path, the paths it covers]. %>
    <% app_path = app_open?() ? app_home_path() : playground_path() %>
    <% nav_items = [[t("nav.app"), app_path, [app_path]], [t("nav.sections"), sections_path(), [sections_path()]],
                    [t("nav.pricing"), lp(pricing_path()), [lp(pricing_path())]],
                    [t("nav.guide"), lp(guide_path()),
                     [lp(guide_path()), lp(syntax_path()), lp(embed_path()), lp(limits_path()), lp(claude_path())]],
                    [t("nav.changelog"), lp(changelog_path()), [lp(changelog_path())]]] %>
    <header class="site-header">
        <div class="wrap">
            <a class="brand" href="<%= lp(root_path()) %>" aria-label="<%= t("nav.home_label") %>">
                <span class="brand-mark" aria-hidden="true">
                    <svg width="16" height="18" viewBox="0 0 16 18" fill="currentColor"><path d="M6 1.5 15 0v12.2a2.8 2.3 0 1 1-1.6-2.1V3.4L7.6 4.3v9.9A2.8 2.3 0 1 1 6 12.1Z"/></svg>
                </span>
                <span><em>Score</em></span>
            </a>
            <nav class="site-nav" aria-label="<%= t("nav.main_label") %>">
                <% for item in nav_items %>
                    <% here = item[2].includes?(current_path) || current_path.starts_with?(item[1] + "/") %>
                    <a href="<%= item[1] %>"<%- here ? " aria-current=\"page\"" : "" %>><%= item[0] %></a>
                <% end %>
            </nav>
            <%# Outside the links' row: on a phone it stays beside the brand while the links wrap below. %>
            <div class="nav-account">
                <% unless other_path.nil? %>
                    <a class="nav-lang" data-no-nav href="<%= other_path %>" hreflang="<%= I18n.locale() == "fr" ? "en" : "fr" %>" lang="<%= I18n.locale() == "fr" ? "en" : "fr" %>" title="<%= t("nav.other_language") %>"><%= I18n.locale() == "fr" ? "EN" : "FR" %></a>
                <% end %>
                <% if !app_open?() %>
                    <a class="nav-cta" href="<%= playground_path() %>"><%= t("nav.playground") %></a>
                <% elsif signed_in?() %>
                    <a class="nav-cta" href="<%= app_home_path() %>"><%= t("nav.open_app") %></a>
                <% else %>
                    <a class="nav-signin" href="<%= lp(login_path()) %>"><%= t("nav.sign_in") %></a>
                    <a class="nav-cta" href="<%= lp(signup_path()) %>"><%= t("nav.start_free") %></a>
                <% end %>
            </div>
        </div>
    </header>

    <main>
        <%= yield %>
    </main>

    <footer class="site-footer">
        <div class="wrap">
            <nav class="footer-nav" aria-label="<%= t("footer.label") %>">
                <a href="<%= app_path %>"><%= t("nav.app") %></a>
                <a href="<%= playground_path() %>"><%= t("nav.playground") %></a>
                <a href="<%= lp(pricing_path()) %>"><%= t("nav.pricing") %></a>
                <a href="<%= lp(changelog_path()) %>"><%= t("nav.changelog") %></a>
                <a href="<%= lp(guide_path()) %>"><%= t("nav.guide") %></a>
                <a href="<%= lp(syntax_path()) %>"><%= t("nav.syntax") %></a>
                <a href="<%= lp(examples_path()) %>"><%= t("nav.examples") %></a>
                <a href="<%= lp(embed_path()) %>"><%= t("nav.embed") %></a>
                <a href="<%= lp(limits_path()) %>"><%= t("nav.limits") %></a>
                <a href="<%= lp(claude_path()) %>"><%= t("nav.claude") %></a>
            </nav>
            <p><%- t("footer.about") %></p>
            <p><%- t("footer.credits") %></p>
        </div>
    </footer>

    <script defer src="<%= public_path("js/score.js") %>" data-player="<%= eui_module_path("player.js") %>"
      data-engine="<%= eui_module_path("eui-score.js") %>" data-heard="<%= eui_module_path("heard.js") %>"
      data-musicxml="<%= eui_module_path("musicxml.js") %>"></script>
</body>
</html>
