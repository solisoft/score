<!DOCTYPE html>
<html lang="<%= I18n.locale() %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#fbf9f4">
    <title><%= title %> · Score</title>

    <%# Share tags (Open Graph, Twitter card, canonical), as on the site's
        layout. Actions set @title and @description. %>
    <% share_description = description ?? t("app.layout.description") %>
    <% current_path = req ? req["path"] : "/app" %>
    <% share_url = absolute_url(current_path) %>
    <meta name="description" content="<%= share_description %>">
    <link rel="canonical" href="<%= share_url %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Score">
    <meta property="og:title" content="<%= title %> · Score">
    <meta property="og:description" content="<%= share_description %>">
    <meta property="og:url" content="<%= share_url %>">
    <meta property="og:image" content="<%= absolute_url(og_image ?? "/images/og.png") %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="<%= public_path("images/favicon.svg") %>" type="image/svg+xml">

    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="apple-touch-icon" href="/images/app/icon-192.png">
    <link rel="stylesheet" href="<%= public_path("css/application.css") %>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Music&display=swap" rel="stylesheet">
</head>
<body class="app-body">
    <header class="app-header">
        <a class="brand" href="<%= app_home_path() %>" aria-label="<%= t("app.layout.home_label") %>">
            <span class="brand-mark" aria-hidden="true">
                <svg width="16" height="18" viewBox="0 0 16 18" fill="currentColor"><path d="M6 1.5 15 0v12.2a2.8 2.3 0 1 1-1.6-2.1V3.4L7.6 4.3v9.9A2.8 2.3 0 1 1 6 12.1Z"/></svg>
            </span>
            <span><em>Score</em></span>
        </a>
        <% if editing_score %>
            <div class="app-doc">
                <span class="app-doc-title" data-doc-title><%= editing_score.title %></span>
                <span class="app-save" data-save-state data-kind="ok" role="status" aria-live="polite"><%= t("app.layout.saved") %></span>
                <span class="app-room" data-room hidden aria-live="polite"></span>
                <%# The score's actions: in the header on a wide screen; on a
                    narrower one, under Score ▾ (#427), where the header has no room. %>
                <button type="button" class="app-doc-action app-doc-more" popovertarget="app-doc-actions" aria-label="<%= t("app.layout.score_actions") %>"><%= t("app.layout.score_menu") %></button>
                <div class="app-doc-actions" id="app-doc-actions" popover>
                    <button type="button" class="app-doc-action" data-keep-version><%= t("app.layout.keep_version") %></button>
                    <a class="app-doc-action" href="<%= app_score_versions_path(editing_score) %>"><%= t("app.layout.history") %></a>
                    <button type="button" class="app-doc-action" data-comments-toggle aria-expanded="false"><%= t("app.layout.comments") %> <span class="app-comments-count" data-comments-count></span></button>
                    <% if owner %>
                        <a class="app-doc-action" href="<%= app_score_share_path(editing_score) %>"><%= t("app.layout.share") %></a>
                    <% end %>
                </div>
            </div>
        <% end %>
        <nav class="app-nav" aria-label="<%= t("app.layout.nav_label") %>">
            <a href="<%= lp(root_path()) %>"><%= t("app_nav.site") %></a>
            <% if signed_in?() %>
                <a href="<%= app_scores_path() %>"<%- current_path.starts_with?("/app/scores") || current_path == app_trash_path() ? " aria-current=\"page\"" : "" %>><%= t("app.layout.your_scores") %></a>
                <a href="<%= app_account_path() %>"<%- current_path == app_account_path() ? " aria-current=\"page\"" : "" %>><%= t("app.layout.account") %></a>
                <% if current_user().admin?() %>
                    <a href="<%= admin_path() %>" data-admin-link<%- current_path.starts_with?("/admin") ? " aria-current=\"page\"" : "" %>><%= t("app.layout.admin") %></a>
                <% end %>
                <%# The bell (#385): how many notifications are unread, asked
                    for by the page (below), so every screen shows it. %>
                <a class="app-bell" href="<%= app_notifications_path() %>" data-bell aria-label="<%= t("app.layout.notifications") %>"<%- current_path == app_notifications_path() ? " aria-current=\"page\"" : "" %>>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                    <span class="app-bell-count" data-bell-count hidden></span>
                </a>
            <% else %>
                <a href="<%= lp(login_path()) %>"<%- current_path == lp(login_path()) ? " aria-current=\"page\"" : "" %>><%= t("auth.sign_in") %></a>
                <a class="app-nav-cta" href="<%= lp(signup_path()) %>"><%= t("auth.create_account") %></a>
                <% other_path = other_language_path(current_path) %>
                <% unless other_path.nil? %>
                    <a class="nav-lang" data-no-nav href="<%= other_path %>" hreflang="<%= I18n.locale() == "fr" ? "en" : "fr" %>" lang="<%= I18n.locale() == "fr" ? "en" : "fr" %>" title="<%= t("nav.other_language") %>"><%= I18n.locale() == "fr" ? "EN" : "FR" %></a>
                <% end %>
            <% end %>
        </nav>
    </header>

    <main class="app-main">
        <% for message in flashes() %>
            <p class="app-flash" role="status"><%= message["message"] %></p>
        <% end %>
        <%= yield %>
    </main>
    <% if signed_in?() %>
    <%# The bell's words and address, beside its script: an inline script's
        text never changes, its hash is in the Content-Security-Policy (#544). %>
    <% bell_words = {"none": t("app.layout.notifications"), "one": t("app.layout.unread_one")} %>
    <% bell_words["other"] = t("app.layout.unread_other") %>
    <%- page_data("bell-data", {"words": bell_words, "unread": app_notifications_unread_path()}) %>
    <script data-bell-script>
      // The bell's count, asked for on every page; the editor asks again
      // when a comment comes in (window.euiBell).
      ({ words: window.euiBellWords, unread: window.euiBellUnread } = JSON.parse(document.getElementById("bell-data").textContent));
      window.euiBell = async () => {
        const count = document.querySelector("[data-bell-count]");
        if (!count) return;
        try {
          const answer = await (await fetch(window.euiBellUnread, { headers: { Accept: "application/json" } })).json();
          count.textContent = answer.count > 99 ? "99+" : String(answer.count);
          count.hidden = !answer.count;
          count.closest("[data-bell]").setAttribute("aria-label", answer.count ? window.euiBellWords[answer.count === 1 ? "one" : "other"].replace("{count}", answer.count) : window.euiBellWords.none);
        } catch (error) {}
      };
      window.euiBell();
    </script>
    <% end %>
    <%# Installable, and open without a network: public/sw.js. %>
    <%# Score ▾ (#427): its menu opens under it, and an action chosen closes it (but Keep a version, which answers on itself). %>
    <script>
      if (!window.euiDocMore) {
        window.euiDocMore = true;
        document.addEventListener("beforetoggle", (event) => {
          const menu = event.target;
          if (!menu.matches?.(".app-doc-actions") || event.newState !== "open") return;
          const at = document.querySelector(".app-doc-more")?.getBoundingClientRect();
          if (at) menu.style.left = `${Math.round(Math.max(8, Math.min(at.left, innerWidth - 228)))}px`;
        }, true);
        document.addEventListener("click", (event) => {
          const menu = event.target.closest?.(".app-doc-actions:popover-open");
          // Keep a version says "Version kept" on itself: the menu stays open to show it.
          if (menu && event.target.closest(".app-doc-action") && !event.target.closest("[data-keep-version]")) menu.hidePopover();
        });
      }
    </script>
    <script>
      if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js", { scope: "/" }).catch(() => {});
    </script>
    <%# Just signed out, or the account deleted (a "signed_out" flash): the
        computer may be shared, so the app's pages kept for offline use and
        the editor's unsent text go. %>
    <% signed_out = false %>
    <% for message in flashes() %>
      <% signed_out = true if message["type"] == "signed_out" %>
    <% end %>
    <% if signed_out %>
    <script data-signed-out>
      (() => {
        try {
          for (let i = localStorage.length - 1; i >= 0; i--) {
            const key = localStorage.key(i);
            if (key && key.startsWith("eui-score-pending:")) localStorage.removeItem(key);
          }
        } catch (error) {}
        navigator.serviceWorker?.controller?.postMessage({ type: "signed-out" });
        if (!window.caches) return;
        caches.keys()
          .then((names) => Promise.all(names.filter((name) => name.startsWith("eui-score-pages")).map((name) => caches.delete(name))))
          .catch(() => {});
      })();
    </script>
    <% end %>
</body>
</html>
