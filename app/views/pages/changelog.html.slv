<div class="wrap-narrow">
  <header class="page-head">
    <span class="eyebrow">Changelog</span>
    <h1>What is new</h1>
    <p class="lead">
      The latest changes, newest first: to this site and its score editor, and to the engraver that draws every
      score on it.
    </p>
    <p class="changelog-legend">
      <span class="change-tag change-tag-site">Site &amp; editor</span>
      <span class="change-tag change-tag-engine">Engraver</span>
    </p>
  </header>

  <div class="changelog">
    <% for day in days %>
      <section class="changelog-day" id="<%= day["date"] %>">
        <h2><time datetime="<%= day["date"] %>"><%= day["heading"] %></time></h2>
        <ul class="changelog-entries">
          <% for entry in day["entries"] %>
            <li class="changelog-entry">
              <span class="change-tag change-tag-<%= entry["area"] %>"><%= entry["label"] %></span>
              <h3><%= entry["title"] %></h3>
              <p><%= entry["text"] %></p>
              <% unless entry["sample"].nil? %>
                <figure class="changelog-sample">
                  <eui-score staff-space="6"><script type="text/x-lilypond"><%- entry["sample"] %></script></eui-score>
                  <details class="score-source">
                    <summary>LilyPond source</summary>
                    <div class="score-code">
                      <button type="button" class="score-copy" data-score-copy>Copy</button>
                      <pre><code><%- score_highlight(entry["sample"]) %></code></pre>
                    </div>
                  </details>
                </figure>
              <% end %>
              <% unless entry["href"].nil? %>
                <a class="changelog-try" href="<%= entry["href"] %>">Try it →</a>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
<script type="module" src="<%= public_path("eui-score/eui-score.js") %>"></script>
