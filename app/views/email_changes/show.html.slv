<section class="auth">
  <h1><%= title %></h1>
  <% if state == "ready" %>
    <p><%- t("email_change.ready", {"email": h(new_email)}) %></p>
    <p class="muted"><%= t("security_539.email_change_disconnects") %></p>
    <form action="<%= lp(confirm_email_change_path()) %>" method="POST" class="auth-form">
      <%- csrf_field() %>
      <input type="hidden" name="token" value="<%= token %>">
      <button type="submit" class="btn btn-primary"><%= t("email_change.use", {"email": new_email}) %></button>
    </form>
  <% end %>
  <% if state == "changed" %>
    <p class="form-notice" role="status"><%- t("email_change.changed", {"email": h(new_email)}) %></p>
    <% if stays_signed_in %>
      <p><%= t("email_change.still_signed_in") %></p>
      <p class="auth-alt"><a href="<%= app_account_path() %>"><%= t("email_change.back_account") %></a></p>
    <% else %>
      <p><%= t("email_change.signed_out") %></p>
      <p class="auth-alt"><a href="<%= lp(login_path()) %>"><%= t("auth.sign_in") %></a></p>
    <% end %>
  <% end %>
  <% if state == "done" %>
    <p class="form-notice" role="status"><%- t("email_change.done", {"email": h(new_email)}) %></p>
    <p class="auth-alt"><a href="<%= lp(login_path()) %>"><%= t("auth.sign_in") %></a></p>
  <% end %>
  <% if state == "expired" %>
    <p class="form-error" role="alert"><%= t("email_change.expired") %></p>
    <p class="auth-alt"><a href="<%= app_account_path() %>"><%= t("email_change.your_account") %></a></p>
  <% end %>
  <% if state == "taken" %>
    <p class="form-error" role="alert"><%= t("email_change.taken", {"email": new_email}) %></p>
    <p class="auth-alt"><a href="<%= app_account_path() %>"><%= t("email_change.your_account") %></a></p>
  <% end %>
  <% if state == "busy" %>
    <p class="form-error" role="alert"><%= t("email_change.busy") %></p>
  <% end %>
  <% if state == "unknown" %>
    <p class="form-error" role="alert"><%= t("email_change.unknown") %></p>
    <p class="auth-alt"><a href="<%= app_account_path() %>"><%= t("email_change.your_account") %></a></p>
  <% end %>
</section>
