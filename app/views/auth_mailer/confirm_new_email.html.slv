<%# The words of the e-mail in the language of the request that sent it (#471); the addresses escaped: they go in as HTML. %>
<% words = {"email": h(user.email), "new_email": h(locals["new_email"].to_s)} %>
<% words = words.merge({"hours": locals["hours"].to_s, "minutes": locals["lock_minutes"].to_s}) %>
<div style="font-family: sans-serif; max-width: 480px; margin: 0 auto; padding: 24px;">
  <h1 style="font-size: 20px;"><%- t("mail.confirm_new_email.title", words) %></h1>
  <p><%- t("mail.confirm_new_email.body", words) %></p>
  <p style="margin: 24px 0;">
    <a href="<%= confirm_url %>"
       style="background: #4f46e5; color: #fff; padding: 10px 18px; border-radius: 6px; text-decoration: none;">
      <%- t("mail.confirm_new_email.button", words) %>
    </a>
  </p>
  <p style="color: #666; font-size: 13px;">
    <%- t("mail.confirm_new_email.footer", words) %>
  </p>
</div>
