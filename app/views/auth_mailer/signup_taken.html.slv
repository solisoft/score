<%# Someone tried to sign up with an address that has an account (#539), in the language of the sign-up page; the address escaped: it goes in as HTML. %>
<% words = {"email": h(user.email)} %>
<div style="font-family: sans-serif; max-width: 480px; margin: 0 auto; padding: 24px;">
  <h1 style="font-size: 20px;"><%- t("security_539.signup_taken.title", words) %></h1>
  <p><%- t("security_539.signup_taken.body", words) %></p>
  <p style="margin: 24px 0;">
    <a href="<%= login_url %>"
       style="background: #4f46e5; color: #fff; padding: 10px 18px; border-radius: 6px; text-decoration: none;">
      <%- t("security_539.signup_taken.sign_in", words) %>
    </a>
  </p>
  <p>
    <%- t("security_539.signup_taken.forgot", words) %>
    <a href="<%= reset_url %>"><%- t("security_539.signup_taken.reset", words) %></a>
  </p>
  <p style="color: #666; font-size: 13px;">
    <%- t("security_539.signup_taken.footer", words) %>
  </p>
</div>
