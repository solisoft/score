<%# One photo's reading (#465): followed live, the score growing as the AI
    writes it (#462); kept as a score, or tried again. %>
<section class="start import-page" data-import-page="<%= reading._key %>" data-state="<%= reading.state %>">
  <p class="breadcrumb"><a href="<%= app_imports_path() %>"><%= t("app.readings.imports_title") %></a></p>
  <h1 data-import-title><%= reading.title %></h1>
  <% for message in flashes() %>
    <p class="form-error" role="alert"><%= message["message"] %></p>
  <% end %>
  <div class="photo-reading-pair">
    <figure>
      <% if reading.picture.present? %>
        <img src="data:image/jpeg;base64,<%= reading.picture %>" alt="<%= t("app.readings.photo") %>">
      <% else %>
        <div class="callout"><%= t("app.readings.photo_gone") %></div>
      <% end %>
      <figcaption class="muted"><%= t("app.readings.photo") %></figcaption>
    </figure>
    <figure>
      <div class="photo-reading-score" data-import-score>
        <% unless figure.nil? %><%- figure["svg"] %><% end %>
      </div>
      <pre class="photo-reading-draft" data-import-draft aria-live="off" hidden></pre>
      <figcaption class="muted" data-import-status aria-live="polite">
        <% if reading.state == "done" %><%= t("app.readings.done_caption") %><% end %>
        <% if reading.state == "failed" %><%= reading.shown_error %><% end %>
        <% if reading.state == "reading" %><%= t("app.readings.reading_caption") %><% end %>
      </figcaption>
    </figure>
  </div>
  <div class="import-actions">
    <form action="<%= app_import_score_path(reading._key) %>" method="POST" data-import-keep<%= reading.state == "done" ? "" : " hidden" %>>
      <%- csrf_field() %>
      <button type="submit" class="btn btn-primary"><%= t("app.readings.open_as_score") %></button>
    </form>
    <% if reading.picture.present? %>
      <form action="<%= app_import_retry_path(reading._key) %>" method="POST" data-import-retry<%= reading.state == "reading" ? " hidden" : "" %>>
        <%- csrf_field() %>
        <button type="submit" class="btn btn-ghost"><%= t("app.readings.read_again") %></button>
      </form>
    <% end %>
  </div>
</section>
<% if reading.state == "reading" %>
  <script type="module">
    // Followed live (#462): the news every few seconds, the music written so far engraved.
    const page = document.querySelector("[data-import-page]");
    const status = page.querySelector("[data-import-status]");
    const score = page.querySelector("[data-import-score]");
    const draft = page.querySelector("[data-import-draft]");
    const { took } = await import("/js/score-photo.js?v=<%= eui_version %>");
    // What the page says of the reading going on, in the app's language (#505):
    // score-photo.js's readingSays, its words from the locale files.
    <% words = {"writing": t("app.readings.says_writing"), "thinking": t("app.readings.says_thinking")} %>
    <% words["thoughtOne"] = t("app.readings.says_thought_one") %>
    <% words["thoughtOther"] = t("app.readings.says_thought_other") %>
    <% words["waiting"] = t("app.readings.says_waiting") %>
    <% words["numbers"] = t("app.readings.number_locale") %>
    const words = <%- words.to_json %>;
    const readingSays = (news) => {
      const time = took(news?.seconds);
      const thought = Number(news?.thought) || 0;
      let said = words.waiting;
      if (news?.phase === "writing") said = words.writing;
      else if (news?.phase === "thinking" && thought > 0) said = thought === 1 ? words.thoughtOne : words.thoughtOther;
      else if (news?.phase === "thinking") said = words.thinking;
      return said.replace("{time}", time).replace("{chars}", thought.toLocaleString(words.numbers));
    };
    const at = "<%= app_reading_path(reading._key) %>";
    let events = null;
    let wake = () => {};
    try {
      events = new EventSource(at + "/events");
      events.addEventListener("progress", (event) => {
        try {
          status.textContent = readingSays(JSON.parse(event.data));
        } catch (error) {}
      });
      events.addEventListener("done", () => wake());
    } catch (error) {}
    // The page left (instant navigation swaps it): stop asking.
    while (page.isConnected) {
      await Promise.race([new Promise((done) => setTimeout(done, 3000)), new Promise((done) => (wake = done))]);
      if (!page.isConnected) break;
      let reading;
      try {
        reading = await (await fetch(at + "?svg=1", { headers: { Accept: "application/json" } })).json();
      } catch (error) {
        continue;
      }
      if (reading.state !== "reading") {
        // Read, or not: the page as it now stands.
        events?.close();
        location.reload();
        break;
      }
      status.textContent = readingSays(reading);
      if (reading.draft_svg) {
        score.innerHTML = reading.draft_svg;
        draft.hidden = true;
      } else if (reading.draft) {
        draft.hidden = false;
        draft.textContent = reading.draft;
        draft.scrollTop = draft.scrollHeight;
      }
    }
    events?.close();
  </script>
<% end %>
