<%# The photo imports (#465): the photos read, being read or not read. %>
<section class="start imports">
  <h1>Photo imports</h1>
  <p class="muted">The photos of scores you had read, the latest first. One being read goes on when you leave its
    page: come back here to follow it. Photos are kept a week, imports a month.</p>
  <% for message in flashes() %>
    <p class="form-notice" role="status"><%= message["message"] %></p>
  <% end %>
  <% if readings.length == 0 %>
    <div class="callout" data-no-import>No photo read yet. On <a href="<%= app_home_path() %>">Start</a>, choose
      From a photo.</div>
  <% else %>
    <ul class="import-list" data-imports>
      <% for reading in readings %>
        <li class="import-item import-<%= reading.state %>" data-import="<%= reading._key %>">
          <a href="<%= app_import_path(reading._key) %>">
            <strong><%= reading.title %></strong>
            <span class="muted">
              <% if reading.state == "reading" %>
                being read: <%= reading.phase == "writing" ? "the music is being written" : "the AI is thinking" %>, started <%= time_ago(reading.created_at) %>
              <% elsif reading.state == "done" %>
                read <%= time_ago(reading.finished_at ?? reading.created_at) %>
              <% else %>
                not read: <%= reading.error %>
              <% end %>
            </span>
          </a>
          <span class="import-state"><%= {"reading": "Being read", "done": "Read", "failed": "Not read"}[reading.state] ?? reading.state %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
