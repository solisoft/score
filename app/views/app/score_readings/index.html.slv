<%# The photo imports (#465): the photos read, being read or not read. %>
<section class="start imports">
  <h1><%= t("app.readings.imports_title") %></h1>
  <p class="muted"><%= t("app.readings.imports_lead") %></p>
  <% for message in flashes() %>
    <p class="form-notice" role="status"><%= message["message"] %></p>
  <% end %>
  <% if readings.length == 0 %>
    <div class="callout" data-no-import><%- t("app.readings.no_import_html", {"start": h(app_home_path())}) %></div>
  <% else %>
    <ul class="import-list" data-imports>
      <% for reading in readings %>
        <li class="import-item import-<%= reading.state %>" data-import="<%= reading._key %>">
          <a href="<%= app_import_path(reading._key) %>">
            <strong><%= reading.title %></strong>
            <span class="muted">
              <% if reading.state == "reading" %>
                <% being_read = reading.phase == "writing" ? "being_read_writing" : "being_read_thinking" %>
                <%= t("app.readings." + being_read, {"when": time_ago(reading.created_at)}) %>
              <% elsif reading.state == "done" %>
                <%= t("app.readings.read_when", {"when": time_ago(reading.finished_at ?? reading.created_at)}) %>
              <% else %>
                <%= t("app.readings.not_read", {"error": reading.shown_error}) %>
              <% end %>
            </span>
          </a>
          <span class="import-state"><%= ["reading", "done", "failed"].includes?(reading.state) ? t("app.readings.state_" + reading.state) : reading.state %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
