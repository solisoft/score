<%# The consent page of an MCP client asking to connect (#461). %>
<section class="auth" data-oauth-consent>
  <h1><%= t("app.oauth.heading", {"name": client_name}) %></h1>
  <p><%- t("app.oauth.asks_html", {"name": h(client_name), "email": h(email)}) %></p>
  <ul class="oauth-can">
    <li><%= t("app.oauth.can_list") %></li>
    <li><%= t("app.oauth.can_change") %></li>
    <li><%= t("app.oauth.can_transcribe") %></li>
  </ul>
  <p class="muted"><%- t("app.oauth.goes_back_html", {"host": h(redirect_host)}) %></p>
  <form action="<%= app_oauth_consent_path() %>" method="POST" class="oauth-decide">
    <%- csrf_field() %>
    <button type="submit" name="decision" value="allow" class="btn btn-primary" data-oauth-allow><%= t("app.oauth.allow") %></button>
    <button type="submit" name="decision" value="deny" class="btn btn-ghost" data-oauth-deny><%= t("app.oauth.deny") %></button>
  </form>
</section>
