<section class="auth auth-wide">
  <h1>Your account</h1>
  <% if error.present? %>
    <p class="form-error" role="alert"><%= error %></p>
  <% end %>
  <dl class="account-facts">
    <dt>Email</dt><dd><%= user.email %></dd>
    <dt>Address</dt>
    <dd>
      <% if user.confirmed?() %>
        <span class="account-confirmed">Confirmed</span>
      <% else %>
        <span class="account-unconfirmed">Not confirmed yet</span>
        <form action="<%= confirmation_resend_path() %>" method="POST" class="account-resend">
          <%- csrf_field() %>
          <input type="hidden" name="email" value="<%= user.email %>">
          <button type="submit" class="btn btn-ghost">Send the link again</button>
        </form>
      <% end %>
    </dd>
  </dl>

  <h2>Two-step sign-in</h2>
  <% if user.two_step?() %>
    <p>On: signing in asks for a code from your authenticator app as well as your password.
      <span class="muted"><%= user.backup_codes_left() %> backup codes left.</span></p>
    <form action="<%= app_account_two_step_stop_path() %>" method="POST" class="auth-form">
      <%- csrf_field() %>
      <label class="field">Your password
        <input id="stop_password" name="password" type="password" required autocomplete="current-password">
      </label>
      <label class="field">A code from the app, or a backup code
        <input id="stop_code" name="code" type="text" required autocomplete="one-time-code" maxlength="12" spellcheck="false">
      </label>
      <button type="submit" class="btn btn-ghost">Turn two-step sign-in off</button>
    </form>
  <% elsif user.can_use_two_step?() %>
    <p class="muted">Off. Turned on, signing in asks for a six-digit code from an authenticator app on your phone
      (Google Authenticator, 1Password, Authy…) as well as your password.</p>
    <form action="<%= app_account_two_step_path() %>" method="POST">
      <%- csrf_field() %>
      <button type="submit" class="btn btn-primary">Turn two-step sign-in on</button>
    </form>
  <% else %>
    <p class="muted">Not available on this server yet.</p>
  <% end %>

  <h2 id="ai">AI for reading photos</h2>
  <% if user.own_ai?() %>
    <p>Photos of scores are read with <strong><%= user.ai_provider_name() %></strong>, model
      <code><%= user.ai_model %></code>, with your key ending in <code>…<%= user.ai_key_hint %></code>.</p>
    <form action="<%= app_account_ai_remove_path() %>" method="POST">
      <%- csrf_field() %>
      <button type="submit" class="btn btn-ghost">Remove the key</button>
    </form>
    <p class="muted">Or use another one:</p>
  <% else %>
    <p class="muted">Photos of scores are read by an AI model. Bring a key of your own from one of these providers
      to read them with the model you choose: the site keeps it encrypted, uses it only to read your photos, and
      never shows it again.</p>
  <% end %>
  <% if locals["ai_error"].present? %>
    <p class="form-error" role="alert"><%= locals["ai_error"] %></p>
  <% end %>
  <form action="<%= app_account_ai_path() %>" method="POST" class="auth-form" data-ai-form>
    <%- csrf_field() %>
    <label class="field">Provider
      <select name="provider" data-ai-provider>
        <% for provider in user.ai_choices() %>
          <option value="<%= provider["id"] %>" data-models="<%= provider["models"].join(",") %>"<%= provider["id"] == (user.ai_provider ?? "anthropic") ? " selected" : "" %>><%= provider["name"] %></option>
        <% end %>
      </select>
    </label>
    <label class="field"><span>Model <span class="muted">— one that reads images</span></span>
      <input name="model" type="text" required list="ai-models" value="<%= user.ai_model ?? "" %>" spellcheck="false" autocomplete="off" data-ai-model>
      <datalist id="ai-models" data-ai-models></datalist>
    </label>
    <label class="field">API key
      <input name="key" type="password" required autocomplete="off" spellcheck="false" placeholder="Paste the key from the provider's site">
    </label>
    <button type="submit" class="btn btn-primary">Keep the key</button>
  </form>
  <script>
    (() => {
      const select = document.querySelector("[data-ai-provider]");
      const model = document.querySelector("[data-ai-model]");
      const list = document.querySelector("[data-ai-models]");
      const suggest = (fill) => {
        const models = select.selectedOptions[0].dataset.models.split(",");
        list.replaceChildren(...models.map((id) => Object.assign(document.createElement("option"), { value: id })));
        if (fill) model.value = models[0];
      };
      suggest(!model.value);
      select.addEventListener("change", () => suggest(true));
    })();
  </script>

  <h2>Change your password</h2>
  <form action="<%= app_account_password_path() %>" method="POST" class="auth-form">
    <%- csrf_field() %>
    <label class="field">Current password
      <input id="current_password" name="current_password" type="password" required autocomplete="current-password">
    </label>
    <label class="field"><span>New password <span class="muted">— 12 characters or more</span></span>
      <input id="new_password" name="password" type="password" required minlength="12" autocomplete="new-password">
    </label>
    <label class="field">The same again
      <input id="password_confirmation" name="password_confirmation" type="password" required minlength="12" autocomplete="new-password">
    </label>
    <button type="submit" class="btn btn-primary">Change the password</button>
  </form>

  <h2>Sign out</h2>
  <%- button_to("Sign out", logout_path(), {"method": "delete", "class": "btn btn-ghost"}) %>

  <h2>Delete the account</h2>
  <p class="muted">Your account and every score in it are deleted for good.</p>
  <form action="<%= app_account_path() %>" method="POST" class="auth-form">
    <%- csrf_field() %>
    <input type="hidden" name="_method" value="DELETE">
    <label class="field">Your password, to confirm
      <input id="delete_password" name="password" type="password" required autocomplete="current-password">
    </label>
    <button type="submit" class="btn btn-danger">Delete my account</button>
  </form>
</section>
