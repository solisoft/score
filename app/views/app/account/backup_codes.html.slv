<section class="auth auth-wide">
  <h1><%- t("app.account.backup_heading") %></h1>
  <p><%- t("app.account.backup_lead") %></p>
  <ul class="two-step-codes">
    <% for code in codes %>
      <li><code><%= code %></code></li>
    <% end %>
  </ul>
  <p><a class="btn btn-primary" href="<%= app_account_path() %>"><%- t("app.account.done") %></a></p>
</section>
