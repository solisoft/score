<section class="library">
  <header class="library-head">
    <h1><%= version.title %> <span class="muted">— <%= time_ago(version.created_at) %></span></h1>
    <div class="version-actions">
      <a class="btn btn-ghost" href="<%= app_score_versions_path(score) %>"><%= t("app.scores.version.all") %></a>
      <form action="<%= app_score_copy_version_path(score._key, version._key) %>" method="POST">
        <%- csrf_field() %>
        <button type="submit" class="btn btn-ghost"><%= t("app.scores.version.make_copy") %></button>
      </form>
      <% if can_restore %>
        <form action="<%= app_score_restore_version_path(score._key, version._key) %>" method="POST">
          <%- csrf_field() %>
          <button type="submit" class="btn btn-primary"><%= t("app.scores.version.restore") %></button>
        </form>
      <% end %>
    </div>
  </header>
  <%# Engraved, with Play and MIDI: the version's own source through the
      read page's player (public/js/score.js, loaded once per tab). %>
  <%- score_figure(figure, {"name": file_name, "source": "closed"}) %>
</section>
<script defer src="<%= public_path("js/score.js") %>" data-player="<%= public_path("eui-score/player.js") %>"
  data-engine="<%= public_path("eui-score/eui-score.js") %>" data-heard="<%= public_path("eui-score/heard.js") %>"
  data-musicxml="<%= public_path("eui-score/musicxml.js") %>"></script>
