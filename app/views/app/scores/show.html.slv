<%- partial("shared/studio", {"examples": examples, "figure": figure, "source": source, "app": true}) %>

<%# File › New, Open a file, Open an example and Open a photo make a new
    score in the library and open it: the score open here stays as it is. %>
<form action="<%= app_scores_path() %>" method="POST" data-open-form hidden>
  <%- csrf_field() %>
  <input type="hidden" name="source" data-open-source>
</form>

<%# The AI assistant (AI menu): what to ask, then the explanation beside the
    proposed score, to apply or discard. %>
<dialog class="studio-keys studio-parts studio-ai" data-ai aria-labelledby="studio-ai-title">
  <form method="dialog" data-ai-form>
    <div class="studio-keys-head">
      <h2 id="studio-ai-title" data-ai-title>AI</h2>
      <button type="button" class="studio-menu" data-ai-close aria-label="Close">×</button>
    </div>
    <p class="muted studio-parts-note" data-ai-about></p>
    <textarea class="studio-ai-request" data-ai-request rows="3"></textarea>
    <p class="muted studio-parts-note" data-ai-with><%= ai_with %></p>
    <p class="studio-parts-note" data-ai-status hidden></p>
    <p class="form-error" data-ai-error hidden></p>
    <div class="studio-ai-result" data-ai-result hidden>
      <div class="studio-ai-explanation" data-ai-explanation></div>
      <div class="studio-parts-preview" data-ai-preview></div>
    </div>
    <div class="studio-ai-actions">
      <button type="submit" class="btn btn-primary" data-ai-send>Ask</button>
      <button type="button" class="btn btn-primary" data-ai-apply hidden>Apply to the score</button>
      <button type="button" class="btn btn-ghost" data-ai-again hidden>Ask again</button>
    </div>
  </form>
</dialog>

<%# The score saves itself: 1.5 s after the last change, a PUT of its source
    over the revision it was opened at. The header says where it stands.
    A 409 — saved from another window since — is never overwritten: the
    server keeps the text refused here as a version, and this page offers
    the score as it now stands.
    Offline, each change is also kept in this browser (localStorage, with
    the revision it was typed over) until a save goes through: a page
    closed before then gives it back the next time it opens, and sends it. %>
<script type="module">
  const { startStudio } = await import("/eui-score/studio.js?v=<%= eui_version %>");
  const root = document.getElementById("studio");
  const url = "<%= app_score_path(score) %>";
  const saveState = document.querySelector("[data-save-state]");
  const titleBox = document.querySelector("[data-doc-title]");
  let revision = <%= score.revision %>;
  let pending = null;
  let saving = false;
  let conflict = false;
  let timer = 0;
  // This editor, for the room: its own saves come back to it, and are skipped.
  const origin = crypto.randomUUID?.() ?? String(Math.random()).slice(2);
  let applyingRemote = false;
  const keepKey = "eui-score-pending:<%= score._key %>";

  const keepLocally = (text) => {
    try {
      localStorage.setItem(keepKey, JSON.stringify({ text, revision }));
    } catch (error) {}
  };
  const forgetLocally = () => {
    try {
      localStorage.removeItem(keepKey);
    } catch (error) {}
  };

  const show = (text, kind) => {
    saveState.textContent = text;
    saveState.dataset.kind = kind;
  };

  async function save() {
    if (saving || conflict || pending == null) return;
    const text = pending;
    pending = null;
    saving = true;
    show("Saving…", "busy");
    try {
      const response = await fetch(url, {
        method: "PUT",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ source: text, revision, origin }),
      });
      const answer = await response.json();
      if (response.status === 409) {
        conflict = true;
        show("Changed in another window", "conflict");
        if (confirm("This score was saved from another window since you opened it. Open that version here? What you typed is kept in the score's history.")) {
          revision = answer.revision;
          conflict = false;
          studio.load(answer.source, "The score as it was saved elsewhere.");
          pending = null;
          forgetLocally();
          show("Saved", "ok");
        }
      } else if (!response.ok) {
        show(answer.error ? `Not saved: ${answer.error}` : "Not saved", "conflict");
      } else {
        revision = answer.revision;
        if (pending == null) forgetLocally();
        else keepLocally(pending);
        titleBox.textContent = answer.title;
        document.title = `${answer.title} · EUI Score`;
        show(pending == null ? "Saved" : "Unsaved changes", pending == null ? "ok" : "dirty");
      }
    } catch (error) {
      pending ??= text;
      show("Offline — saving when back", "offline");
      setTimeout(save, 5000);
    } finally {
      saving = false;
      if (pending != null && !conflict) schedule();
    }
  }

  function schedule() {
    clearTimeout(timer);
    timer = setTimeout(save, 1500);
  }

  const studio = startStudio(root, {
    examples: "<%= examples_path() %>",
    shareUrl: <%- owner ? "\"" + app_score_share_path(score) + "\"" : "null" %>,
    source: root.querySelector("[data-source]").value,
    greeting: "Click a note to select it, or press N and type A–G to write. Your changes save themselves.",
    onChange(text) {
      if (conflict || applyingRemote) return;
      pending = text;
      keepLocally(text);
      show("Unsaved changes", "dirty");
      schedule();
    },
    onOpen: openAsNew,
  });

  // What New / Open bring becomes a score of its own, once this one's last
  // change is saved.
  async function openAsNew(text) {
    clearTimeout(timer);
    await save();
    const form = document.querySelector("[data-open-form]");
    form.querySelector("[data-open-source]").value = text;
    show("Opening as a new score…", "busy");
    form.submit();
  }

  window.addEventListener("online", save);

  // The score's room: who else has it open, and their saves as they happen.
  // A save from elsewhere is applied here only while this editor has no
  // change of its own on the way; otherwise this editor's next save meets
  // the conflict rule above, and nothing is lost either way.
  const roomBox = document.querySelector("[data-room]");
  const me = "<%= current_user()._key %>";
  let people = {};
  const showPeople = () => {
    const others = Object.entries(people).filter(([id]) => id !== me).map(([, p]) => p.metas[0].name);
    roomBox.hidden = others.length === 0;
    roomBox.textContent = others.length ? `With ${others.join(", ")}` : "";
    roomBox.title = others.length ? `Also editing: ${others.join(", ")}` : "";
  };
  // Each (re)connect asks for a fresh ticket (they last an hour): once the
  // score is no longer shared with this person, or is in the trash, none
  // comes, and the editor stops trying.
  let roomDelay = 3000;
  async function joinRoom() {
    let ticket;
    try {
      const answer = await fetch("<%= app_score_room_ticket_path(editing_score) %>", {
        headers: { Accept: "application/json" },
        credentials: "same-origin",
      });
      if ([401, 403, 404].includes(answer.status) || answer.redirected) {
        people = {};
        showPeople();
        return;
      }
      if (!answer.ok) throw new Error(`ticket: ${answer.status}`);
      ticket = (await answer.json()).ticket;
    } catch (error) {
      setTimeout(joinRoom, roomDelay);
      return;
    }
    const scheme = location.protocol === "https:" ? "wss:" : "ws:";
    const socket = new WebSocket(`${scheme}//${location.host}/ws/scores?ticket=${encodeURIComponent(ticket)}`);
    socket.onopen = () => (roomDelay = 3000);
    socket.onmessage = (message) => {
      let data;
      try {
        data = JSON.parse(message.data);
      } catch (error) {
        return;
      }
      if (data.event === "refused") {
        // Turned away at the door: ask again, later, for a fresh ticket.
        roomDelay = Math.min(roomDelay * 2, 60000);
        socket.close();
      } else if (data.event === "presence_state") {
        people = data.payload;
        showPeople();
      } else if (data.event === "presence_diff") {
        Object.entries(data.payload.joins ?? {}).forEach(([id, p]) => (people[id] = p));
        Object.keys(data.payload.leaves ?? {}).forEach((id) => delete people[id]);
        showPeople();
      } else if (data.event === "saved" && data.origin !== origin && data.revision > revision) {
        if (pending != null || saving || conflict) {
          show("Changed in another window", "conflict");
          return;
        }
        revision = data.revision;
        applyingRemote = true;
        try {
          studio.load(data.source, "Updated: someone else saved this score.");
        } finally {
          applyingRemote = false;
        }
        forgetLocally();
        titleBox.textContent = data.title;
        show("Saved", "ok");
      }
    };
    socket.onclose = () => {
      people = {};
      showPeople();
      setTimeout(joinRoom, roomDelay);
    };
  }
  joinRoom();

  // Changes kept in this browser by a visit that could not save them.
  let kept = null;
  try {
    kept = JSON.parse(localStorage.getItem(keepKey) || "null");
  } catch (error) {}
  if (kept?.text) {
    studio.ready.then(() => {
      if (kept.text === studio.source()) return forgetLocally();
      revision = kept.revision;
      studio.load(kept.text, "Your changes made without a network are back, and being saved.");
    });
  }
  window.addEventListener("beforeunload", (event) => {
    if (pending != null || saving) event.preventDefault();
  });
  document.querySelector("[data-keep-version]").addEventListener("click", async (event) => {
    await save();
    const response = await fetch(`${url}/versions`, { method: "POST", headers: { Accept: "application/json" } });
    event.target.textContent = response.ok ? "Version kept" : "Not kept";
    setTimeout(() => (event.target.textContent = "Keep a version"), 2500);
  });

  // File › Open a photo…: read by the server's or the person's AI; what was
  // read opens as a new score.
  document.querySelector("[data-photo-open]")?.addEventListener("change", async (event) => {
    const file = event.target.files[0];
    event.target.closest("details")?.removeAttribute("open");
    if (!file) return;
    const { readPhoto } = await import("/js/score-photo.js?v=<%= eui_version %>");
    show("Reading the photo… a minute or two", "busy");
    try {
      const answer = await readPhoto(file, { readings: "<%= app_readings_path() %>" });
      await openAsNew(answer.source);
    } catch (problem) {
      show("Photo not read", "conflict");
      alert(problem.message);
    } finally {
      event.target.value = "";
    }
  });

  // The AI menu: the editor's text sent with what to ask, the suggestion asked
  // after until it is ready, shown, and applied only on "Apply" (the score as
  // it stands kept as a version first; Undo takes it back too).
  const ai = document.querySelector("[data-ai]");
  const aiPart = (name) => ai.querySelector(`[data-ai-${name}]`);
  const AI_ASKS = {
    chords: ["Chord progression", "Chord symbols for the melody, above it. Say a style if you like: jazz, pop, baroque, modal…", "Optional: a style, an era, how rich the chords should be"],
    harmonize: ["Harmonize the melody", "An accompaniment under the melody, for piano unless you name other voices or instruments.", "Optional: for SATB choir, for string quartet, simple chords on the beat…"],
    improve: ["Suggest improvements", "What the AI would change (voice leading, rhythm, dynamics, phrasing…), with the score revised.", "Optional: what to look at first"],
    ask: ["Ask the AI", "Anything to do with this score.", "Make the bass line more mobile; transpose it for clarinet in B♭; add a coda…"],
  };
  let aiAction = "chords";
  let aiAnswer = null;
  const aiReset = () => {
    aiAnswer = null;
    for (const name of ["status", "error", "result", "apply", "again"]) aiPart(name).hidden = true;
    aiPart("send").hidden = false;
    aiPart("send").disabled = false;
    aiPart("request").disabled = false;
  };
  document.querySelectorAll("[data-ai-ask]").forEach((button) => button.addEventListener("click", () => {
    button.closest("details")?.removeAttribute("open");
    aiAction = button.dataset.aiAsk;
    const [title, about, hint] = AI_ASKS[aiAction];
    aiPart("title").textContent = title;
    aiPart("about").textContent = about;
    aiPart("request").placeholder = hint;
    aiPart("request").value = "";
    aiReset();
    ai.showModal();
    aiPart("request").focus();
  }));
  aiPart("close").addEventListener("click", () => ai.close());
  aiPart("again").addEventListener("click", aiReset);
  aiPart("form").addEventListener("submit", async (event) => {
    event.preventDefault();
    const fail = (message) => {
      aiPart("status").hidden = true;
      aiPart("error").textContent = message;
      aiPart("error").hidden = false;
      aiPart("send").disabled = false;
      aiPart("request").disabled = false;
    };
    aiPart("error").hidden = true;
    aiPart("send").disabled = true;
    aiPart("request").disabled = true;
    aiPart("status").textContent = "The AI is working on it… a minute or two.";
    aiPart("status").hidden = false;
    try {
      const sent = await fetch("<%= app_score_suggestions_path(score) %>", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ action: aiAction, request: aiPart("request").value, source: studio.source() }),
      });
      const started = await sent.json();
      if (sent.status !== 202) return fail(started.error);
      // Five minutes, then the page stops waiting.
      for (let tries = 0; tries < 100; tries++) {
        await new Promise((done) => setTimeout(done, 3000));
        if (!ai.open) return;
        const answer = await (await fetch("<%= app_suggestion_path("ID") %>".replace("ID", started.id), { headers: { Accept: "application/json" } })).json();
        if (answer.state === "working") continue;
        if (answer.state === "failed") return fail(answer.error);
        aiAnswer = answer;
        aiPart("status").hidden = true;
        aiPart("explanation").textContent = answer.explanation || "Here is the score the AI proposes.";
        aiPart("preview").innerHTML = answer.svg;
        aiPart("result").hidden = false;
        aiPart("send").hidden = true;
        aiPart("apply").hidden = aiPart("again").hidden = false;
        return;
      }
      fail("No answer after five minutes. Try again in a moment.");
    } catch (problem) {
      fail("The request could not be sent. Check your connection and try again.");
    }
  });
  aiPart("apply").addEventListener("click", async () => {
    if (!aiAnswer) return;
    await save();
    await fetch(`${url}/versions`, { method: "POST", headers: { Accept: "application/json" } });
    studio.load(aiAnswer.source, `${AI_ASKS[aiAction][0]}: applied. Undo, or the History, takes it back.`);
    ai.close();
  });
</script>
