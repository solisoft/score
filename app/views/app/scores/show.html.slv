<%- partial("shared/studio", {"examples": examples, "figure": figure, "source": source, "app": true, "owner": owner, "ai_link": ai_link}) %>

<%# Comments on the score's bars (#385): the panel the editor's script
    fills (public/eui-score/comments.js), beside the score. %>
<aside class="studio-comments" data-comments-panel hidden aria-label="Comments">
  <div class="studio-comments-head">
    <h2>Comments</h2>
    <button type="button" class="studio-menu" data-comments-close aria-label="Close the comments">×</button>
  </div>
  <div class="studio-comments-body" data-comments></div>
</aside>

<%# File › New, Open a file, Open an example and Open a photo make a new
    score in the library and open it: the score open here stays as it is.
    The conflict dialog's "Save mine as a copy" posts it too. %>
<form action="<%= app_scores_path() %>" method="POST" data-open-form hidden>
  <%- csrf_field() %>
  <input type="hidden" name="source" data-open-source>
</form>

<%# The AI assistant (AI menu): what to ask, then the explanation beside the
    proposed score, to apply or discard. Without a usable AI key (#396,
    data-ai-refused) it says why and links the way to one, and sends nothing. %>
<dialog class="studio-keys studio-parts studio-ai" data-ai aria-labelledby="studio-ai-title"<%= ai_link ? " data-ai-refused" : "" %>>
  <form method="dialog" data-ai-form>
    <div class="studio-keys-head">
      <h2 id="studio-ai-title" data-ai-title>AI</h2>
      <button type="button" class="studio-menu" data-ai-close aria-label="Close">×</button>
    </div>
    <p class="muted studio-parts-note" data-ai-about></p>
    <textarea class="studio-ai-request" data-ai-request rows="3" maxlength="<%= ai_request_limit %>"></textarea>
    <p class="muted studio-parts-note" data-ai-with><%= ai_with %><% unless ai_left.nil? %> <span data-ai-left><%= ai_left %></span> questions left today.<% end %><% if ai_link %> <a href="<%= ai_link["href"] %>"><%= ai_link["text"] %></a><% end %></p>
    <p class="studio-parts-note" data-ai-status hidden></p>
    <p class="form-error" data-ai-error hidden></p>
    <div class="studio-ai-result" data-ai-result hidden>
      <div class="studio-ai-explanation" data-ai-explanation></div>
      <div class="studio-parts-preview" data-ai-preview></div>
    </div>
    <div class="studio-ai-actions">
      <button type="submit" class="btn btn-primary" data-ai-send>Ask</button>
      <button type="button" class="btn btn-primary" data-ai-apply hidden>Apply to the score</button>
      <button type="button" class="btn btn-ghost" data-ai-again hidden>Ask again</button>
    </div>
  </form>
</dialog>

<%# A save refused because the score was saved elsewhere since: what to do
    with the text typed here. Until one is chosen nothing is sent, the text
    stays kept in this browser and leaving the page asks first. %>
<dialog class="studio-keys studio-conflict" data-conflict aria-labelledby="studio-conflict-title">
  <div class="studio-keys-head">
    <h2 id="studio-conflict-title">Changed elsewhere</h2>
    <button type="button" class="studio-menu" data-conflict-close aria-label="Close">×</button>
  </div>
  <%# Who saved it: the 409 names them ("saved_by"), or nobody when it was
      this person, from another window. %>
  <p class="studio-parts-note"><span data-conflict-who>This score was saved from another window</span> since you opened it. Your changes are not lost: they are kept here and in the score's history.</p>
  <%# The bars changed both here and there (#384): everything else is merged,
      and these are taken from one side or the other. Hidden when the score
      could not be merged by bar: then it is all mine or all theirs. %>
  <div data-conflict-merge hidden>
    <p class="studio-parts-note">Everything else is merged. These were changed both here and there:</p>
    <ul class="studio-conflict-bars" data-conflict-bars></ul>
  </div>
  <div class="studio-conflict-actions">
    <button type="button" class="tool tool-wide tool-primary" data-conflict-bars-mine hidden>Keep mine for these <small>their other changes merged in</small></button>
    <button type="button" class="tool tool-wide" data-conflict-bars-theirs hidden>Take theirs for these <small>my other changes kept</small></button>
    <button type="button" class="tool tool-wide tool-primary" data-conflict-mine>Keep mine <small>replace what was saved elsewhere</small></button>
    <button type="button" class="tool tool-wide" data-conflict-theirs>Load theirs <small>drop my changes here</small></button>
    <button type="button" class="tool tool-wide" data-conflict-copy>Save mine as a copy <small>a new score, this one left as saved elsewhere</small></button>
  </div>
</dialog>

<%# The score saves itself: 1.5 s after the last change, a PUT of its source
    over the revision it was opened at. The header says where it stands.
    A 409 — saved from another window since — is never overwritten: the
    server keeps the text refused here as a version, and this page offers
    the score as it now stands: keep mine, load theirs, or save mine as a
    copy (the dialog above).
    Signed out (401) or no longer allowed (403), saving stops until the page
    is reloaded, and says so; the text stays kept here.
    Offline, each change is also kept in this browser (localStorage, with
    the revision it was typed over) until a save goes through: a page
    closed before then gives it back the next time it opens, and sends it.
    Two people at once (#384): a save from elsewhere, met while this editor
    has changes of its own (live from the room, or as a 409), is merged with
    them bar by bar (public/eui-score/merge.js) from `base`, the text both
    last had in common, and the merge is saved. Only the bars changed both
    ways are asked about; a score that cannot be merged by bar gets the
    all-or-nothing choice above. %>
<script type="module">
  const { startStudio } = await import("/eui-score/studio.js?v=<%= eui_version %>");
  const { mergeScores, conflictLines, anchorMap } = await import("/eui-score/merge.js?v=<%= eui_version %>");
  const { startComments, markersOf } = await import("/eui-score/comments.js?v=<%= eui_version %>");
  const root = document.getElementById("studio");
  const url = "<%= app_score_path(score) %>";
  const saveState = document.querySelector("[data-save-state]");
  const titleBox = document.querySelector("[data-doc-title]");
  let revision = <%= score.revision %>;
  // The text at `revision`, as this editor and the server both have it: what a merge starts from.
  let base = root.querySelector("[data-source]").value;
  let pending = null;
  let saving = false;
  let conflict = false;
  let timer = 0;
  // This editor, for the room: its own saves come back to it, and are skipped.
  const origin = crypto.randomUUID?.() ?? String(Math.random()).slice(2);
  let applyingRemote = false;
  // The bars put in or taken away here since `base` (#392), in order; null
  // once an Undo or a Redo makes them not the whole story. Sent with each
  // save as where `base`'s bars went (merge.js, anchorMap): the comments
  // on them follow.
  let barOps = [];
  const keepKey = "eui-score-pending:<%= score._key %>";

  const keepLocally = (text) => {
    try {
      localStorage.setItem(keepKey, JSON.stringify({ text, revision }));
    } catch (error) {}
  };
  const forgetLocally = () => {
    try {
      localStorage.removeItem(keepKey);
    } catch (error) {}
  };

  const show = (text, kind) => {
    saveState.textContent = text;
    saveState.dataset.kind = kind;
  };

  // Signed out (401, or the sign-in page instead of JSON) or no longer
  // allowed to change the score (403): nothing more is sent until the page
  // is reloaded; the text stays kept in this browser, and is sent from there.
  let stopped = false;
  const stop = (forbidden) => {
    stopped = true;
    clearTimeout(timer);
    if (forbidden) {
      show("Not saved: you may no longer change this score (your changes are kept here)", "conflict");
      return;
    }
    saveState.textContent = "Signed out: ";
    const signIn = document.createElement("a");
    signIn.href = `/login?return_to=${encodeURIComponent(location.pathname)}`;
    signIn.textContent = "sign in again";
    signIn.dataset.signIn = "";
    // The text is kept here: leaving for the sign-in page loses nothing.
    signIn.addEventListener("click", () => (stopped = "leaving"));
    saveState.append(signIn, " to save (your changes are kept here)");
    saveState.dataset.kind = "signed-out";
  };

  // The conflict dialog: the save was refused because the score was saved
  // elsewhere since. `theirs` is the score as it now stands.
  const conflictBox = document.querySelector("[data-conflict]");
  let theirs = null;
  const conflictWho = conflictBox.querySelector("[data-conflict-who]");
  const conflictPart = (name) => conflictBox.querySelector(`[data-conflict-${name}]`);

  // This editor's text merged with `answer` (the score as saved elsewhere),
  // from `base`: { text, conflicts, whole }; `prefer` settles the bars
  // changed both ways. Without a base (a text kept from an older visit), no merge.
  const mergeWith = (answer, prefer = null) => {
    if (base == null) return { text: null, conflicts: [], whole: true };
    return mergeScores(base, studio.source(), answer.source, { parse: studio.parse, prefer });
  };

  // The merge put in place of this editor's text, its selection kept, and
  // sent: the score is now `answer`'s revision plus what was merged in.
  // Said in the header once the merge is saved: "Saved, merged with …".
  let mergeNote = null;
  const applyMerged = (text, answer, message, note = null) => {
    mergeNote = note;
    revision = answer.revision;
    base = answer.source;
    titleBox.textContent = answer.title;
    if (text !== studio.source()) {
      applyingRemote = true;
      try {
        studio.load(text, message, { keep: true, remote: true });
      } finally {
        applyingRemote = false;
      }
    } else if (message) root.querySelector("[data-status]").textContent = message;
    if (text === answer.source) {
      pending = null;
      forgetLocally();
      show(mergeNote ? `Saved, ${mergeNote}` : "Saved", "ok");
      mergeNote = null;
      return;
    }
    pending = text;
    keepLocally(pending);
    save();
  };

  const openConflict = () => {
    const by = theirs?.saved_by ? shortName(theirs.saved_by) : null;
    conflictWho.textContent = by ? `${by} saved this score` : "This score was saved from another window";
    show(by ? `Changed by ${by}: choose what to keep` : "Changed elsewhere: choose what to keep", "conflict");
    // What the merge leaves to choose: some bars, or (not mergeable by bar) the whole score.
    const merged = mergeWith(theirs);
    const byBar = !merged.whole && merged.conflicts.length > 0;
    conflictPart("merge").hidden = !byBar;
    for (const name of ["bars-mine", "bars-theirs"]) conflictPart(name).hidden = !byBar;
    for (const name of ["mine", "theirs"]) conflictPart(name).hidden = byBar;
    conflictPart("bars").replaceChildren(...(byBar ? conflictLines(merged.conflicts) : []).map((line) => Object.assign(document.createElement("li"), { textContent: line })));
    if (!conflictBox.open) conflictBox.showModal();
  };
  const resolve = () => {
    conflict = false;
    theirs = null;
    conflictBox.close();
  };

  // Met with the score as saved elsewhere (`answer`), this editor having
  // changes of its own: merged and saved when no bar was changed both ways;
  // else the conflict dialog. Answers whether it merged.
  const meet = (answer, by) => {
    const merged = mergeWith(answer);
    if (merged.text == null) return false;
    const note = by ? `merged with ${shortName(by)}'s changes` : "merged with your other window";
    applyMerged(merged.text, answer, by ? `Merged with ${shortName(by)}'s changes.` : "Merged with the changes from your other window.", note);
    return true;
  };
  conflictBox.querySelector("[data-conflict-close]").addEventListener("click", () => conflictBox.close());
  saveState.addEventListener("click", () => conflict && openConflict());
  for (const prefer of ["mine", "theirs"]) {
    conflictPart(`bars-${prefer}`).addEventListener("click", () => {
      const answer = theirs;
      const merged = mergeWith(answer, prefer);
      if (merged.text == null) return openConflict();
      resolve();
      applyMerged(merged.text, answer, prefer === "mine" ? "Merged: your version of those bars kept." : "Merged: their version of those bars taken.");
    });
  }
  conflictBox.querySelector("[data-conflict-mine]").addEventListener("click", () => {
    revision = theirs.revision;
    base = theirs.source;
    // Mine over theirs, which may have moved bars too: lined up by content.
    barOps = null;
    resolve();
    pending = studio.source();
    keepLocally(pending);
    save();
  });
  conflictBox.querySelector("[data-conflict-theirs]").addEventListener("click", () => {
    const answer = theirs;
    resolve();
    revision = answer.revision;
    base = answer.source;
    applyingRemote = true;
    try {
      studio.load(answer.source, "The score as it was saved elsewhere. Your changes are in its history.");
    } finally {
      applyingRemote = false;
    }
    pending = null;
    forgetLocally();
    titleBox.textContent = answer.title;
    show("Saved", "ok");
  });
  conflictBox.querySelector("[data-conflict-copy]").addEventListener("click", () => {
    const form = document.querySelector("[data-open-form]");
    form.querySelector("[data-open-source]").value = studio.source();
    resolve();
    pending = null;
    stopped = "leaving";
    forgetLocally();
    show("Saving a copy…", "busy");
    form.submit();
  });

  async function save() {
    if (saving || conflict || stopped || pending == null) return;
    const text = pending;
    pending = null;
    saving = true;
    show("Saving…", "busy");
    const sentOps = barOps;
    barOps = [];
    let anchors = null;
    try {
      anchors = anchorMap(base, text, { parse: studio.parse, ops: sentOps ?? [] });
    } catch (error) {}
    let saved = false;
    try {
      const response = await fetch(url, {
        method: "PUT",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ source: text, revision, origin, anchors }),
      });
      const json = (response.headers.get("Content-Type") || "").includes("application/json");
      // A sign-in page reached through a redirect answers 200 in HTML.
      if (response.status === 401 || response.status === 403 || response.redirected || (response.ok && !json)) {
        pending ??= text;
        keepLocally(pending);
        stop(response.status === 403);
        return;
      }
      const answer = await response.json();
      if (response.status === 409) {
        pending ??= text;
        // Saved elsewhere since: merged by bar when it can be, else asked.
        if (meet(answer, answer.saved_by)) return;
        conflict = true;
        theirs = answer;
        keepLocally(studio.source());
        openConflict();
      } else if (!response.ok) {
        show(answer.error ?? "Not saved", "conflict");
      } else {
        saved = true;
        revision = answer.revision;
        base = text;
        // The comments the save moved (#392).
        if (answer.threads?.length) comments.take({ threads: answer.threads });
        if (pending == null) forgetLocally();
        else keepLocally(pending);
        titleBox.textContent = answer.title;
        document.title = `${answer.title} · EUI Score`;
        show(pending == null ? (mergeNote ? `Saved, ${mergeNote}` : "Saved") : "Unsaved changes", pending == null ? "ok" : "dirty");
        if (pending == null) mergeNote = null;
      }
    } catch (error) {
      pending ??= text;
      show("Offline — saving when back", "offline");
      setTimeout(save, 5000);
    } finally {
      saving = false;
      // Not saved: what was done since `base` still is.
      if (!saved) barOps = sentOps == null || barOps == null ? null : [...sentOps, ...barOps];
      if (pending != null && !conflict && !stopped) schedule();
    }
  }

  function schedule() {
    clearTimeout(timer);
    timer = setTimeout(save, 1500);
  }

  const studio = startStudio(root, {
    examples: "<%= examples_path() %>",
    shareUrl: <%- owner ? "\"" + app_score_share_path(score) + "\"" : "null" %>,
    scoreUrl: "<%= app_score_path(score) %>",
    source: root.querySelector("[data-source]").value,
    greeting: "Click a note to select it, or press N and type A–G to write. Your changes save themselves.",
    onChange(text) {
      if (applyingRemote) return;
      // Whatever happens to the saves, what is typed is kept here.
      keepLocally(text);
      pending = text;
      if (conflict || stopped) return;
      show("Unsaved changes", "dirty");
      schedule();
    },
    onOpen: openAsNew,
    onPlace: (place) => tellPlace(place),
    // Comments (#385): see "Comments" below.
    onComment: (place) => commentOn(place),
    onMarker: (id) => openThread(id),
    // Bars put in or taken away (#392), or null after an Undo: see `barOps`.
    onBars: (op) => (barOps = op && barOps ? [...barOps, op] : null),
    // The undo history, kept in this browser per person and score: a reload can still undo.
    history: "score:<%= current_user()._key %>:<%= score._key %>",
    historyAcross: true,
    // Its audio tracks, recorded from the microphone (#390).
    audio: { url: "<%= app_score_takes_path(score) %>", csrf: document.querySelector('input[name="_csrf_token"]')?.value ?? null },
  });

  // What New / Open bring becomes a score of its own, once this one's last
  // change is saved.
  async function openAsNew(text) {
    clearTimeout(timer);
    await save();
    const form = document.querySelector("[data-open-form]");
    form.querySelector("[data-open-source]").value = text;
    show("Opening as a new score…", "busy");
    form.submit();
  }

  window.addEventListener("online", save);

  // The score's room: who else has it open, and their saves as they happen.
  // A save from elsewhere is applied here only while this editor has no
  // change of its own on the way; otherwise this editor's next save meets
  // the conflict rule above, and nothing is lost either way.
  const roomBox = document.querySelector("[data-room]");
  const me = "<%= current_user()._key %>";
  let people = {};
  // Where each of the others works, by connection: { user_id, name, lane, bars }.
  let cursors = {};
  // A colour per person, told apart without red and green (Okabe–Ito); this
  // person's other windows in grey.
  const COLOURS = ["#0072B2", "#D55E00", "#009E73", "#CC79A7", "#E69F00", "#56B4E9"];
  const colourOf = (id) => {
    if (id === me) return "#5b6475";
    // By everyone's place in the room, this person's included: each has the same colour on every screen.
    const at = Object.keys(people).sort().indexOf(id);
    const k = at >= 0 ? at : [...id].reduce((sum, c) => sum + c.charCodeAt(0), 0);
    return COLOURS[k % COLOURS.length];
  };
  const shortName = (name) => String(name ?? "").replace(/@.*$/, "") || "Someone";
  const nameOf = (id) => people[id]?.metas?.[0]?.name;
  const showPeople = () => {
    const others = Object.entries(people).filter(([id]) => id !== me);
    roomBox.hidden = others.length === 0;
    roomBox.replaceChildren();
    if (others.length) {
      roomBox.append("With");
      others.forEach(([id, p], k) => {
        // Someone on the read page (#392) listens: said as reading.
        const reading = p.metas.every((meta) => meta.role === "listen");
        const chip = Object.assign(document.createElement("span"), { className: "app-room-person", textContent: shortName(p.metas[0].name) + (reading ? " (reading)" : "") + (k < others.length - 1 ? "," : "") });
        chip.style.setProperty("--peer", colourOf(id));
        chip.dataset.person = id;
        roomBox.append(chip);
      });
    }
    roomBox.title = others.length ? `Also editing: ${others.map(([, p]) => p.metas[0].name).join(", ")}` : "";
    showCursors();
  };
  const showCursors = () => {
    studio.peers(Object.entries(cursors).map(([id, c]) => ({
      id,
      name: c.user_id === me ? "You, in another window" : shortName(c.name),
      colour: colourOf(c.user_id),
      lane: c.lane,
      bars: c.bars,
    })));
  };

  // Where this person works, told to the room: at most four times a second.
  let socket = null;
  let placeNow = null;
  let placeTimer = 0;
  let placeSent = 0;
  const sendPlace = () => {
    placeTimer = 0;
    placeSent = Date.now();
    if (socket?.readyState !== WebSocket.OPEN) return;
    socket.send(JSON.stringify({ event: "cursor", origin, lane: placeNow?.lane ?? null, bars: placeNow?.bars ?? null }));
  };
  const tellPlace = (place) => {
    placeNow = place;
    if (placeTimer) return;
    placeTimer = setTimeout(sendPlace, Math.max(0, 250 - (Date.now() - placeSent)));
  };
  // Each (re)connect asks for a fresh ticket (they last an hour): once the
  // score is no longer shared with this person, or is in the trash, none
  // comes, and the editor stops trying.
  let roomDelay = 3000;
  async function joinRoom() {
    let ticket;
    try {
      const answer = await fetch("<%= app_score_room_ticket_path(editing_score) %>", {
        headers: { Accept: "application/json" },
        credentials: "same-origin",
      });
      if ([401, 403, 404].includes(answer.status) || answer.redirected) {
        people = {};
        showPeople();
        return;
      }
      if (!answer.ok) throw new Error(`ticket: ${answer.status}`);
      ticket = (await answer.json()).ticket;
    } catch (error) {
      setTimeout(joinRoom, roomDelay);
      return;
    }
    const scheme = location.protocol === "https:" ? "wss:" : "ws:";
    socket = new WebSocket(`${scheme}//${location.host}/ws/scores?ticket=${encodeURIComponent(ticket)}`);
    socket.onopen = () => {
      roomDelay = 3000;
      sendPlace();
    };
    socket.onmessage = (message) => {
      let data;
      try {
        data = JSON.parse(message.data);
      } catch (error) {
        return;
      }
      if (data.event === "refused") {
        // Turned away at the door: ask again, later, for a fresh ticket.
        roomDelay = Math.min(roomDelay * 2, 60000);
        socket.close();
      } else if (data.event === "presence_state") {
        people = data.payload;
        showPeople();
      } else if (data.event === "presence_diff") {
        Object.entries(data.payload.joins ?? {}).forEach(([id, p]) => (people[id] = p));
        Object.keys(data.payload.leaves ?? {}).forEach((id) => {
          delete people[id];
          for (const [connection, c] of Object.entries(cursors)) if (c.user_id === id) delete cursors[connection];
        });
        showPeople();
        // Someone came in: they see where this person works.
        if (Object.keys(data.payload.joins ?? {}).length) sendPlace();
      } else if (data.event === "cursor") {
        if (data.origin === origin && !data.gone) return;
        if (data.gone || !data.bars) delete cursors[data.connection_id];
        else cursors[data.connection_id] = { user_id: data.user_id, name: data.name, lane: data.lane, bars: data.bars };
        showCursors();
      } else if (data.event === "saved" && data.origin !== origin && data.revision > revision) {
        // This editor's own save on its way, or a choice open: that save meets the 409, which merges.
        if (saving || conflict) {
          show("Changed in another window", "conflict");
          return;
        }
        if (pending != null) {
          const by = data.saved_by === me ? null : shortName(nameOf(data.saved_by) ?? "someone");
          clearTimeout(timer);
          // Bars changed both ways: sent now, the save meets the 409, which keeps
          // this text in the score's history and opens the choice.
          if (!meet(data, by)) save();
          return;
        }
        revision = data.revision;
        base = data.source;
        applyingRemote = true;
        try {
          // Theirs, not a step of this person's: Undo takes back only this person's own, around it.
          studio.load(data.source, "Updated: someone else saved this score.", { remote: true });
        } finally {
          applyingRemote = false;
        }
        forgetLocally();
        titleBox.textContent = data.title;
        show("Saved", "ok");
      } else if (data.event === "comments" && data.origin !== origin) {
        // A comment of someone else's (#385): in the panel and on the score; the bell may have news.
        comments.take(data);
        window.euiBell?.();
      }
    };
    socket.onclose = () => {
      people = {};
      cursors = {};
      showPeople();
      setTimeout(joinRoom, roomDelay);
    };
  }

  // ---- Comments (#385) ------------------------------------------------------
  // The panel beside the score (public/eui-score/comments.js), opened from
  // the header's Comments, Edit › Comment on the selection, the selection's
  // 💬 or Ctrl+Alt+M; a bubble on each commented bar; the room's news of
  // the others' comments taken in as they come (above).
  const commentsPanel = document.querySelector("[data-comments-panel]");
  const commentsToggle = document.querySelector("[data-comments-toggle]");
  const commentsCount = document.querySelector("[data-comments-count]");
  const showComments = (open) => {
    commentsPanel.hidden = !open;
    commentsToggle?.setAttribute("aria-expanded", String(open));
  };
  const selectThread = (thread) => {
    if (!thread || studio.selectPlace(thread)) return;
    root.querySelector("[data-status]").textContent = `${thread.label}: those bars are no longer in the score.`;
  };
  const comments = startComments(commentsPanel.querySelector("[data-comments]"), {
    url: "<%= app_score_comments_path(score) %>",
    people: "<%= app_score_people_path(score) %>",
    me,
    origin,
    onSelect: selectThread,
    onThreads: (threads) => {
      studio.markers(markersOf(threads));
      const open = threads.filter((thread) => !thread.resolved).length;
      if (commentsCount) commentsCount.textContent = open ? String(open) : "";
    },
  });
  function commentOn(place) {
    showComments(true);
    comments.compose(place, place ? studio.placeLabel(place) : "");
  }
  function openThread(id) {
    showComments(true);
    comments.open(id);
    selectThread(comments.threads().find((thread) => thread.id === id));
  }
  commentsToggle?.addEventListener("click", () => showComments(commentsPanel.hidden));
  commentsPanel.querySelector("[data-comments-close]").addEventListener("click", () => showComments(false));
  studio.ready.then(async () => {
    await comments.refresh();
    // Opened from a notification: at its thread.
    const asked = location.hash.match(/^#thread-(.+)$/)?.[1];
    if (asked) openThread(decodeURIComponent(asked));
  });

  joinRoom();

  // Changes kept in this browser by a visit that could not save them.
  let kept = null;
  try {
    kept = JSON.parse(localStorage.getItem(keepKey) || "null");
  } catch (error) {}
  if (kept?.text) {
    studio.ready.then(() => {
      if (kept.text === studio.source()) return forgetLocally();
      // Typed over another revision than this page's: what both had in common is not known here.
      if (kept.revision !== revision) base = null;
      revision = kept.revision;
      studio.load(kept.text, "Your changes made without a network are back, and being saved.");
    });
  }
  window.addEventListener("beforeunload", (event) => {
    if (stopped === "leaving") return;
    if (pending != null || saving || conflict) event.preventDefault();
  });
  document.querySelector("[data-keep-version]").addEventListener("click", async (event) => {
    await save();
    const response = await fetch(`${url}/versions`, { method: "POST", headers: { Accept: "application/json" } });
    event.target.textContent = response.ok ? "Version kept" : "Not kept";
    setTimeout(() => (event.target.textContent = "Keep a version"), 2500);
  });

  // File › Open a photo…: read on the person's own AI key; what was read
  // opens as a new score. (Without a usable key, the menu links the way to
  // one instead: data-photo-refused.)
  document.querySelector("[data-photo-open]")?.addEventListener("change", async (event) => {
    const file = event.target.files[0];
    event.target.closest("details")?.removeAttribute("open");
    if (!file) return;
    const { readPhoto } = await import("/js/score-photo.js?v=<%= eui_version %>");
    show("Reading the photo… a minute or two", "busy");
    try {
      const answer = await readPhoto(file, { readings: "<%= app_readings_path() %>" });
      await openAsNew(answer.source);
    } catch (problem) {
      show("Photo not read", "conflict");
      // The key or the plan (#396): the page that lifts it, if they want it.
      if (problem.link && confirm(`${problem.message}

${problem.linkText}?`)) location.href = problem.link;
      else if (!problem.link) alert(problem.message);
    } finally {
      event.target.value = "";
    }
  });

  // The AI menu: the editor's text sent with what to ask, the suggestion asked
  // after until it is ready, shown, and applied only on "Apply" (the score as
  // it stands kept as a version first; Undo takes it back too).
  const ai = document.querySelector("[data-ai]");
  const aiPart = (name) => ai.querySelector(`[data-ai-${name}]`);
  const AI_ASKS = {
    chords: ["Chord progression", "Chord symbols for the melody, above it. Say a style if you like: jazz, pop, baroque, modal…", "Optional: a style, an era, how rich the chords should be"],
    harmonize: ["Harmonize the melody", "An accompaniment under the melody, for piano unless you name other voices or instruments.", "Optional: for SATB choir, for string quartet, simple chords on the beat…"],
    improve: ["Suggest improvements", "What the AI would change (voice leading, rhythm, dynamics, phrasing…), with the score revised.", "Optional: what to look at first"],
    ask: ["Ask the AI", "Anything to do with this score.", "Make the bass line more mobile; transpose it for clarinet in B♭; add a coda…"],
  };
  let aiAction = "chords";
  let aiAnswer = null;
  // No usable AI key (#396): the dialog says why and links the way to one; nothing is sent.
  const aiRefused = ai.hasAttribute("data-ai-refused");
  const aiReset = () => {
    aiAnswer = null;
    for (const name of ["status", "error", "result", "apply", "again"]) aiPart(name).hidden = true;
    aiPart("send").hidden = false;
    aiPart("send").disabled = aiRefused;
    aiPart("request").disabled = aiRefused;
  };
  document.querySelectorAll("[data-ai-ask]").forEach((button) => button.addEventListener("click", () => {
    button.closest("details")?.removeAttribute("open");
    aiAction = button.dataset.aiAsk;
    const [title, about, hint] = AI_ASKS[aiAction];
    aiPart("title").textContent = title;
    aiPart("about").textContent = about;
    aiPart("request").placeholder = hint;
    aiPart("request").value = "";
    aiReset();
    ai.showModal();
    if (!aiRefused) aiPart("request").focus();
  }));
  aiPart("close").addEventListener("click", () => ai.close());
  aiPart("again").addEventListener("click", aiReset);
  aiPart("form").addEventListener("submit", async (event) => {
    event.preventDefault();
    if (aiRefused) return;
    // `link`: the page that lifts a refusal (Account for a key, Pricing for Pro, #396).
    const fail = (message, link, linkText) => {
      aiPart("status").hidden = true;
      aiPart("error").textContent = message;
      if (link) aiPart("error").append(" ", Object.assign(document.createElement("a"), { href: link, textContent: linkText || "See the plans" }));
      aiPart("error").hidden = false;
      aiPart("send").disabled = false;
      aiPart("request").disabled = false;
    };
    aiPart("error").hidden = true;
    aiPart("send").disabled = true;
    aiPart("request").disabled = true;
    aiPart("status").textContent = "The AI is working on it… a minute or two.";
    aiPart("status").hidden = false;
    try {
      const sent = await fetch("<%= app_score_suggestions_path(score) %>", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ action: aiAction, request: aiPart("request").value, source: studio.source() }),
      });
      const started = await sent.json();
      if (sent.status !== 202) return fail(started.error, started.link, started.link_text);
      const left = aiPart("left");
      if (left) left.textContent = Math.max(0, Number(left.textContent) - 1);
      // Five minutes, then the page stops waiting.
      for (let tries = 0; tries < 100; tries++) {
        await new Promise((done) => setTimeout(done, 3000));
        if (!ai.open) return;
        const answer = await (await fetch("<%= app_suggestion_path("ID") %>".replace("ID", started.id), { headers: { Accept: "application/json" } })).json();
        if (answer.state === "working") continue;
        if (answer.state === "failed") return fail(answer.error);
        aiAnswer = answer;
        aiPart("status").hidden = true;
        aiPart("explanation").textContent = answer.explanation || "Here is the score the AI proposes.";
        aiPart("preview").innerHTML = answer.svg;
        aiPart("result").hidden = false;
        aiPart("send").hidden = true;
        aiPart("apply").hidden = aiPart("again").hidden = false;
        return;
      }
      fail("No answer after five minutes. Try again in a moment.");
    } catch (problem) {
      fail("The request could not be sent. Check your connection and try again.");
    }
  });
  aiPart("apply").addEventListener("click", async () => {
    if (!aiAnswer) return;
    await save();
    await fetch(`${url}/versions`, { method: "POST", headers: { Accept: "application/json" } });
    studio.load(aiAnswer.source, `${AI_ASKS[aiAction][0]}: applied. Undo, or the History, takes it back.`);
    ai.close();
  });
</script>
