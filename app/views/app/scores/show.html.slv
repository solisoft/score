<%- partial("shared/studio", {"examples": examples, "figure": figure, "source": source}) %>

<%# The score saves itself: 1.5 s after the last change, a PUT of its source
    over the revision it was opened at. The header says where it stands.
    A 409 — saved from another window since — is never overwritten: the
    server keeps the text refused here as a version, and this page offers
    the score as it now stands.
    Offline, each change is also kept in this browser (localStorage, with
    the revision it was typed over) until a save goes through: a page
    closed before then gives it back the next time it opens, and sends it. %>
<script type="module">
  const { startStudio } = await import("/eui-score/studio.js?v=<%= eui_version %>");
  const root = document.getElementById("studio");
  const url = "<%= app_score_path(score) %>";
  const saveState = document.querySelector("[data-save-state]");
  const titleBox = document.querySelector("[data-doc-title]");
  let revision = <%= score.revision %>;
  let pending = null;
  let saving = false;
  let conflict = false;
  let timer = 0;
  const keepKey = "eui-score-pending:<%= score._key %>";

  const keepLocally = (text) => {
    try {
      localStorage.setItem(keepKey, JSON.stringify({ text, revision }));
    } catch (error) {}
  };
  const forgetLocally = () => {
    try {
      localStorage.removeItem(keepKey);
    } catch (error) {}
  };

  const show = (text, kind) => {
    saveState.textContent = text;
    saveState.dataset.kind = kind;
  };

  async function save() {
    if (saving || conflict || pending == null) return;
    const text = pending;
    pending = null;
    saving = true;
    show("Saving…", "busy");
    try {
      const response = await fetch(url, {
        method: "PUT",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify({ source: text, revision }),
      });
      const answer = await response.json();
      if (response.status === 409) {
        conflict = true;
        show("Changed in another window", "conflict");
        if (confirm("This score was saved from another window since you opened it. Open that version here? What you typed is kept in the score's history.")) {
          revision = answer.revision;
          conflict = false;
          studio.load(answer.source, "The score as it was saved elsewhere.");
          pending = null;
          forgetLocally();
          show("Saved", "ok");
        }
      } else if (!response.ok) {
        show(answer.error ? `Not saved: ${answer.error}` : "Not saved", "conflict");
      } else {
        revision = answer.revision;
        if (pending == null) forgetLocally();
        else keepLocally(pending);
        titleBox.textContent = answer.title;
        document.title = `${answer.title} · EUI Score`;
        show(pending == null ? "Saved" : "Unsaved changes", pending == null ? "ok" : "dirty");
      }
    } catch (error) {
      pending ??= text;
      show("Offline — saving when back", "offline");
      setTimeout(save, 5000);
    } finally {
      saving = false;
      if (pending != null && !conflict) schedule();
    }
  }

  function schedule() {
    clearTimeout(timer);
    timer = setTimeout(save, 1500);
  }

  const studio = startStudio(root, {
    examples: "<%= examples_path() %>",
    shareUrl: <%- owner ? "\"" + app_score_share_path(score) + "\"" : "null" %>,
    source: root.querySelector("[data-source]").value,
    greeting: "Click a note to select it, or press N and type A–G to write. Your changes save themselves.",
    onChange(text) {
      if (conflict) return;
      pending = text;
      keepLocally(text);
      show("Unsaved changes", "dirty");
      schedule();
    },
  });

  window.addEventListener("online", save);

  // Changes kept in this browser by a visit that could not save them.
  let kept = null;
  try {
    kept = JSON.parse(localStorage.getItem(keepKey) || "null");
  } catch (error) {}
  if (kept?.text) {
    studio.ready.then(() => {
      if (kept.text === studio.source()) return forgetLocally();
      revision = kept.revision;
      studio.load(kept.text, "Your changes made without a network are back, and being saved.");
    });
  }
  window.addEventListener("beforeunload", (event) => {
    if (pending != null || saving) event.preventDefault();
  });
  document.querySelector("[data-keep-version]").addEventListener("click", async (event) => {
    await save();
    const response = await fetch(`${url}/versions`, { method: "POST", headers: { Accept: "application/json" } });
    event.target.textContent = response.ok ? "Version kept" : "Not kept";
    setTimeout(() => (event.target.textContent = "Keep a version"), 2500);
  });
</script>
