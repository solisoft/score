<section class="library">
  <header class="library-head">
    <h1><%= t("app.scores.index.title") %></h1>
    <a class="btn btn-primary" href="<%= app_home_path() %>"><%= t("app.scores.index.new_score") %></a>
  </header>

  <form action="<%= app_scores_path() %>" method="GET" class="library-tools" role="search">
    <label class="field library-search"><%= t("app.scores.index.search_label") %>
      <input type="search" id="library-q" name="q" value="<%= query %>" placeholder="<%= t("app.scores.index.search_placeholder") %>">
    </label>
    <label class="field"><%= t("app.scores.index.order") %>
      <select id="library-sort" name="sort">
        <% sort_options = ["updated", "title", "created"].map { |key| [key, t("app.scores.index.sort_#{key}")] } %>
        <% for option in sort_options %>
          <option value="<%= option[0] %>"<%- option[0] == sort ? " selected" : "" %>><%= option[1] %></option>
        <% end %>
      </select>
    </label>
    <button type="submit" class="btn btn-ghost"><%= t("app.scores.index.search") %></button>
  </form>

  <% if scores.length == 0 %>
    <div class="library-empty">
      <% if page > 1 %>
        <h2><%= t("app.scores.index.empty_page") %></h2>
        <p><a href="<%= page_path %>1"><%= t("app.scores.index.first_page") %></a></p>
      <% elsif query.blank? %>
        <h2><%= t("app.scores.index.none_yet") %></h2>
        <p><%- t("app.scores.index.none_yet_lead") %></p>
      <% else %>
        <h2><%= t("app.scores.index.no_match", {"query": query}) %></h2>
        <p><a href="<%= app_scores_path() %>"><%= t("app.scores.index.all_scores") %></a></p>
      <% end %>
    </div>
  <% else %>
    <ul class="library-grid">
      <% for score in scores %>
        <li class="score-card">
          <a class="score-card-open" href="<%= app_score_path(score) %>">
            <img src="<%= app_score_preview_path(score) %>?r=<%= score.revision %>" alt="" loading="lazy" width="280" height="140">
            <span class="score-card-title"><%= score.title %></span>
          </a>
          <% unless score.composer.blank? %>
            <span class="score-card-by"><%= score.composer %></span>
          <% end %>
          <span class="score-card-when muted"><%= t("app.scores.index.changed", {"when": time_ago(score.updated_at)}) %></span>
          <details class="score-card-more">
            <summary aria-label="<%= t("app.scores.index.more_for", {"title": score.title}) %>"><%= t("app.scores.index.more") %></summary>
            <form action="<%= app_score_rename_path(score) %>" method="POST" class="score-card-rename">
              <%- csrf_field() %>
              <label class="field"><%= t("app.scores.index.new_title") %>
                <input type="text" name="title" value="<%= score.title %>" required maxlength="200">
              </label>
              <button type="submit" class="btn btn-ghost"><%= t("app.scores.index.rename") %></button>
            </form>
            <form action="<%= app_score_duplicate_path(score) %>" method="POST">
              <%- csrf_field() %>
              <button type="submit" class="btn btn-ghost"><%= t("app.scores.index.make_copy") %></button>
            </form>
            <form action="<%= app_score_trash_path(score) %>" method="POST">
              <%- csrf_field() %>
              <button type="submit" class="btn btn-danger"><%= t("app.scores.index.move_to_trash") %></button>
            </form>
          </details>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if page > 1 || more %>
    <nav class="library-pages" aria-label="<%= t("app.scores.index.pages_label") %>" data-library-pages>
      <% if page > 1 %>
        <a class="btn btn-ghost" rel="prev" href="<%= page_path %><%= page - 1 %>"><%= t("app.scores.index.previous") %></a>
      <% end %>
      <span class="muted"><%= t("app.scores.index.page", {"n": page}) %></span>
      <% if more %>
        <a class="btn btn-ghost" rel="next" href="<%= page_path %><%= page + 1 %>"><%= t("app.scores.index.next") %></a>
      <% end %>
    </nav>
  <% end %>

  <% if shared.length > 0 %>
    <section class="start-recent">
      <h2><%= t("app.scores.index.shared_with_you") %></h2>
      <ul class="library-grid">
        <% for entry in shared %>
          <li class="score-card">
            <a class="score-card-open" href="<%= app_score_path(entry["score"]) %>">
              <img src="<%= app_score_preview_path(entry["score"]) %>?r=<%= entry["score"].revision %>" alt="" loading="lazy" width="280" height="140">
              <span class="score-card-title"><%= entry["score"].title %></span>
            </a>
            <% unless entry["owner"].blank? %>
              <span class="score-card-by" data-shared-by><%= t("app.scores.index.shared_by", {"name": entry["owner"]}) %></span>
            <% end %>
            <span class="score-card-when muted"><%= t(entry["role"] == "write" ? "app.scores.index.may_change" : "app.scores.index.may_read") %></span>
            <details class="score-card-more">
              <summary aria-label="<%= t("app.scores.index.more_for", {"title": entry["score"].title}) %>"><%= t("app.scores.index.more") %></summary>
              <%- button_to(t("app.scores.index.leave"), app_score_leave_path(entry["score"]), {
                "confirm": t("app.scores.index.leave_confirm", {"title": entry["score"].title}),
                "class": "btn btn-ghost"
              }) %>
            </details>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <p class="library-trash-link"><a href="<%= app_trash_path() %>"><%= t("app.scores.index.trash_link") %><% if trash_count > 0 %> (<%= trash_count %>)<% end %></a></p>
</section>
