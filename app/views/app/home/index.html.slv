<% if user.nil? %>
  <section class="app-panel">
    <span class="eyebrow">Score</span>
    <h1><%= t("app.home.guest_title") %></h1>
    <p class="lead"><%= t("app.home.guest_lead") %></p>
    <div class="app-cta">
      <a class="btn btn-primary" href="<%= signup_path() %>"><%= t("app.home.create_account") %></a>
      <a class="btn btn-ghost" href="<%= login_path() %>"><%= t("app.home.sign_in") %></a>
    </div>
    <p class="muted"><%- t("app.home.guest_try", {"playground": playground_path()}) %></p>
  </section>
<% else %>
  <section class="start">
    <h1><%= t("app.home.title") %></h1>

    <% if photos_going > 0 %>
      <p class="callout import-banner" data-imports-going><%= t(photos_going == 1 ? "app.home.photos_going_one" : "app.home.photos_going_other", {"count": photos_going}) %>
        <a href="<%= app_imports_path() %>"><%= t("app.home.follow_imports") %></a></p>
    <% end %>

    <%# Every way in posts the same form: the LilyPond to start from, and a
        title for a source that has none. %>
    <form action="<%= app_scores_path() %>" method="POST" id="start-form" hidden>
      <%- csrf_field() %>
      <input type="hidden" name="source" id="start-source">
      <input type="hidden" name="title" id="start-title">
    </form>

    <div class="start-grid">
      <form class="start-card start-new" id="new-score">
        <h2><%= t("app.home.new_score") %></h2>
        <fieldset class="start-templates">
          <legend><%= t("app.home.start_from") %></legend>
          <div data-templates></div>
        </fieldset>
        <div class="start-fields">
          <label class="field"><%= t("app.home.title_field") %> <input type="text" id="new-title" name="title" placeholder="<%= t("app.home.untitled") %>" maxlength="200"></label>
          <label class="field"><%= t("app.home.composer") %> <input type="text" id="new-composer" name="composer"></label>
          <label class="field"><%= t("app.home.key") %>
            <select id="new-key" name="key">
              <% for key_choice in editor_keys() %>
                <option value="<%= key_choice[0] %>"<%= key_choice[0] == 0 ? " selected" : "" %>><%= key_choice[1] %></option>
              <% end %>
            </select>
          </label>
          <label class="field"><%= t("app.home.metre") %>
            <select id="new-time" name="time">
              <% for metre in editor_metres() %>
                <option value="<%= metre %>"<%= metre == "4/4" ? " selected" : "" %>><%= metre %></option>
              <% end %>
            </select>
          </label>
          <label class="field"><%= t("app.home.tempo") %> <input type="number" id="new-bpm" name="bpm" min="20" max="300" placeholder="<%= t("app.home.no_tempo") %>"></label>
          <label class="field"><%= t("app.home.bars") %> <input type="number" id="new-bars" name="bars" min="1" max="500" value="16"></label>
        </div>
        <p class="form-error" data-new-error hidden></p>
        <button type="submit" class="btn btn-primary"><%= t("app.home.create") %></button>
      </form>

      <div class="start-side">
        <div class="start-card">
          <h2><%= t("app.home.import") %></h2>
          <p class="muted"><%= t("app.home.import_about") %></p>
          <label class="btn btn-ghost start-file"><%= t("app.home.choose_file") %>
            <input type="file" accept=".ly,.ily,.txt,.musicxml,.mxl,.xml,.mid,.midi,text/plain,audio/midi" data-import hidden>
          </label>
          <div data-import-note hidden>
            <p class="form-error" data-import-message></p>
            <button type="button" class="btn btn-ghost" data-import-anyway hidden><%= t("app.home.create_anyway") %></button>
          </div>
        </div>

        <div class="start-card">
          <h2><%= t("app.home.from_photo") %></h2>
          <% if photos["ready"] %>
            <p class="muted"><%- t("app.home.photo_ready", {"with": h(photos["with"]), "left": "<span data-photos-left>#{photos["left"]}</span>"}) %>
              <a href="<%= app_imports_path() %>"><%= t("app.home.photo_imports") %></a></p>
            <label class="btn btn-ghost start-file"><%= t("app.home.choose_photo") %>
              <input type="file" accept="image/*" data-photo hidden<%= photos["left"] == 0 ? " disabled" : "" %>>
            </label>
          <% elsif photos["refusal"] == "plan" %>
            <p class="muted" data-photos-refused><%= t("app.home.photo_plan") %> <%= photos["text"] %></p>
            <a class="btn btn-ghost start-file" href="<%= photos["link"]["href"] %>"><%= photos["link"]["text"] %></a>
          <% else %>
            <p class="muted" data-photos-refused><%= t("app.home.photo_no_key") %></p>
            <a class="btn btn-ghost start-file" href="<%= photos["link"]["href"] %>"><%= t("app.home.add_ai_key") %></a>
          <% end %>
        </div>

        <div class="start-card" data-draft hidden>
          <h2><%= t("app.home.draft_heading") %></h2>
          <p class="muted"><%- t("app.home.draft_about", {"playground": playground_path(), "title": "<strong data-draft-title></strong>"}) %></p>
          <button type="button" class="btn btn-ghost" data-keep-draft><%= t("app.home.save_to_account") %></button>
        </div>

        <div class="start-card" data-shared hidden>
          <h2><%= t("app.home.shared_heading") %></h2>
          <p class="muted"><%- t("app.home.shared_about", {"title": "<strong data-shared-title></strong>"}) %></p>
          <button type="button" class="btn btn-ghost" data-keep-shared><%= t("app.home.save_to_account") %></button>
        </div>
      </div>
    </div>

    <section class="photo-reading" data-reading hidden>
      <div class="library-head">
        <h2><%= t("app.home.from_photo") %></h2>
        <button type="button" class="btn btn-ghost" data-reading-close><%= t("app.home.close") %></button>
      </div>
      <div class="photo-reading-pair">
        <figure>
          <img data-reading-photo alt="<%= t("app.home.the_photo") %>">
          <figcaption class="muted"><%= t("app.home.the_photo") %></figcaption>
        </figure>
        <figure>
          <div class="photo-reading-score" data-reading-score></div>
          <pre class="photo-reading-draft" data-reading-draft aria-live="off" hidden></pre>
          <figcaption class="muted" data-reading-status aria-live="polite"><%= t("app.home.sending_photo") %></figcaption>
        </figure>
      </div>
      <p class="muted" data-reading-away hidden><%- t("app.home.reading_away", {"imports": app_imports_path()}) %></p>
      <p class="form-error" data-reading-error hidden></p>
      <button type="button" class="btn btn-primary" data-reading-keep hidden><%= t("app.home.create") %></button>
    </section>

    <section class="start-recent">
      <div class="library-head">
        <h2><%= t("app.home.recent") %></h2>
        <a href="<%= app_scores_path() %>"><%= t("app.home.all_scores") %></a>
      </div>
      <% if recent.length == 0 %>
        <p class="muted"><%= t("app.home.recent_empty") %></p>
      <% else %>
        <ul class="library-grid">
          <% for score in recent %>
            <li class="score-card">
              <a class="score-card-open" href="<%= app_score_path(score) %>">
                <img src="<%= app_score_preview_path(score) %>?r=<%= score.revision %>" alt="" loading="lazy" width="280" height="140">
                <span class="score-card-title"><%= score.title %></span>
              </a>
              <span class="score-card-when muted"><%= t("app.home.changed", {"when": time_ago(score.updated_at)}) %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </section>

  <%# The editor's modules imported below (score-photo.js, score-model.js…) in
      the app's language (#508), as on the editor's page; none in English. %>
  <script>window.EUI_WORDS = <%- editor_words.length > 0 ? editor_words.to_json : "null" %>; window.EUI_WORDS_LOCALE = "<%= I18n.locale() %>";</script>
  <script type="module">
    <% script_words = {"untitled": t("app.home.untitled"), "left_out": t("app.home.left_out")} %>
    <% script_words["sending"] = t("app.home.sending_photo") %>
    <% script_words["see_plans"] = t("app.home.see_plans") %>
    <% script_words["done"] = t("app.home.reading_done") %>
    <% script_words["templates"] = template_words %>
    const words = <%- script_words.to_json %>;
    const startForm = document.getElementById("start-form");
    const begin = (source, title = "") => {
      document.getElementById("start-source").value = source;
      document.getElementById("start-title").value = title;
      startForm.submit();
    };
    const titleOf = (source) => /\\header\s*\{[^}]*?title\s*=\s*"([^"]*)"/.exec(source)?.[1] || words.untitled;

    // Import: the file's text, titled after the file when it has no title.
    // MusicXML and MIDI are read as LilyPond first; what they hold that the editor does not write is named before going on.
    // Listened to before the score model loads, so a file chosen meanwhile is not lost. data-ready says so: the
    // page's text is there well before this, and a file chosen before it would be dropped (the browser specs wait for it).
    const importInput = document.querySelector("[data-import]");
    importInput.addEventListener("change", async (event) => {
      const file = event.target.files[0];
      if (!file) return;
      const name = file.name.replace(/\.[^.]+$/, "");
      const midi = /\.(mid|midi|smf|kar)$/i.test(file.name);
      if (!midi && !/\.(musicxml|mxl|xml)$/i.test(file.name)) return begin(await file.text(), name);
      const note = document.querySelector("[data-import-note]");
      const message = document.querySelector("[data-import-message]");
      const anyway = document.querySelector("[data-import-anyway]");
      try {
        let read;
        if (midi) {
          const I = await import("/eui-score/midi-import.js?v=<%= eui_version %>");
          read = I.fromMidi(new Uint8Array(await file.arrayBuffer()), { title: name });
        } else {
          const X = await import("/eui-score/musicxml.js?v=<%= eui_version %>");
          read = X.fromMusicXML(await X.musicXmlOf(file));
        }
        const { source, warnings } = read;
        if (!warnings.length) return begin(source, name);
        message.textContent = words.left_out.replace("{file}", file.name).replace("{what}", warnings.join("; "));
        anyway.hidden = false;
        anyway.onclick = () => begin(source, name);
      } catch (problem) {
        message.textContent = problem.message;
        anyway.hidden = true;
      }
      note.hidden = false;
    });
    importInput.dataset.ready = "";

    const M = await import("/eui-score/score-model.js?v=<%= eui_version %>");

    // New: a template, its settings, the model's LilyPond.
    const box = document.querySelector("[data-templates]");
    for (const template of M.TEMPLATES) {
      const label = Object.assign(document.createElement("label"), { className: "studio-template" });
      const radio = Object.assign(document.createElement("input"), { type: "radio", name: "template", value: template.id, checked: template.id === "piano" });
      const staves = template.staves.map((spec) => spec.name ?? spec.instrument).filter((name, k, all) => name !== all[k - 1]);
      label.append(radio, Object.assign(document.createElement("b"), { textContent: words.templates[template.id]?.name ?? template.name }), Object.assign(document.createElement("small"), { textContent: words.templates[template.id]?.about ?? template.about ?? staves.join(", ") }));
      box.append(label);
    }
    document.getElementById("new-score").addEventListener("submit", (event) => {
      event.preventDefault();
      const form = new FormData(event.target);
      const error = document.querySelector("[data-new-error]");
      try {
        const metre = M.metreOf(form.get("time"));
        const score = M.fromTemplate(form.get("template"), {
          title: form.get("title").trim() || words.untitled,
          composer: form.get("composer").trim(),
          key: Number(form.get("key")),
          time: metre.time,
          bpm: Number(form.get("bpm")) || 0,
          bars: Number(form.get("bars")) || 16,
        });
        score.timeParts = metre.parts;
        begin(M.toLilyPond(score).source);
      } catch (problem) {
        error.textContent = problem.message;
        error.hidden = false;
      }
    });

    // A photo: sent to be read, asked after until it is, shown beside what was read.
    const photoInput = document.querySelector("[data-photo]");
    const reading = document.querySelector("[data-reading]");
    const { readPhoto, readingSays } = await import("/js/score-photo.js?v=<%= eui_version %>");
    photoInput?.addEventListener("change", async (event) => {
      const file = event.target.files[0];
      if (!file) return;
      const name = file.name.replace(/\.[^.]+$/, "");
      const status = reading.querySelector("[data-reading-status]");
      const error = reading.querySelector("[data-reading-error]");
      const keep = reading.querySelector("[data-reading-keep]");
      const score = reading.querySelector("[data-reading-score]");
      const draft = reading.querySelector("[data-reading-draft]");
      reading.querySelector("[data-reading-photo]").src = URL.createObjectURL(file);
      score.replaceChildren();
      draft.hidden = true;
      draft.textContent = "";
      status.textContent = words.sending;
      error.hidden = keep.hidden = true;
      reading.hidden = false;
      reading.scrollIntoView({ behavior: "smooth", block: "start" });
      // `link`: the page that lifts the refusal (Account for a key, Pricing for Pro, #396).
      const fail = (message, link, linkText) => {
        error.textContent = message;
        if (link) error.append(" ", Object.assign(document.createElement("a"), { href: link, textContent: linkText || words.see_plans }));
        error.hidden = false;
        status.textContent = "";
        draft.hidden = true;
      };
      try {
        const answer = await readPhoto(file, {
          readings: "<%= app_readings_path() %>",
          started: (id) => {
            const left = document.querySelector("[data-photos-left]");
            left.textContent = Math.max(0, Number(left.textContent) - 1);
            status.textContent = readingSays({ phase: "waiting", seconds: 0 });
            // It goes on without this page (#465): where to find it again.
            const away = reading.querySelector("[data-reading-away]");
            away.querySelector("a").href = "<%= app_imports_path() %>/" + id;
            away.hidden = false;
          },
          // How it goes (#435): the time, then the LilyPond as the AI writes it.
          progress: (news) => {
            status.textContent = readingSays(news);
            if (news.draft) {
              draft.hidden = false;
              draft.textContent = news.draft;
              draft.scrollTop = draft.scrollHeight;
            }
          },
        });
        draft.hidden = true;
        score.innerHTML = answer.svg;
        status.textContent = words.done;
        keep.hidden = false;
        keep.onclick = () => begin(answer.source, name);
      } catch (problem) {
        fail(problem.message, problem.link, problem.linkText);
      } finally {
        photoInput.value = "";
      }
    });
    reading.querySelector("[data-reading-close]").addEventListener("click", () => { reading.hidden = true; });

    // The playground's draft, kept in this browser.
    let draft = null;
    try {
      draft = localStorage.getItem("eui-score-studio-draft");
    } catch (error) {}
    if (draft && draft.trim()) {
      document.querySelector("[data-draft]").hidden = false;
      document.querySelector("[data-draft-title]").textContent = titleOf(draft);
      document.querySelector("[data-keep-draft]").addEventListener("click", () => begin(draft));
    }

    // A shared link (#s=…), opened here.
    const code = /^#s=([A-Za-z0-9_-]+)$/.exec(location.hash)?.[1];
    if (code) {
      const shared = await M.fromShareCode(code).catch(() => null);
      if (shared && shared.trim()) {
        document.querySelector("[data-shared]").hidden = false;
        document.querySelector("[data-shared-title]").textContent = titleOf(shared);
        document.querySelector("[data-keep-shared]").addEventListener("click", () => begin(shared));
      }
    }
  </script>
<% end %>
