<div class="wrap">
  <header class="page-head">
    <span class="eyebrow">A shared score</span>
    <h1><%= score.title %></h1>
    <% if can_edit %>
      <p><a class="btn btn-ghost" href="<%= app_score_path(score) %>">Open in the editor</a></p>
    <% end %>
    <%# Live (#392): who else has the score open, and a save made meanwhile. %>
    <p class="read-room" data-read-room hidden></p>
    <p class="read-updated" data-read-updated hidden role="status">This score was just changed. <a href="" data-read-reload>See it as it is now</a></p>
  </header>
  <%- score_figure(figure, {"name": file_name, "pdf": pdf_url, "title": score.title, "source": "closed", "actions": "top", "written": written}) %>
  <%# The score in other programs' files, written in the browser from its
      source (public/js/score.js): nothing here can change the score. %>
  <% if figure["error"].nil? %>
    <section class="read-exports" data-read-exports data-source-url="<%= source_url %>" data-file="<%= file_name %>"
             data-title="<%= score.title %>" aria-labelledby="read-exports-title">
      <h2 id="read-exports-title">In other programs</h2>
      <div class="score-actions">
        <button type="button" class="score-btn" data-read-musicxml>MusicXML</button>
        <a class="score-btn" href="<%= source_url %>" download="<%= file_name %>.ly">LilyPond</a>
        <button type="button" class="score-btn" data-read-parts>A part…</button>
      </div>
      <div class="read-part" data-read-part hidden>
        <label>Instrument <select data-read-part-staff></select></label>
        <button type="button" class="score-btn" data-read-part-pdf>Part as PDF</button>
        <button type="button" class="score-btn score-btn-ghost" data-read-part-ly>Part as LilyPond</button>
      </div>
      <p class="read-exports-note muted" data-read-note role="status"></p>
    </section>
  <% end %>
  <%# The audio recorded onto it in the editor (#390), for the people it is
      shared with: each take on its own, not played with the score here. %>
  <% if takes.length > 0 %>
    <section class="read-takes" aria-labelledby="read-takes-title">
      <h2 id="read-takes-title">Recorded audio</h2>
      <% for take in takes %>
        <figure class="read-take">
          <figcaption><%= take["name"] %></figcaption>
          <audio controls preload="none" src="<%= take["url"] %>"></audio>
        </figure>
      <% end %>
    </section>
  <% end %>
  <%# Comments (#385), for the people the score is shared with: read,
      reply, resolve, and start a thread on a staff's bars, typed in (the
      editor takes them from its selection). public/eui-score/comments.js. %>
  <% unless comments_url.nil? %>
    <section class="read-comments" aria-labelledby="read-comments-title">
      <h2 id="read-comments-title">Comments</h2>
      <div class="studio-comments-body" data-read-comments></div>
    </section>
  <% end %>
  <%# The score's room, listened to (#392; ScoreRoom): the people of the
      score hear the comments as they are written and see who else is
      there; anyone else the score is open to hears only that it changed.
      Nothing is sent from here but the connection itself. What the script
      needs comes beside it: its text never changes, its hash is in the
      Content-Security-Policy (#544). %>
  <%- page_data("read-data", {
    "comments": comments_url,
    "people": people_url,
    "me": me.to_s,
    "v": eui_version,
    "revision": score.revision,
    "ticket": ticket_url
  }) %>
  <script type="module">
    const page = JSON.parse(document.getElementById("read-data").textContent);
    const commentsUrl = page.comments;
    const origin = crypto.randomUUID?.() ?? String(Math.random()).slice(2);
    let comments = null;
    if (commentsUrl) {
      const { startComments } = await import(`/eui-score/comments.js?v=${page.v}`);
      const panel = document.querySelector(".read-comments .studio-comments-body");
      comments = startComments(panel, {
        url: commentsUrl,
        people: page.people,
        me: page.me,
        origin,
        manual: true,
      });
      await comments.refresh();
      const asked = location.hash.match(/^#thread-(.+)$/)?.[1];
      if (asked) comments.open(decodeURIComponent(asked));
    }

    const roomBox = document.querySelector("[data-read-room]");
    const updated = document.querySelector("[data-read-updated]");
    const me = page.me;
    let people = {};
    const shortName = (name) => String(name ?? "").replace(/@.*$/, "") || "Someone";
    const showPeople = () => {
      const others = Object.entries(people).filter(([id]) => id !== me && id !== "guest");
      roomBox.hidden = others.length === 0;
      roomBox.textContent = others.length ? `Also here: ${others.map(([, p]) => shortName(p.metas[0].name) + (p.metas.every((meta) => meta.role === "listen") ? " (reading)" : " (editing)")).join(", ")}` : "";
    };
    updated.querySelector("[data-read-reload]").addEventListener("click", (event) => {
      event.preventDefault();
      location.reload();
    });
    let delay = 3000;
    let revision = page.revision;
    // A link followed (instant navigation): the room is left, and not joined again.
    let left = false;
    let socket = null;
    let timer = 0;
    const leave = new AbortController();
    document.addEventListener("soli:load", () => {
      if (roomBox.isConnected) return;
      left = true;
      leave.abort();
      clearTimeout(timer);
      socket?.close();
    }, { signal: leave.signal });
    async function listen() {
      if (left) return;
      let ticket;
      try {
        const answer = await fetch(page.ticket, { headers: { Accept: "application/json" }, credentials: "same-origin" });
        // No longer open to this reader: nothing more to hear.
        if ([401, 403, 404].includes(answer.status)) return;
        if (!answer.ok) throw new Error(`ticket: ${answer.status}`);
        ticket = (await answer.json()).ticket;
      } catch (error) {
        if (!left) timer = setTimeout(listen, delay);
        return;
      }
      if (left) return;
      const scheme = location.protocol === "https:" ? "wss:" : "ws:";
      socket = new WebSocket(`${scheme}//${location.host}/ws/scores?ticket=${encodeURIComponent(ticket)}`);
      socket.onopen = () => (delay = 3000);
      socket.onmessage = (message) => {
        let data;
        try {
          data = JSON.parse(message.data);
        } catch (error) {
          return;
        }
        if (data.event === "refused") {
          delay = Math.min(delay * 2, 60000);
          socket.close();
        } else if (data.event === "presence_state") {
          people = data.payload;
          showPeople();
        } else if (data.event === "presence_diff") {
          Object.entries(data.payload.joins ?? {}).forEach(([id, p]) => (people[id] = p));
          Object.keys(data.payload.leaves ?? {}).forEach((id) => delete people[id]);
          showPeople();
        } else if (data.event === "saved" && data.revision > revision) {
          revision = data.revision;
          updated.hidden = false;
        } else if (data.event === "comments" && data.origin !== origin) {
          comments?.take(data);
        }
      };
      socket.onclose = () => {
        if (left) return;
        people = {};
        showPeople();
        timer = setTimeout(listen, delay);
      };
    }
    listen();
  </script>
</div>
