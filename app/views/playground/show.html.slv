<% if app_open?() %>
  <%# The playground is the demo: what is written here stays in this browser.
      The app keeps it in an account, and has the MIDI view and the AI. One
      line (#419), closed for this browser by its ×. %>
  <p class="playground-banner" data-banner data-app-only>
    <span>
      Your score stays in this browser. <a href="<%= app_home_path() %>">Save it in the app</a> for its history,
      the MIDI view and the AI features, or <a href="<%= signup_path() %>">sign up</a>.
    </span>
    <button type="button" class="playground-banner-close" data-banner-close aria-label="Hide this message">×</button>
  </p>
<% end %>
<%- partial("shared/studio", {"examples": examples, "figure": figure, "source": source}) %>

<script type="module">
  // The line over the editor, hidden for good in this browser once closed.
  const banner = document.querySelector("[data-banner]");
  const HIDDEN = "eui-score-playground-banner-hidden";
  try {
    if (localStorage.getItem(HIDDEN)) banner?.remove();
  } catch (error) {}
  banner?.querySelector("[data-banner-close]").addEventListener("click", () => {
    banner.remove();
    try {
      localStorage.setItem(HIDDEN, "1");
    } catch (error) {}
  });
  const { startStudio } = await import("/eui-score/studio.js?v=<%= eui_version %>");
  startStudio(document.getElementById("studio"), { examples: "<%= examples_path() %>" });
</script>
