<div class="wrap-fluid">
  <header class="sandbox-head">
    <div>
      <span class="eyebrow">Playground</span>
      <h1>Type it, click it, it's engraved.</h1>
    </div>
    <p class="muted">
      Edit the LilyPond on the left, or the score on the right: click a note, move it with the arrows or the
      mouse, type A–G. eui-score, compiled to WebAssembly, engraves every change in your browser. Nothing is
      sent or stored.
    </p>
  </header>

  <div class="sandbox">
    <div class="sandbox-editor">
      <div class="sandbox-toolbar">
        <select aria-label="Start from an example" data-no-nav
                onchange="if (this.value) { window.location.href = this.value }">
          <option value="">Start from an example…</option>
          <% for example in examples %>
            <% value = playground_path() + "?source=" + example["category"] + "/" + example["slug"] %>
            <option value="<%= value %>"><%= example["title"] %> — <%= example["instrument"] %></option>
          <% end %>
        </select>
        <span class="sandbox-status" id="sandbox-status" aria-live="polite"></span>
      </div>
      <textarea id="sandbox-source" wrap="off" spellcheck="false" autocapitalize="off" autocomplete="off"
                aria-label="LilyPond source"><%= source %></textarea>
    </div>

    <div class="sandbox-result">
      <div class="score-sheet" id="sandbox-sheet">
        <eui-score-editor id="sandbox-score"><div class="ese-sheet"><%- figure["svg"].to_s %></div></eui-score-editor>
      </div>
      <div class="score-actions">
        <button type="button" class="score-btn score-btn-play" id="sandbox-play" data-score-play data-midi="<%= figure["midi"] %>"><span aria-hidden="true">▶</span> Play</button>
        <button type="button" class="score-btn" id="sandbox-midi">MIDI</button>
        <button type="button" class="score-btn" id="sandbox-pdf">A4 PDF</button>
        <button type="button" class="score-btn" id="sandbox-ly">.ly</button>
        <div class="score-player" data-score-player></div>
      </div>
    </div>
  </div>
</div>

<script type="module">
  import { toMidi, toPdf, download } from "<%= public_path("eui-score/eui-score.js") %>";
  import "<%= public_path("eui-score/eui-score-editor.js") %>";

  const textarea = document.getElementById("sandbox-source");
  const score = document.getElementById("sandbox-score");
  const status = document.getElementById("sandbox-status");
  const play = document.getElementById("sandbox-play");
  const sheet = document.getElementById("sandbox-sheet");
  let midiUrl = null;
  let midiFor = null;

  function title() {
    const match = textarea.value.match(/title\s*=\s*"([^"]*)"/);
    return (match ? match[1] : "score").trim() || "score";
  }

  async function refreshMidi() {
    if (midiFor === textarea.value) return;
    midiFor = textarea.value;
    try {
      const bytes = await toMidi(textarea.value);
      if (midiUrl) URL.revokeObjectURL(midiUrl);
      midiUrl = URL.createObjectURL(new Blob([bytes], { type: "audio/midi" }));
      play.dataset.midi = midiUrl;
    } catch (error) {}
  }

  score.addEventListener("render", (event) => {
    sheet.classList.remove("score-sheet-refused");
    const ms = event.detail.ms < 1 ? "under 1" : Math.round(event.detail.ms);
    status.textContent = `${textarea.value.length} characters · engraved in ${ms} ms`;
    refreshMidi();
  });
  score.addEventListener("refuse", () => sheet.classList.add("score-sheet-refused"));
  // An edit on the score rewrites the text; the text rewrites the score.
  score.addEventListener("change", (event) => {
    textarea.value = event.detail.source;
  });
  textarea.addEventListener("input", () => {
    score.source = textarea.value;
  });
  score.source = textarea.value;

  document.getElementById("sandbox-midi").addEventListener("click", async () => {
    try { download(await toMidi(textarea.value), `${title()}.mid`, "audio/midi"); } catch (error) {}
  });
  document.getElementById("sandbox-pdf").addEventListener("click", async () => {
    try { download(await toPdf(textarea.value, title()), `${title()}.pdf`, "application/pdf"); } catch (error) {}
  });
  document.getElementById("sandbox-ly").addEventListener("click", () => {
    download(textarea.value, `${title()}.ly`, "text/x-lilypond");
  });
</script>
