<div class="studio" id="studio" data-no-nav>
  <div class="studio-menubar" role="menubar" aria-label="Score">
    <button type="button" class="studio-menu studio-tools-toggle" data-act="tools" aria-expanded="false" aria-controls="studio-toolbox">Tools</button>
    <div class="studio-menu-scroll">
      <div class="studio-menu-group">
        <button type="button" class="studio-menu" data-act="new" title="A new, empty score">New</button>
        <label class="studio-menu" title="Open a LilyPond file">Open…<input type="file" accept=".ly,.ily,.txt,text/plain" data-act="open" hidden></label>
        <select class="studio-menu" data-act="example" aria-label="Open an example">
          <option value="">Examples…</option>
          <% for example in examples %>
            <option value="<%= example["category"] %>/<%= example["slug"] %>"><%= example["title"] %> — <%= example["instrument"] %></option>
          <% end %>
        </select>
        <button type="button" class="studio-menu" data-act="save-ly" title="Save the LilyPond source">Save .ly</button>
        <button type="button" class="studio-menu" data-act="save-pdf" title="Print the A4 pages as a PDF">PDF</button>
        <button type="button" class="studio-menu" data-act="save-midi" title="Save the MIDI file">MIDI</button>
        <button type="button" class="studio-menu" data-act="share" title="Copy a link that opens this score">Share</button>
      </div>
      <div class="studio-menu-group">
        <button type="button" class="studio-menu" data-act="undo" title="Undo (Ctrl+Z)">↶ Undo</button>
        <button type="button" class="studio-menu" data-act="redo" title="Redo (Ctrl+Y)">↷ Redo</button>
        <button type="button" class="studio-menu studio-play" data-act="play" title="Play from the selection, or from the start; pause (Space)">▶ Play</button>
        <button type="button" class="studio-menu" data-act="stop" title="Stop, back to the start" hidden>■ Stop</button>
        <span class="studio-zoom">
          <button type="button" class="studio-menu" data-act="zoom-out" title="Smaller" aria-label="Zoom out">−</button>
          <span data-zoom-label>100 %</span>
          <button type="button" class="studio-menu" data-act="zoom-in" title="Larger" aria-label="Zoom in">+</button>
        </span>
        <button type="button" class="studio-menu" data-act="keys" title="Keyboard shortcuts (?)">Keys</button>
      </div>
    </div>
    <div class="studio-state" aria-live="polite" data-state></div>
  </div>

  <div class="studio-body">
    <aside class="studio-toolbox" id="studio-toolbox" aria-label="Tools">
      <details class="tool-section" data-section="mode" open>
        <summary><h3>Mode</h3></summary>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="mode-select" title="Select and change notes (Esc)">Select</button>
          <button type="button" class="tool tool-wide" data-act="mode-input" title="Write notes at the cursor (N)">✎ Note input</button>
        </div>
        <label class="tool-field">MIDI keyboard
          <select data-midi-in title="Play a key to write its note; keys held together make a chord">
            <option value="">none</option><option value="find">find keyboards…</option>
          </select>
        </label>
      </details>

      <details class="tool-section" data-section="playback" open>
        <summary><h3>Playback</h3></summary>
        <label class="tool-field">Speed
          <select data-play="rate">
            <option value="0.5">50 %</option><option value="0.75">75 %</option><option value="0.9">90 %</option>
            <option value="1" selected>100 %</option><option value="1.1">110 %</option><option value="1.25">125 %</option>
            <option value="1.5">150 %</option>
          </select>
        </label>
        <label class="tool-check"><input type="checkbox" data-play="loop"> Loop the selected bars</label>
        <label class="tool-check"><input type="checkbox" data-play="metronome"> Metronome</label>
        <label class="tool-check"><input type="checkbox" data-play="count-in"> Count in one bar</label>
        <label class="tool-field">Sound to
          <select data-play="output" title="This browser's sounds, or a MIDI device: GarageBand, Logic…">
            <option value="">this browser</option><option value="find">MIDI devices…</option>
          </select>
        </label>
        <div class="tool-staves" data-play="staves" aria-label="Mute or solo a staff"></div>
      </details>

      <details class="tool-section" data-section="duration" open>
        <summary><h3>Duration</h3></summary>
        <div class="tool-row">
          <button type="button" class="tool tool-glyph" data-act="duration" data-base="1" title="Whole note (7)">𝅝</button>
          <button type="button" class="tool tool-glyph" data-act="duration" data-base="2" title="Half note (6)">𝅗𝅥</button>
          <button type="button" class="tool tool-glyph" data-act="duration" data-base="4" title="Quarter note (5)">𝅘𝅥</button>
          <button type="button" class="tool tool-glyph" data-act="duration" data-base="8" title="Eighth note (4)">𝅘𝅥𝅮</button>
          <button type="button" class="tool tool-glyph" data-act="duration" data-base="16" title="Sixteenth note (3)">𝅘𝅥𝅯</button>
          <button type="button" class="tool tool-glyph" data-act="duration" data-base="32" title="Thirty-second note (2)">𝅘𝅥𝅰</button>
          <button type="button" class="tool" data-act="dot" title="Dotted (.)">•</button>
        </div>
      </details>

      <details class="tool-section" data-section="notes" open>
        <summary><h3>Notes</h3></summary>
        <div class="tool-row">
          <button type="button" class="tool" data-act="letter" data-step="0" title="C">C</button>
          <button type="button" class="tool" data-act="letter" data-step="1" title="D">D</button>
          <button type="button" class="tool" data-act="letter" data-step="2" title="E">E</button>
          <button type="button" class="tool" data-act="letter" data-step="3" title="F">F</button>
          <button type="button" class="tool" data-act="letter" data-step="4" title="G">G</button>
          <button type="button" class="tool" data-act="letter" data-step="5" title="A">A</button>
          <button type="button" class="tool" data-act="letter" data-step="6" title="B">B</button>
          <button type="button" class="tool" data-act="rest" title="Rest (0)">𝄽</button>
        </div>
        <div class="tool-row tool-drums" data-drums hidden aria-label="Drums"></div>
        <label class="tool-check"><input type="checkbox" data-chord-mode> Add to the chord <span class="muted">(Shift)</span></label>
        <label class="tool-check"><input type="checkbox" data-hear checked> Hear the notes</label>
      </details>

      <details class="tool-section" data-section="pitch" open>
        <summary><h3>Pitch</h3></summary>
        <div class="tool-row">
          <button type="button" class="tool" data-act="move" data-how="step" data-by="1" title="A step up (↑)">↑</button>
          <button type="button" class="tool" data-act="move" data-how="step" data-by="-1" title="A step down (↓)">↓</button>
          <button type="button" class="tool" data-act="move" data-how="semitone" data-by="1" title="A semitone up (Shift+↑)">½↑</button>
          <button type="button" class="tool" data-act="move" data-how="semitone" data-by="-1" title="A semitone down (Shift+↓)">½↓</button>
          <button type="button" class="tool" data-act="move" data-how="octave" data-by="1" title="An octave up (Ctrl+↑)">8↑</button>
          <button type="button" class="tool" data-act="move" data-how="octave" data-by="-1" title="An octave down (Ctrl+↓)">8↓</button>
        </div>
        <div class="tool-row">
          <button type="button" class="tool" data-act="alter" data-alter="-2" title="Double flat">𝄫</button>
          <button type="button" class="tool" data-act="alter" data-alter="-1" title="Flat (−)">♭</button>
          <button type="button" class="tool" data-act="alter" data-alter="0" title="Natural (=)">♮</button>
          <button type="button" class="tool" data-act="alter" data-alter="1" title="Sharp (+)">♯</button>
          <button type="button" class="tool" data-act="alter" data-alter="2" title="Double sharp">𝄪</button>
        </div>
        <div class="tool-row tool-transpose">
          <select class="tool-select" data-transpose-interval aria-label="Interval to transpose by"></select>
          <select class="tool-select" data-transpose-way aria-label="Up or down">
            <option value="1">up</option><option value="-1">down</option>
          </select>
        </div>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="transpose" data-scope="selection" title="Transpose the selected notes">Transpose notes</button>
          <button type="button" class="tool tool-wide" data-act="transpose" data-scope="score" title="Transpose the whole score, its key and chord symbols">Transpose score</button>
        </div>
      </details>

      <details class="tool-section" data-section="tuplets" open>
        <summary><h3>Tuplets</h3></summary>
        <div class="tool-row">
          <button type="button" class="tool" data-act="tuplet" data-n="3" title="Triplet (Ctrl+3)">3</button>
          <button type="button" class="tool" data-act="tuplet" data-n="5" title="Quintuplet (Ctrl+5)">5</button>
          <button type="button" class="tool" data-act="tuplet" data-n="6" title="Sextuplet (Ctrl+6)">6</button>
          <button type="button" class="tool" data-act="tuplet" data-n="7" title="Septuplet (Ctrl+7)">7</button>
          <button type="button" class="tool tool-wide" data-act="untuplet" title="Make the tuplet one note again">Remove</button>
        </div>
      </details>

      <details class="tool-section" data-section="ties-and-lines" open>
        <summary><h3>Ties &amp; lines</h3></summary>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="tie" title="Tie to the next note (T)">⁀ Tie</button>
          <button type="button" class="tool tool-wide" data-act="slur" title="Slur the selected notes (S)">⌒ Slur</button>
        </div>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="hairpin" data-kind="&lt;" title="Crescendo over the selection">𝆒 cresc.</button>
          <button type="button" class="tool tool-wide" data-act="hairpin" data-kind="&gt;" title="Diminuendo over the selection">𝆓 dim.</button>
        </div>
      </details>

      <details class="tool-section" data-section="articulations" open>
        <summary><h3>Articulations</h3></summary>
        <div class="tool-row">
          <button type="button" class="tool" data-act="art" data-name="staccato" title="Staccato">·</button>
          <button type="button" class="tool" data-act="art" data-name="accent" title="Accent">&gt;</button>
          <button type="button" class="tool" data-act="art" data-name="tenuto" title="Tenuto">–</button>
          <button type="button" class="tool" data-act="art" data-name="marcato" title="Marcato">^</button>
          <button type="button" class="tool" data-act="art" data-name="staccatissimo" title="Staccatissimo">▾</button>
          <button type="button" class="tool" data-act="art" data-name="fermata" title="Fermata">𝄐</button>
        </div>
      </details>

      <details class="tool-section" data-section="ornaments" open>
        <summary><h3>Ornaments</h3></summary>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="art" data-name="trill" title="Trill: the note and the one above, quickly in turn">tr Trill</button>
          <button type="button" class="tool tool-wide" data-act="art" data-name="prall" title="Short trill: the note, the one above, the note">Short tr.</button>
          <button type="button" class="tool tool-wide" data-act="art" data-name="mordent" title="Mordent: the note, the one below, the note">Mordent</button>
          <button type="button" class="tool tool-wide" data-act="art" data-name="turn" title="Turn: above, the note, below, the note">Turn</button>
        </div>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="arpeggio" title="Arpeggio: the chord rolled from its lowest note up">Arpeggio</button>
          <button type="button" class="tool tool-wide" data-act="gliss" title="Glissando: slide from this note to the next">Glissando</button>
        </div>
        <div class="tool-row" aria-label="Tremolo">
          <button type="button" class="tool tool-wide" data-act="tremolo" data-value="8" title="Tremolo: the note repeated in eighths">Trem. 8</button>
          <button type="button" class="tool tool-wide" data-act="tremolo" data-value="16" title="Tremolo: the note repeated in sixteenths">16</button>
          <button type="button" class="tool tool-wide" data-act="tremolo" data-value="32" title="Tremolo: the note repeated in thirty-seconds">32</button>
        </div>
      </details>

      <details class="tool-section" data-section="grace-notes" open>
        <summary><h3>Grace notes</h3></summary>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="grace" data-kind="acciaccatura" title="Acciaccatura: a quick slashed note before the selected one">Acciacc.</button>
          <button type="button" class="tool tool-wide" data-act="grace" data-kind="appoggiatura" title="Appoggiatura: a leaning note that takes time from the selected one">Appogg.</button>
          <button type="button" class="tool tool-wide" data-act="grace" data-kind="grace" title="Grace note: a small plain note before the selected one">Grace</button>
        </div>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="grace-add" title="One more grace note, a step above the last">+ Note</button>
          <button type="button" class="tool" data-act="grace-move" data-by="1" title="Last grace note a step up" aria-label="Last grace note a step up">↑</button>
          <button type="button" class="tool" data-act="grace-move" data-by="-1" title="Last grace note a step down" aria-label="Last grace note a step down">↓</button>
          <button type="button" class="tool tool-wide" data-act="grace-remove" title="Take the grace notes away">Remove</button>
        </div>
      </details>

      <details class="tool-section" data-section="dynamics" open>
        <summary><h3>Dynamics</h3></summary>
        <div class="tool-row tool-dynamics">
          <% dynamics = {"ppp": "pianississimo", "pp": "pianissimo", "p": "piano", "mp": "mezzo-piano"} %>
          <% dynamics = dynamics.merge({"mf": "mezzo-forte", "f": "forte", "ff": "fortissimo", "fff": "fortississimo"}) %>
          <% dynamics = dynamics.merge({"sfz": "sforzando", "fp": "forte-piano"}) %>
          <% for dynamic in dynamics.keys %>
            <% word = dynamics[dynamic] %>
            <button type="button" class="tool tool-dyn" data-act="dynamic" data-name="<%= dynamic %>"
              title="<%= word %>" aria-label="<%= word %>"><%= dynamic %></button>
          <% end %>
        </div>
      </details>

      <details class="tool-section" data-section="words" open>
        <summary><h3>Words</h3></summary>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="lyrics" title="Lyrics under the notes (Ctrl+L)">Lyrics</button>
          <button type="button" class="tool tool-wide" data-act="chord" title="A chord symbol above (Ctrl+K)">Chord symbol</button>
        </div>
      </details>

      <details class="tool-section" data-section="repeats" open>
        <summary><h3>Repeats</h3></summary>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="repeat" title="Repeat the selected bars — the same bars again take it away">𝄆 Repeat 𝄇</button>
          <button type="button" class="tool tool-wide" data-act="ending" title="The selected bars become the next ending: 1., then 2.…">Ending 1. 2.</button>
        </div>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="endings" title="Add an empty ending after the repeat (a bar is inserted)">+ Empty ending</button>
          <button type="button" class="tool tool-wide" data-act="unrepeat" title="Take the repeat around the selection away; its bars stay">Remove</button>
        </div>
        <p class="tool-hint">
          Drag across the bars to select them, then <b>Repeat</b>. Select the bars after it and press <b>Ending</b>
          for 1., again for 2. On the score, drag a repeat's handles to another bar line to change where it starts,
          ends, and how long each ending is.
        </p>
      </details>

      <details class="tool-section" data-section="bars-and-staves" open>
        <summary><h3>Bars &amp; staves</h3></summary>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="add-bar" title="A bar at the end (])">+ Bar</button>
          <button type="button" class="tool tool-wide" data-act="remove-bar" title="Take the last bar away">− Bar</button>
        </div>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="insert-bar" title="A bar before the selected one (Insert)">Insert bar</button>
          <button type="button" class="tool tool-wide" data-act="delete-bars" title="Take the selected bars away, notes and all (Ctrl+Delete)">Delete bars</button>
        </div>
        <div class="tool-row">
          <select class="tool-select" data-field="new-staff" data-instruments="new" aria-label="Instrument of a new staff"></select>
          <button type="button" class="tool tool-wide" data-act="add-staff">+ Staff</button>
        </div>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="remove-staff" title="Take the selected staff away">− This staff</button>
        </div>
      </details>

      <details class="tool-section" data-section="voices" open>
        <summary><h3>Voices</h3></summary>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="voice" data-voice="1" title="Write and select in the first voice, stems up (Ctrl+Alt+1)">Voice 1</button>
          <button type="button" class="tool tool-wide" data-act="voice" data-voice="2" title="Write and select in the second voice, stems down (Ctrl+Alt+2)">Voice 2</button>
        </div>
        <div class="tool-row">
          <button type="button" class="tool tool-wide" data-act="voice-remove" title="Take this staff's second voice away, its notes with it">Remove voice 2</button>
        </div>
        <p class="tool-hint">Voice 2 writes under voice 1 on the same staff. A bar shows two voices where voice 2 has notes.</p>
      </details>

      <details class="tool-section" data-section="this-staff" open>
        <summary><h3>This staff</h3></summary>
        <label class="tool-field">Instrument
          <select data-field="staff-instrument" data-instruments="staff" title="Its sound, its clef, and its name unless you gave it one"></select>
        </label>
        <label class="tool-field">Name <input type="text" data-field="staff-name" placeholder="Violin"></label>
        <label class="tool-field">Short <input type="text" data-field="staff-short" placeholder="Vl."></label>
        <label class="tool-field">Clef
          <select data-field="staff-clef">
            <option value="treble">Treble</option><option value="bass">Bass</option><option value="alto">Alto</option>
            <option value="tenor">Tenor</option><option value="treble_8">Treble 8 (guitar)</option><option value="bass_8">Bass 8</option>
          </select>
        </label>
        <label class="tool-field">Key
          <select data-field="staff-key">
            <option value="">The score's</option>
            <% for fifths in range(-7, 8) %>
              <option value="<%= fifths %>"><%= ["C♭", "G♭", "D♭", "A♭", "E♭", "B♭", "F", "C", "G", "D", "A", "E", "B", "F♯", "C♯"][fifths + 7] %> major / <%= ["A♭", "E♭", "B♭", "F", "C", "G", "D", "A", "E", "B", "F♯", "C♯", "G♯", "D♯", "A♯"][fifths + 7] %> minor</option>
            <% end %>
          </select>
        </label>
      </details>

      <details class="tool-section" data-changes data-section="from-bar" open>
        <summary><h3>From bar <span data-change-bar>—</span></h3></summary>
        <p class="tool-hint" data-change-hint>Select a bar, or put the cursor in it: what changes here goes on to the next change.</p>
        <label class="tool-field">Key
          <select data-field="change-key">
            <option value="">As before</option>
            <% for fifths in range(-7, 8) %>
              <option value="<%= fifths %>"><%= ["C♭", "G♭", "D♭", "A♭", "E♭", "B♭", "F", "C", "G", "D", "A", "E", "B", "F♯", "C♯"][fifths + 7] %> major / <%= ["A♭", "E♭", "B♭", "F", "C", "G", "D", "A", "E", "B", "F♯", "C♯", "G♯", "D♯", "A♯"][fifths + 7] %> minor</option>
            <% end %>
          </select>
        </label>
        <label class="tool-field">Metre
          <select data-field="change-time">
            <option value="">As before</option>
            <% for metre in ["2/4", "3/4", "4/4", "5/4", "2/2", "3/8", "6/8", "9/8", "12/8"] %>
              <option value="<%= metre %>"><%= metre %></option>
            <% end %>
          </select>
        </label>
        <label class="tool-field">Tempo <input type="number" min="20" max="300" step="1" data-field="change-bpm" placeholder="as before"></label>
        <label class="tool-field">Tempo text <input type="text" data-field="change-tempo-text" placeholder="a tempo, rit., Presto…"></label>
        <label class="tool-field">Clef
          <select data-field="change-clef">
            <option value="">As before</option>
            <option value="treble">Treble</option><option value="bass">Bass</option><option value="alto">Alto</option>
            <option value="tenor">Tenor</option><option value="treble_8">Treble 8 (guitar)</option><option value="bass_8">Bass 8</option>
          </select>
        </label>
        <label class="tool-check"><input type="checkbox" data-field="change-double"> Double bar line before it</label>
      </details>

      <details class="tool-section" data-section="score" open>
        <summary><h3>Score</h3></summary>
        <label class="tool-field">Title <input type="text" data-field="title"></label>
        <label class="tool-field">Subtitle <input type="text" data-field="subtitle"></label>
        <label class="tool-field">Composer <input type="text" data-field="composer"></label>
        <label class="tool-field">Key
          <select data-field="key">
            <% for fifths in range(-7, 8) %>
              <option value="<%= fifths %>"><%= ["C♭", "G♭", "D♭", "A♭", "E♭", "B♭", "F", "C", "G", "D", "A", "E", "B", "F♯", "C♯"][fifths + 7] %> major / <%= ["A♭", "E♭", "B♭", "F", "C", "G", "D", "A", "E", "B", "F♯", "C♯", "G♯", "D♯", "A♯"][fifths + 7] %> minor</option>
            <% end %>
          </select>
        </label>
        <label class="tool-field">Metre
          <select data-field="time">
            <% for metre in ["2/4", "3/4", "4/4", "5/4", "2/2", "3/8", "6/8", "9/8", "12/8"] %>
              <option value="<%= metre %>"><%= metre %></option>
            <% end %>
          </select>
        </label>
        <label class="tool-field">Tempo <input type="number" min="20" max="300" step="1" data-field="bpm"></label>
        <label class="tool-field">Tempo text <input type="text" data-field="tempo-text" placeholder="Allegro"></label>
        <label class="tool-field">Staves
          <select data-field="group">
            <option value="none">Joined by a line</option><option value="bracket">Bracket</option>
            <option value="brace">Brace (piano)</option><option value="choir">Choir</option>
          </select>
        </label>
      </details>

    </aside>

    <main class="studio-canvas">
      <div class="studio-notice" data-notice hidden></div>
      <div class="studio-sheet" data-sheet tabindex="0" aria-label="The score: click a note to select it">
        <%- figure["svg"].to_s %>
      </div>
      <div class="studio-status" data-status aria-live="polite"></div>
    </main>
  </div>

  <section class="studio-source">
    <div class="studio-source-head">
      <h2>LilyPond source</h2>
      <span class="muted">Edit it here, or on the score: each follows the other.</span>
    </div>
    <textarea data-source wrap="off" spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="LilyPond source"><%= source %></textarea>
  </section>

  <dialog class="studio-keys" data-keys aria-labelledby="studio-keys-title">
    <div class="studio-keys-head">
      <h2 id="studio-keys-title">Keyboard</h2>
      <button type="button" class="studio-menu" data-act="keys" aria-label="Close">×</button>
    </div>
          <dl>
            <dt>N / Esc</dt><dd>note input / select</dd>
            <dt>A–G</dt><dd>write a note (Shift: add to the chord)</dd>
            <dt>0</dt><dd>rest</dd>
            <dt>]</dt><dd>a bar at the end</dd>
            <dt>Insert</dt><dd>a bar before the selection</dd>
            <dt>Ctrl+Delete</dt><dd>take the selected bars away</dd>
            <dt>2–7</dt><dd>32nd … whole; <kbd>.</kbd> dot</dd>
            <dt>↑ ↓</dt><dd>step; Shift semitone; Ctrl octave</dd>
            <dt>← →</dt><dd>previous / next; Shift extends</dd>
            <dt>Alt+↑ ↓</dt><dd>a note of the chord</dd>
            <dt>+ − =</dt><dd>sharp, flat, natural</dd>
            <dt>T / S</dt><dd>tie / slur</dd>
            <dt>Ctrl+3, 5, 6, 7</dt><dd>tuplets</dd>
            <dt>Ctrl+L / Ctrl+K</dt><dd>lyrics / chord symbol</dd>
            <dt>Delete</dt><dd>make rests</dd>
            <dt>Ctrl+C V X</dt><dd>copy, paste, cut — as LilyPond, with other programs too</dd>
            <dt>Ctrl+Z / Y</dt><dd>undo / redo</dd>
            <dt>Space</dt><dd>play / pause</dd>
            <dt>?</dt><dd>this sheet</dd>
          </dl>
  </dialog>
</div>

<script type="module">
  const { startStudio } = await import("/eui-score/studio.js?v=<%= eui_version %>");
  startStudio(document.getElementById("studio"), { examples: "<%= examples_path() %>" });
</script>
