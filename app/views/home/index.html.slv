<%# The home page (#397): the app first, feature by feature, each with a
    screenshot of the real app (public/images/home/, HomeFeatures); then
    the engraver for developers, and the plans. No script of its own. %>
<% start_href = app_open ? lp(signup_path()) : playground_path() %>
<div class="wrap">
  <section class="hero hero-app">
    <div class="hero-copy">
      <span class="eyebrow"><%= t("home.eyebrow") %></span>
      <h1><%- t("home.headline") %></h1>
      <p class="lead"><%= t("home.lead") %></p>
      <div class="hero-actions">
        <% if app_open %>
          <a class="btn btn-primary" href="<%= lp(signup_path()) %>" data-home-start><%= t("home.start") %></a>
        <% end %>
        <a class="btn btn-ghost" href="<%= playground_path() %>"><%= t("home.playground") %></a>
      </div>
      <p class="hero-note"><%- t("home.note", {"pricing": lp(pricing_path())}) %></p>
    </div>
    <figure class="app-shot app-shot-hero">
      <img src="<%= public_path("images/home/hero-editor.jpg") %>" width="<%= shot_width %>" height="<%= shot_height %>" fetchpriority="high"
        alt="<%= t("home.hero_alt") %>">
    </figure>
  </section>

  <nav class="feature-index" aria-label="<%= t("home.index_label") %>">
    <% for feature in features %>
      <a href="#<%= feature["id"] %>"><%= feature["eyebrow"] %></a>
    <% end %>
    <a href="#developers"><%= t("home.developers") %></a>
  </nav>

  <% for feature, index in features %>
    <section class="feature<%= index % 2 == 1 ? " feature-flip" : "" %>" id="<%= feature["id"] %>" data-feature="<%= feature["id"] %>">
      <div class="feature-copy">
        <span class="eyebrow"><%= feature["eyebrow"] %></span>
        <h2><%= feature["title"] %></h2>
        <ul class="feature-lines">
          <% for line in feature["lines"] %>
            <li><%= line %></li>
          <% end %>
        </ul>
        <% label = feature["label"] %>
        <% label = t("home.try_playground") if feature["link"] == "signup" && !app_open %>
        <a class="feature-link" href="<%= feature["href"] %>"><%= label %> →</a>
      </div>
      <figure class="app-shot">
        <img src="<%= public_path("images/home/" + feature["image"]) %>" width="<%= shot_width %>" height="<%= shot_height %>"
          alt="<%= feature["alt"] %>" loading="lazy" decoding="async">
      </figure>
    </section>
  <% end %>

  <section class="section dev" id="developers">
    <div class="dev-copy">
      <span class="eyebrow"><%= t("home.developers") %></span>
      <h2><%= t("home.dev_title") %></h2>
      <p class="lead"><%- t("home.dev_lead") %></p>
<pre class="code-block"><code>&lt;script type="module" src="https://score.solisoft.net/eui-score.js"&gt;&lt;/script&gt;
&lt;eui-score src="my-piece.ly"&gt;&lt;/eui-score&gt;</code></pre>
      <div class="dev-links">
        <a class="btn btn-ghost" href="<%= lp(guide_path()) %>"><%= t("home.the_guide") %></a>
        <a class="btn btn-ghost" href="<%= lp(syntax_path()) %>"><%= t("home.the_syntax") %></a>
        <a class="btn btn-ghost" href="<%= lp(embed_path()) %>"><%= t("home.embed_it") %></a>
        <a class="dev-more" href="<%= lp(examples_path()) %>"><%= t("home.examples", {"n": example_count}) %> →</a>
      </div>
    </div>
    <div class="hero-sheet">
      <%- score_figure(engraved, {"name": "syntax/home", "sandbox": playground_path(), "source": "closed"}) %>
    </div>
  </section>

  <section class="section" id="plans">
    <div class="section-head">
      <span class="eyebrow"><%= t("home.plans") %></span>
      <h2><%= t("home.plans_title") %></h2>
    </div>
    <div class="plans-teaser">
      <div class="plan-teaser">
        <h3>Free</h3>
        <p class="plan-teaser-price">0 € <small><%= t("home.for_good") %></small></p>
        <p><%= t("home.free_text") %></p>
      </div>
      <div class="plan-teaser plan-teaser-pro">
        <h3>Pro</h3>
        <p class="plan-teaser-price"><%= pro_price["label"] %> <small><%= t("home.per_month") %></small></p>
        <p><%= t("home.pro_text") %></p>
      </div>
    </div>
    <p><a class="btn btn-ghost" href="<%= lp(pricing_path()) %>" data-home-pricing><%= t("home.compare") %></a></p>
  </section>

  <section class="cta-band">
    <h2><%= t("home.cta") %></h2>
    <div class="hero-actions">
      <a class="btn btn-primary" href="<%= start_href %>"><%= app_open ? t("home.start") : t("home.playground") %></a>
      <a class="btn btn-ghost" href="<%= lp(pricing_path()) %>"><%= t("home.see_pricing") %></a>
    </div>
  </section>
</div>
