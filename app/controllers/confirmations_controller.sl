# Confirmations controller — email confirmation. Generated by `soli generate auth`.
#
# Signup sends a confirmation link (see RegistrationsController); this
# controller confirms it and can resend a fresh one. The resend form always
# responds the same way, and in the same time, whether or not the email
# exists (the mail is AuthMailJob's).

class ConfirmationsController < Controller
  static {
    this.layout = "app"
  }

  # GET /confirm_email?token=... — the link from the email
  def show
    token = params["token"].to_s
    let user = null
    user = User.find_by("confirmation_token_digest", Crypto.sha256(token)) unless token.blank?
    # An expired link is indistinguishable from an invalid one to the visitor,
    # which is right: both mean "ask for a fresh one".
    user = null if !user.nil? && user.confirmation_token_expired?()
    if user.nil?
      return render(
        "confirmations/new",
        {
          "title": SiteText.t("auth.confirm_title"),
          "notice": "",
          "error": SiteText.t("auth.confirm_bad_link")
        }
      )
    end

    user.confirm_email()
    # Confirm, but do not sign in.
    #
    # This is a GET reached from an email, so whoever (or whatever) follows the
    # link gets the session: a corporate link scanner, a shared mailbox, or the
    # colleague the message was forwarded to. Confirming the address from a link
    # is fine; handing out a logged-in session from one is not. The visitor
    # signs in normally, which is one form fill and proves they hold the
    # password.
    return render(
      "confirmations/new",
      {
        "title": SiteText.t("auth.confirmed_title"),
        "notice": SiteText.t("auth.confirmed"),
        "error": ""
      }
    )
  end

  # GET /confirmation/resend
  def new
    render(
      "confirmations/new",
      {
        "title": SiteText.t("auth.confirm_title"),
        "notice": "",
        "error": ""
      }
    )
  end

  # POST /confirmation/resend
  def create
    email = params["email"].to_s.trim().downcase()
    unless User.account_email_allowed?(email, client_ip(req))
      return render("confirmations/new", {
        "title": SiteText.t("auth.confirm_title"),
        "notice": "",
        "error": AUTH_EMAILS_REFUSED
      }, {"status": 429})
    end

    # Queued, whatever the address (#539): AuthMailJob looks it up, and sends
    # a link only to an account still unconfirmed.
    AuthMailJob.ask("confirm", email)

    return render(
      "confirmations/new",
      {
        "title": SiteText.t("auth.confirm_title"),
        "notice": SiteText.t("auth.confirm_sent"),
        "error": ""
      }
    )
  end
end
