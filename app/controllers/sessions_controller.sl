# Sessions controller — login + logout. Generated by `soli generate auth`.
#
# Ships with a per-IP throttle (AUTH_ATTEMPTS_PER_IP per
# AUTH_IP_WINDOW_SECONDS), account lockout (AUTH_MAX_FAILED_ATTEMPTS wrong
# passwords lock the account for AUTH_LOCKOUT_SECONDS), optional remember-me
# (persistent HttpOnly + Secure cookie), and an optional confirmed-email gate
# (flip `auth_require_confirmed_email` in app/models/user.sl).
#
# The failure paths are deliberately uniform in both wording and cost: an
# unknown address and a wrong password produce the same message and the same
# response time, so sign-in cannot be used to enumerate accounts.

class SessionsController < Controller
  static {
    this.layout = "app"
  }

  # GET /login
  def new
    render(
      "sessions/new",
      {
        "title": "Sign in",
        "error": "",
        "email": "",
        "return_to": @_return_to
      }
    )
  end

  # POST /login
  def create
    email = params["email"].to_s.trim().downcase()
    password = params["password"].to_s

    # First gate: how many sign-in attempts this source address gets. The
    # per-account lockout below is blind to credential stuffing (one guess
    # each against thousands of accounts) and it is itself abusable as a
    # denial of service against a known address. This closes both.
    limiter = rate_limiter_from_ip(req, AUTH_ATTEMPTS_PER_IP, AUTH_IP_WINDOW_SECONDS)
    return this._reject("Too many sign-in attempts. Try again in a few minutes.", email, 429) unless limiter.allowed()

    user = User.find_by("email", email)

    # A locked account answers exactly like a wrong password, and its password
    # is not verified at all.
    #
    # The lockout check used to run *after* `authenticate`, which left two
    # problems. The response distinguished a correct password (403 "Account
    # locked") from a wrong one (401) throughout the lockout, so an attacker
    # spreading guesses across addresses could still find the password and
    # simply wait out the window — the lockout stopped nothing it was meant to
    # stop. And every guess against a locked account still paid for a full
    # Argon2id verification, so knocking on one known address was a cheap way to
    # burn server CPU.
    #
    # Work is still burned here so the timing matches a normal failure: the cost
    # is what makes a locked account indistinguishable from a wrong password and
    # from an address that was never registered. The owner learns about the lock
    # from the notification `register_failed_attempt` sends when it trips, not
    # from this response.
    if !user.nil? && user.locked?()
      User.burn_password_work(password)
      return this._reject("Invalid email or password", email, 401)
    end

    # Both branches must cost the same. `authenticate` runs Argon2id (~100ms);
    # bailing out on a missing account would return in microseconds, and that
    # difference is a reliable "is this address registered?" oracle no matter
    # how carefully the error message is worded.
    authenticated = user.nil? ? User.burn_password_work(password) : user.authenticate(password)

    unless authenticated
      user.register_failed_attempt() unless user.nil?
      return this._reject("Invalid email or password", email, 401)
    end

    if auth_require_confirmed_email() && !user.confirmed?()
      return render("sessions/new", {
        "title": "Sign in",
        "error": "Please confirm your email address first: open the link we sent you, or ask for a new one.",
        "email": email,
        "return_to": @_return_to,
        "unconfirmed": true
      }, {"status": 403})
    end

    user.clear_failed_attempts()
    remember = params["remember_me"].to_s == "1"
    # Two-step sign-in: the password is right, the code is still to come. The
    # session says who is half-way, since when, and where they were going —
    # it does not sign them in.
    if user.two_step?()
      session_regenerate()
      session_set("two_step_user", user["_key"])
      session_set("two_step_since", DateTime.utc().to_unix())
      session_set("two_step_tries", 0)
      session_set("two_step_remember", remember)
      session_set("two_step_return", @_return_to)
      return redirect(login_code_path())
    end

    @_finish_sign_in(user, remember)
    redirect(@_after_sign_in)
  end

  # Signed in: a new session (which defeats session fixation), stamped with
  # the version a later password reset invalidates; a remembered browser
  # gets its cookie.
  def _finish_sign_in(user, remember)
    session_regenerate()
    session_set("user_id", user["_key"])
    session_set("session_version", user.current_session_version())

    if remember
      token = user.start_remember_me()
      # `secure` matters more here than on the session cookie: this one is a
      # 30-day bearer credential, and without the flag a single plaintext
      # request to the same host hands it to anyone on the path.
      set_cookie("remember_token", user["_key"] + ":" + token, {
        "max_age": AUTH_REMEMBER_DAYS * 86400,
        "http_only": true,
        "same_site": "Lax",
        "secure": true
      })
    end
    true
  end

  # Re-render the sign-in form with an error and an accurate status code.
  # Every failure path goes through here so none of them can drift into
  # leaking more than the others.
  def _reject(message, email, status)
    return render("sessions/new", {
      "title": "Sign in",
      "error": message,
      "email": email,
      "return_to": @_return_to
    }, {"status": status})
  end

  # Where a sign-in goes: back to the app page that asked for it, never to
  # another site (a path of this one only), else the app's first screen.
  def _after_sign_in
    @_return_to.blank? ? app_home_path() : @_return_to
  end

  def _return_to
    path = params["return_to"].to_s
    return "" unless path.starts_with?("/app")
    return "" if path.includes?("//") || path.includes?("\\")

    path
  end

  # DELETE /logout
  def destroy
    user_id = session_get("user_id")
    if !user_id.blank?
      user = User.find_by("_key", user_id) rescue null
      user&.forget_me()
    end
    # Expire the remember-me cookie immediately.
    set_cookie("remember_token", "", {
      "max_age": 0,
      "http_only": true,
      "same_site": "Lax",
      "secure": true
    })
    session_destroy()
    redirect("/login")
  end
end
