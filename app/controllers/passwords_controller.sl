# Passwords controller — the "forgot password" flow. Generated by `soli generate auth`.
#
# POST /password/reset always responds the same way, and in the same time,
# whether or not the email exists (the mail is AuthMailJob's), so the form
# can't be used to probe for accounts. Reset links carry
# a one-time token whose SHA-256 digest is stored; links expire after
# AUTH_RESET_TOKEN_TTL seconds (see app/models/user.sl).

class PasswordsController < Controller
  static {
    this.layout = "app"
  }

  # GET /password/reset — request a reset link
  def new
    render(
      "passwords/new",
      {
        "title": SiteText.t("auth.reset_password"),
        "notice": "",
        "error": ""
      }
    )
  end

  # POST /password/reset — send the link
  def create

    # Throttle per source address. The uniform response below stops this
    # endpoint being used to probe for accounts, but nothing stopped it being
    # used to mail-bomb one known address (or to burn the app's sending
    # reputation across many).
    limiter = rate_limiter_from_ip(req, AUTH_ATTEMPTS_PER_IP, AUTH_IP_WINDOW_SECONDS)
    unless limiter.allowed()
      return render("passwords/new", {
        "title": SiteText.t("auth.reset_password"),
        "notice": "",
        "error": SiteText.t("auth.too_many_resets")
      }, {"status": 429})
    end

    email = params["email"].to_s.trim().downcase()
    unless User.account_email_allowed?(email, client_ip(req))
      return render("passwords/new", {
        "title": SiteText.t("auth.reset_password"),
        "notice": "",
        "error": AUTH_EMAILS_REFUSED
      }, {"status": 429})
    end

    # Queued, whatever the address (#539): the lookup, the link and the mail
    # are the job's, so a known address answers no slower than an unknown one.
    AuthMailJob.ask("reset", email)

    return render(
      "passwords/new",
      {
        "title": SiteText.t("auth.reset_password"),
        "notice": SiteText.t("auth.reset_sent"),
        "error": ""
      }
    )
  end

  # GET /password/edit?token=... — the form behind the emailed link
  def edit
    user = @_user_for_token(params["token"])
    if user.nil?
      return render(
        "passwords/new",
        {
          "title": SiteText.t("auth.reset_password"),
          "notice": "",
          "error": SiteText.t("auth.reset_bad_link")
        }
      )
    end

    return render(
      "passwords/edit",
      {
        "title": SiteText.t("auth.new_password_title"),
        "token": params["token"].to_s,
        "error": ""
      }
    )
  end

  # POST /password/update
  def update
    user = @_user_for_token(params["token"])
    if user.nil?
      return render(
        "passwords/new",
        {
          "title": SiteText.t("auth.reset_password"),
          "notice": "",
          "error": SiteText.t("auth.reset_bad_link")
        }
      )
    end

    password = params["password"].to_s
    # One rule, one place: `password_error` is what sign-up enforces too, so
    # the reset flow can't quietly become the way to install a weaker password
    # than registration would have accepted.
    password_error = user.password_error(password)
    return this._reject_edit(password_error) unless password_error.nil?

    return this._reject_edit(SiteText.t("auth.no_match")) if password != params["password_confirmation"].to_s

    user.finish_password_reset(password)
    # The reset link reached this inbox: the address is confirmed too.
    User.find(user._key).confirm_email() unless user.confirmed?()
    # Sign the user straight in with a fresh session.
    session_regenerate()
    session_set("user_id", user["_key"])
    # Stamped so a later password reset can invalidate this session.
    session_set("session_version", user.current_session_version())
    redirect(app_home_path())
  end

  private

  # Re-render the "choose a new password" form with an error, keeping the
  # token so the user doesn't have to click the emailed link again.
  def _reject_edit(message)
    return render("passwords/edit", {
      "title": SiteText.t("auth.new_password_title"),
      "token": params["token"].to_s,
      "error": message
    }, {"status": 422})
  end

  # Resolve a reset token to its (non-expired) user, or nil. `_`: not an action.
  def _user_for_token(token)
    return null if token.blank?

    user = User.find_by("reset_token_digest", Crypto.sha256(token.to_s))
    return null if user.nil?
    return null if user.reset_token_expired?()

    user
  end
end
