# Registrations controller — sign up. Generated by `soli generate auth`.
#
# New accounts get a confirmation email (AuthMailer). Whether an unconfirmed
# account may sign in is controlled by `auth_require_confirmed_email` in
# app/models/user.sl (off by default so the flow works before SMTP is set up).

class RegistrationsController < Controller
  static {
    this.layout = "app"
  }

  # GET /signup
  def new
    render(
      "registrations/new",
      {
        "title": SiteText.t("auth.create_account"),
        "error": "",
        "user": User.new(),
        "pow_bits": SIGNUP_POW_BITS
      }
    )
  end

  # POST /signup
  def create
    user = User.new()
    user.email = params["email"]

    # A bot fills the hidden field, posts without loading the page, within
    # two seconds of it, or without the page's proof of work (spam_check: the
    # fields come with csrf_field() and pow_field()). What only a bot does is
    # answered as a sign-up is, and makes no account: it learns nothing (#448).
    refused = spam_check(
      req,
      {"min_seconds": 2, "pow": true}
    )
    return @_refuse_spam(user, refused) unless refused.nil?

    # Throttle account creation per source address: unmetered sign-up is how
    # an app ends up seeding spam, and it is also a cheap Argon2id CPU sink
    # (every attempt costs the server ~100ms of hashing).
    limiter = rate_limiter_from_ip(req, AUTH_ATTEMPTS_PER_IP, AUTH_IP_WINDOW_SECONDS)
    return this._reject(user, SiteText.t("auth.too_many_signups"), 429) unless limiter.allowed()

    # Accounts made from one address in an hour, whatever became of them.
    hourly = RateLimiter("signup:#{client_ip(req)}", SIGNUPS_PER_IP_HOUR, 3600)
    return this._reject(user, SiteText.t("auth.too_many_accounts"), 429) unless hourly.allowed()

    return this._reject(user, SiteText.t("auth.throwaway"), 422) if User.throwaway_email?(user.email)

    # `set_password` is a no-op on a blank value (so profile saves don't wipe
    # the digest), which means the length rule has to be checked here or an
    # account can be created with no usable password at all.
    password_error = user.password_error(params["password"])
    return this._reject(user, password_error, 422) unless password_error.nil?

    # An address that has an account already is answered as a new one is
    # (#539), with the same Argon2id work: the page must not say who has an
    # account. Its owner is told by mail, as often as account e-mails go (an
    # account not confirmed yet gets its link again, AuthMailJob.due).
    user.email = user.email.to_s.trim.downcase
    unless User.find_by("email", user.email).nil?
      User.burn_password_work(params["password"])
      AuthMailJob.ask("signup_taken", user.email) if User.account_email_allowed?(user.email, client_ip(req))
      return @_check_inbox(user)
    end

    user.set_password(params["password"].to_s)
    user.save()
    return this._reject(user, SiteText.t("auth.not_created"), 422) if user._errors

    # The confirmation link, queued (AuthMailJob): a failure is logged, not
    # raised, so signup works before SMTP is configured (set
    # SOLI_MAIL_DELIVERY_METHOD=logger in dev to see the email in the console).
    # It spends the address's mail budget as a taken address's note does
    # (#539): a reset asked next must not find one budget fuller than the other.
    AuthMailJob.ask("confirm", user.email) if User.account_email_allowed?(user.email, client_ip(req))

    return @_check_inbox(user) if auth_require_confirmed_email()

    session_regenerate()
    session_set("user_id", user["_key"])
    # Stamped so a later password reset can invalidate this session.
    session_set("session_version", user.current_session_version())
    redirect(app_home_path())
  end

  private

  # The answer to a sign-up spam_check refused: a person told what to do
  # when they can act on it; a bot (the hidden field, a message that reads
  # as spam) answered as a sign-up is, with no account and no mail.
  def _refuse_spam(user, refused)
    reason = refused["reason"]
    return this._reject(user, SiteText.t("auth.too_quick"), 422) if reason == "fast"
    return this._reject(user, SiteText.t("auth.js_retry"), 422) if reason == "pow"

    return this._reject(user, SiteText.t("auth.too_many_from_here"), 429) if reason == "rate"
    return this._reject(user, SiteText.t("auth.form_refused"), 422) if refused["show"]

    @_check_inbox(user)
  end

  # What a sign-up answers: the link is on its way to `user`'s address. A
  # new account, an address that has one and a bot all read this.
  def _check_inbox(user)
    render(
      "confirmations/new",
      {
        "title": SiteText.t("auth.check_inbox"),
        "notice": SiteText.t("auth.created", {"email": user.email}),
        "error": "",
        "email": user.email
      }
    )
  end

  # Re-render the sign-up form with an error and an accurate status code.
  def _reject(user, message, status)
    return render("registrations/new", {
      "title": SiteText.t("auth.create_account"),
      "user": user,
      "error": message,
      "pow_bits": SIGNUP_POW_BITS
    }, {"status": status})
  end
end
